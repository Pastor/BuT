// Переменная-массив обязана попасть в порождённый ST.
//
// Тот же вход, на котором цель `c` даёт `uint4_t` (несуществующий тип):
// размер массива там подставляется вместо разрядности - дефект Д1 фичи 0029.
// Здесь ожидается `data : ARRAY [0..3] OF USINT;`.

var data: [u8; 4] := 0;

cond FirstSet = data[0] = 1;

start Idle {
    ref Done: FirstSet;
}

state Done {}
