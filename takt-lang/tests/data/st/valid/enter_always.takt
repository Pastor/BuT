// Always до проверок; exit источника и enter цели - инлайн в переход.
//
// Порядок снят зондом цели c (не предположен): always исполняется первым в
// ветви, затем проверяются переходы; при срабатывании - exit источника, следом
// enter цели, и оба в такте перехода.

var n: u8 := 0;

cond Go = n = 1;

start Src {
    enter { n := 0; }
    always { n := n + 1; }
    exit { n := 2; }
    ref Dst: Go;
}

state Dst {
    enter { n := 3; }
}
