// Несколько ref -> цепочка IF/ELSIF в порядке объявления.
//
// Порядок объявления = порядок проверки, первый сработавший выигрывает -
// изоморфно цели c, где это цепочка независимых `if` с `break`
// (stacker.c:82-101).

var n: u8 := 0;

cond First = n = 1;
cond Second = n = 2;

start Idle {
    ref A: First;
    ref B: Second;
}

state A {}
state B {}
