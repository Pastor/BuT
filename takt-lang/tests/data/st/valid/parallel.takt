// Параллельная композиция A | B.
//
// Под-модели вызываются последовательно в одном такте родителя, в порядке
// объявления; композиция завершается по конъюнкции is_done. Настоящей
// конкурентности нет - чередование детерминировано, что и нужно скан-циклу ПЛК.

model A {
    var a: u8 := 0;
    start Q { always { a := a + 1; } }
}

model B {
    var b: u8 := 0;
    start R { always { b := b + 1; } }
}

start Both = A | B;
