// Перечисление и структура.
//
// Поля структуры - скаляры: сравнивать массив с числом нельзя ("Data type
// mismatch for '=' expression"), и это ограничение IEC, а не генератора.
//
// Перечисление не становится перечислимым типом IEC: MatIEC отвергает явные
// значения вариантов. Действует откат Option C -
// целочисленный тип плюс именованные константы `Floor_Bottom` / `Floor_Top`.
// Структура порождает `TYPE ... STRUCT ... END_STRUCT; END_TYPE`.

enum Floor {
    Bottom = 80,
    Top
}

struct Coord {
    x: u8,
    y: u8
}

var origin: Coord := 0;

cond AtOrigin = origin.x = 0;

start Idle {
    ref Done: AtOrigin;
}

state Done {}
