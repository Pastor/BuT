// Используемый порт без адреса в цели st-at.
//
// Ожидается SE-052 (диагностика слоя адресов, переиспользуется без изменений):
// размещать нечего. Для цели st тот же исходник корректен - там адрес не нужен.
//
// Порт обязан использоваться: неиспользуемый отфильтровывается раньше, и
// SE-052 не срабатывает - размещать действительно нечего.
in btn: bit;
out lamp: bit at 0x500:0;

start Idle {
    always {
        lamp := btn;
    }
}
