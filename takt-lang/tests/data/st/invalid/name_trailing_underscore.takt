// Подчёркивание в конце имени - цель `st` отвечает `ST-026`.
//
// Обещание фикстуры: имя законно в Takt (прочие цели его переводят), но
// идентификатор IEC 61131-3 такой формы не принимает - `iec2c` отвечает
// "invalid located variable declaration" с указанием на `AT %...`, которого в
// объявлении нет. Отказ приходит до генерации и называет форму.
//
// Сторож обещания - `st_identifier_form_tests::every_position_is_refused`.

out sum: u8 at 0x2000;

var box_: u8 := 1;

start Run {
    always {
        box_ := box_ + 1;
        sum := box_;
    }

    ref Run;
}
