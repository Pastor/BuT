// контроль: та же непереводимая форма вне оператора - в инициализаторе
// объявления. Оператор не начат, координата берётся у самого узла, и позиция
// оператора сюда протечь не должна.
var mem: [u8; 4] := {1, 2, 3, 4};
var res: [u8; 2] := mem[1:2];
var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        probe := n + res[0];
    }
    ref Run: n < 100;
}
