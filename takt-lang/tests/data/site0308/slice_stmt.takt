// Срез бит-вектора в теле состояния: поэлементной формы у него нет ни у одной
// цели (`[bit;N]` - упакованный скаляр), и эталон его тоже не исполняет
// (`SIM-010`). Срез настоящего массива переводят четыре цели -
// пример непереводимой конструкции взят такой, какой ею и остаётся.
// Позиция отказа обязана указывать на строку оператора, а не на объявление
// операнда и не в пустоту.
var mem: [bit; 8] := 0;
var res: [bit; 8] := 0;
var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        res := mem[1:2];
        probe := n;
    }
    ref Run: n < 100;
}
