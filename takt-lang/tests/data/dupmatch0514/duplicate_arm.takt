// Фикстура: ветвь `match` с повторяющимся образцом.
//
// `match` берёт первое совпадение, поэтому вторая ветвь с меткой `1`
// недостижима. Приращения ветвей различны (1 и 10) намеренно: подмена ветви
// даёт валидный вывод и другой автомат, и видно это только числом.
//
// В корпусе `examples/` такой записи нет ни одной, поэтому класс держится этой
// фикстурой: она даёт предупреждение `SE-131` и заодно тот вход, на котором
// `cc` отвечает "duplicate case value", а `clippy` - "same condition".
var op: u8 := 0;
var acc: u8 := 0;

out probe: u8 at 0x100;

start Run {
    always {
        op := op + 1;
        match op {
            1 => { acc := acc + 1; }
            1 => { acc := acc + 10; }
            2 => { acc := acc + 100; }
        }
        probe := acc;
    }
    ref Run;
}
