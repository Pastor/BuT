// Стандартная библиотека типов Takt.
//
// Содержит псевдонимы примитивных целочисленных типов, булев тип
// и базовые вспомогательные модели (Counter, Flag, Timer).
//
// Использование:
//   import "std.takt";   // подключить стандартную библиотеку

// ─── Беззнаковые целые типы ──────────────────────────────────────────────────

/// u8: 8-битное беззнаковое целое [0 ... 255]

/// u16: 16-битное беззнаковое целое [0 ... 65535]

/// u32: 32-битное беззнаковое целое [0 ... 4 294 967 295]

/// u64: 64-битное беззнаковое целое [0 ... 18 446 744 073 709 551 615]

/// u128: 128-битное беззнаковое целое
type u128 = [bit; 128];

// ─── Булев тип ───────────────────────────────────────────────────────────────

/// bool: однобитовый булев тип (псевдоним для bit)
