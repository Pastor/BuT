// контрпример: тот же автомат, что в
// `float_bit_access.takt`, но порт целочисленный.
//
// `BitAccess` на `u8` в C транслируется - заглушка не задевается, переходы
// генерируются. Охраняет от переусердствования: ошибка `CC-018` не должна
// расползтись на переводимые условия.

in flags: u8;

start Start {
    ref Work: flags.0 = 1;
}
state Work {
    ref End: flags.1 = 0;
}
state End;
