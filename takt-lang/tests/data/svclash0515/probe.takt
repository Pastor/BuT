// Фикстура: имя порта совпадает с именем файла.
//
// Имя модуля цель `sv` строит из имени модели, а у корневой - из имени файла
// имени модуля, поэтому `out probe` здесь прячет его: `verilator` под
// `-Wall` отвечает `VARHIDDEN`, а проверка цели считает предупреждение ошибкой.
// Без отказа вывод порождается при нулевом коде возврата `taktc`; ожидается
// отказ `SV-020`.
//
// Прочие цели ту же модель переводят - отказ принадлежит цели.
out probe: u8 at 0x100;
var t: u8 := 0;

start Run {
    always {
        t := t + 1;
        probe := t;
    }
    ref Run;
}
