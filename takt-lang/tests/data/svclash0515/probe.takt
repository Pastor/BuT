// Фикстура фичи 0515: имя порта совпадает с именем файла.
//
// Имя модуля цель `sv` строит из имени модели, а у корневой - из имени файла
// (класс 0195), поэтому `out probe` здесь прячет имя модуля: `verilator` под
// `-Wall` отвечает `VARHIDDEN`, а гейт цели считает предупреждение ошибкой.
// Прежде вывод порождался при нулевом коде возврата `taktc`; теперь приходит
// отказ `SV-020`.
//
// Прочие цели ту же модель переводят - отказ принадлежит цели.
out probe: u8 at 0x100;
var t: u8 := 0;

start Run {
    always {
        t := t + 1;
        probe := t;
    }
    ref Run;
}
