model Helper {
    var speed: u8 := 0;

    start Idle { ref Idle; }
}

// Корень файла обязан иметь состояние: `import` вносит модель по имени файла,
// и без этой строки `start Main = Helper;` у импортёра ссылался бы на обёртку
// без состояний - `SE-106`. Смещения выше не сдвигаются: зонд перехода
// опирается на диапазон `speed` (19..37).
start Root = Helper;
