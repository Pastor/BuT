// Тот же приём - формула в теле состояния - но
// свойство нарушено. Контрпример к state_scope_holds.takt.
//
// Отличие от state_scope_holds.takt ровно одно: у Fault есть самопетля
// `ref Fault`. Прогон Idle -> Fault -> Fault -> ... остаётся в сбое навсегда,
// поэтому `G (Fault -> F Idle)` ложно. Контрпример: Idle -> [ Fault ]*
//
// Эта фикстура - сторож семантики области (вариант "б", решение заказчика
// 2026-07-16). Проверяйся формула от стартового состояния, как было до
// 0049-06, вердикт был бы "держится": старт и есть Idle, поэтому `F Idle`
// истинно тривиально - и залипание в Fault осталось бы незамеченным.
var error: bit := false;

start Idle {
    ref Fault: error = 1;
}

state Fault {
    : [LTL] F Idle;

    ref Fault: error = 1;
    ref Idle: error = 0;
}
