// Импорт формой `import { A as B } from "файл";`
// (ImportDefine::Rename) - самая коварная из трёх.
//
// Здесь в `models` кладётся не корень чужого файла, а `Rc::clone` его вложенной
// модели (tree.rs:248). С точки зрения badlib.takt узел Engine локален, поэтому
// его собственный `origin` - Local; пометить его обязан импортёр в момент
// вставки. Забудь это - и область молча не сработает именно на этой форме.
import { Engine as Motor } from "badlib.takt";

: [LTL] F Done;

start Work { ref Done; }
state Done;
