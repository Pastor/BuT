// Честная граница абстракции управления.
//
// `temp` - переменная, а не состояние. В абстракции управления данные не
// размечены, поэтому свойство не проверяется (Verdict::Unsupported) - молча
// считать его ложным нельзя.
: [LTL] G temp;

var temp: u8 := 0;

start Heating {
    ref Cooling;
}

state Cooling {
    ref Heating;
}
