// Примеры синтаксически корректного использования встроенных функций min, max, abs.
//
// Данный файл проверяет, что вызовы встроенных математических функций
// корректно разбираются парсером Takt.

// Пример 1: min в правой части присваивания
var x: bit := true;
var y: bit := false;
var lo: bit := min(x, y);

// Пример 2: max в правой части присваивания
var hi: bit := max(x, y);

// Пример 3: abs одного значения
var magnitude: bit := abs(x);

// Пример 4: clamp - ограничение значения в диапазон
var bounded: bit := clamp(x, y, x);

// Пример 5: вложенные вызовы
var nested: bit := min(max(x, y), abs(x));

start S;
