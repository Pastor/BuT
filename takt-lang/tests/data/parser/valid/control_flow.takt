// Управляющие конструкции (позитивный тест парсера)
// loop без условия - бесконечный цикл; loop условие { } - условный.
// do-while удалён из языка.
// Примечание: var-объявления внутри блоков операторов не поддерживаются.

model M {
    var i: u8 := 0;
    var j: u8 := 0;
    start S {
        always {
            // if без скобок. Здесь сравнение (`=`), а не присваивание:
            // с фикса 0187-01 запись в условии незаконна (`SY-006`) - условие
            // вычисляет значение, а не выполняет действие.
            if i = 0 {
                i := 1;
            }

            // if-else
            if i > 5 {
                i := 0;
            } else {
                i := i + 1;
            }

            // Цикл loop с условием (аналог while)
            loop i < 10 {
                i := i + 1;
            }

            // Бесконечный цикл loop
            loop {
                j := j + 1;
                if j > 5 { break; }
            }

            // Цикл for
            for i := 0; i < 10; i := i + 1 {
                j := j + i;
            }
        }
    }
}
