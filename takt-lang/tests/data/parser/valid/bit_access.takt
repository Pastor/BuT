/// Пример работы с BitAccess - чтение и запись отдельных битов переменных и портов.
///
/// Синтаксис: `expr.N` - доступ к N-му биту числового значения или порта.
/// При чтении переменной: ((x >> N) & 1u)
/// При записи переменной: x = (x & ~(1u << N)) | ((val & 1u) << N)
/// При чтении порта: (*main->read_bit)(PORT_X, N, main->userdata)
/// При записи порта: (*main->write_bit)(PORT_X, N, val, main->userdata)

/// Порт кнопок: 8 кнопок по одному биту каждая.
in BTN: u8 at 0x00200000;
/// Порт светодиодов: 8 LED по одному биту каждый.
out LED: u8 at 0x00100000;

model BitOps {
    /// Регистр флагов состояния.
    var flags: u8 := 0;

    /// Начальное состояние: читаем кнопку и записываем в флаги.
    start Idle {
        always {
            /// Читаем бит 0 порта BTN -> записываем в бит 0 flags.
            /// Генерируется: model->flags = (model->flags & ~(1u << 0)) | (((*main->read_bit)(PORT_BIT_OPS_BTN, 0, ...) & 1u) << 0)
            flags.0 := BTN.0;
        }
        /// Переход по биту 0 flags.
        /// Генерируется условие: ((model->flags >> 0) & 1u)
        ref Active: flags.0;
    }

    /// Активное состояние: отражаем кнопку на LED.
    state Active {
        always {
            /// Бит 1 BTN -> LED 7.
            /// Генерируется: (*main->write_bit)(PORT_BIT_OPS_LED, 7, (*main->read_bit)(PORT_BIT_OPS_BTN, 1, ...), ...)
            LED.7 := BTN.1;
        }
        /// Возвращаемся если кнопка отпущена.
        ref Idle: flags.0;
    }
}

start M = BitOps;
