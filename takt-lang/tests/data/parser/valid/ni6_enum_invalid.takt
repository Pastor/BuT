// NI6: примеры некорректных операций с типом enum (контрпримеры)
// Эти присваивания должны вызывать ошибки типизации
enum Direction {
    North,
    South,
    East,
    West
}

// ошибка: значение 99 не является вариантом Direction
// var heading: Direction = 99;

// ошибка: значение -1 не является вариантом Direction
// var heading: Direction = -1;
