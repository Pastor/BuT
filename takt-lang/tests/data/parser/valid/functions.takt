// Определения функций (позитивный тест парсера)

// Объявление функции без тела (внешняя)
extern fn debug(msg: u8);

// Функция с телом и возвращаемым значением
fn add(a: u8, b: u8) -> u8 {
    return a + b;
}

// Функция без возвращаемого значения
extern fn reset();

model M {
    var result: u8 := 0;
    start S {
        always {
            // Вызов функции внутри always - только выражения
            debug(42);
            result := add(1, 2);
        }
    }
}
