// Фикстура фичи 0213: условное ребро и терминальное состояние.
//
// Контр-пример к правке: у условного ребра `break;` обязателен - он выходит из
// `switch` изнутри блока `if`. Терминальное состояние (`Stop` - пустое, ни
// рёбер, ни тела) получает `model->state = <МОДЕЛЬ>_END;` и закрывающий
// `break;` ветви.
//
// У `Stop` не должно быть тела: состояние с телом автомат не завершает -
// оно работает, пока его не уведут (правило стабильности состояния).
var n: u8 := 0;

start Wait {
    always {
        n := n + 1;
    }
    ref Stop: n = 2;
}

state Stop;
