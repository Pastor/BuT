// Фикстура фичи 0213: ребро, записанное после безусловного.
//
// Условие хвоста истинно на том же такте (`n = 1`): так фикстура различает
// верную правку и половинчатую ("break; снят, обход рёбер продолжается").
//
// В корпусе `examples/` такой записи нет ни одной (проверено обходом), поэтому
// класс держится только этой фикстурой. Безусловное `ref Done;` завершает
// цепочку: `ref Late` недостижим и у эталона (симулятор выбирает `Done`), и в
// целях `rust`/`st`/`sv`. Цель `c` обязана вести себя так же - не печатать ни
// хвост, ни собственный `break;`.
var n: u8 := 0;

start Run {
    always {
        n := n + 1;
    }
    ref Done;
    ref Late: n = 1;
}

state Done {
    always {
        n := 0;
    }
}

state Late {
    always {
        n := 9;
    }
}
