// Прерывание вне цикла - вход корпуса для `SE-132`.
//
// Без отказа запись принимается молча, и потребители расходятся: эталон прерывает
// тело и проверял переходы, а цель `c` печатала `break;` внутри ветви `case` -
// управление выходило из `switch` мимо присваивания состояния, и автомат не
// уходил из состояния никогда.
model BreakOutside {
    var ticks: u8 := 0;

    start Run {
        always {
            ticks := ticks + 1;
            break;
        }
        ref Done: ticks >= 1;
    }

    state Done;
}

start Main = BreakOutside;
