// Ce5: Два оператора next в одном состоянии - ошибка.
//
// Правило Ce5.4: в одном состоянии не может быть двух next.
// Используем уже существующий тест double_next.takt как базу.
// Ожидается: семантическая ошибка.

model M {
    start S;
}

start A = M {
    next B;
    next C;
}
state B;
state C;
