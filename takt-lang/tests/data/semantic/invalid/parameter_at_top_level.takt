// Контрпример: параметр верхнего уровня файла.
//
// Верхний уровень - анонимная корневая модель; в выражении реализации она по
// имени не появляется, то есть задать её параметр в месте инстанцирования
// нечем. Отказ `SE-075` вместо объявления, которое молча вело бы себя как `var`.

parameter limit: u8 := 100;

start Idle {
    ref Done: limit > 0;
}

state Done;
