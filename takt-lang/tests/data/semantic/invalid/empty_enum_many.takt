// Накопление - каждое пустое перечисление высказывается
// само за себя, включая объявленное во вложенной модели (правило фичи 0151).
enum Mode { }
enum Command { }

model Inner {
    enum Level { }

    var k: u8 := 0;

    start Wait {
        always { k := k + 1; }
        ref Wait: k = 0;
    }
}

var n: u8 := 0;

start Run {
    always { n := n + 1; }
    ref Done: n >= 3;
}

state Done { }
