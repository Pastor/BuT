// Контрпример: числовой литерал не помещается в тип приёмника (SE-089).
//
// Лексер такие литералы принимает - они внутри [i64::MIN, u64::MAX], то есть
// внутри объединения диапазонов всех целых типов языка. Влезает ли значение в
// конкретный тип, знает только семантика.
//
// Без этой проверки не проверял никто: `taktc` рапортовал успех, а порождённый C
// отвергался проверкой цели (-Wconstant-conversion под -Werror).

model M {
    var a: u8 := 300;
    var b: i8 := -200;

    start S {
        always {
            a := 999;
            b := b;
        }
    }
}

start Root = M;
