// Перечисление без вариантов - ошибка языка.
// Отказ грамматики (SY-002 "нераспознанный токен '}'") здесь не годится: то есть
// правило языка было свойством квантификатора, а не решением.
enum Mode { }

var n: u8 := 0;

start Run {
    always { n := n + 1; }
    ref Done: n >= 3;
}

state Done { }
