// Структура без полей - ошибка языка.
// Без отказа запись принимается, а вывод не принимают чужие инструменты: цель `c`
// печатала расширение GNU (C11 6.7.2.1), а порождённый ST отвергал `iec2c`.
struct Empty { }

var e: Empty;
var n: u8 := 0;

start Run {
    always { n := n + 1; e := e; }
    ref Done: n >= 3;
}

state Done { }
