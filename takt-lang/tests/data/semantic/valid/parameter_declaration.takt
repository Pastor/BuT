// Объявление параметра модели.
//
// `parameter` - третья форма объявления наряду с `var` и `const`. Инициализатор
// обязателен: это значение по умолчанию. Аргументы инстанцирования
// (`Tuner(limit := 200)`) проверяется отдельно; здесь проверяется только
// объявление, поэтому модель используется без них.
//
// В семантическом дереве параметр - обычная переменная (в режиме генерации по
// умолчанию `--parameters=assign` он и есть поле экземпляра), а порядок
// объявления сохраняется в `ModelNode::parameters`.

model Tuner {
    parameter limit: u8 := 100; // порог срабатывания
    parameter step: u8 := 5;    // шаг накопления
    var acc: u8 := 0;           // накопитель — величина такта, не настройка

    start Count {
        always {
            acc := acc + step;
        }
        ref Done: acc >= limit;
    }

    state Done;
}

start Main = Tuner;
