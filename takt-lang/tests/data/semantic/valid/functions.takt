// Пример: локальные и внешние функции.
//
// Локальные функции объявляются с телом.
// Внешние функции объявляются с ключевым словом extern и без тела.
//
// Примечание: тело функции видит переменные И другие функции своей модели
// (композиция). Рекурсия запрещена (SE-053).

// Внешние функции
extern fn send(data: bit);
extern fn recv() -> bit;
extern fn noop();

// Локальная функция с параметром и возвратом
fn identity(x: bit) -> bit {
    return true;
}

// Локальная функция без параметров
fn init() {
    return;
}
