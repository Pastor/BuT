// Пример файла с документационными комментариями (///  ).
// Используется в интеграционных тестах для проверки Се12.

/// Псевдоним типа: 8-битное беззнаковое целое.
type Byte = [bit;8];

/// Переменная-счётчик, используемая в примере.
var counter: Byte := 0;

/// Условие: счётчик достиг максимального значения.
cond MaxReached = counter = 255;

/// Модель светофора с тремя состояниями.
/// Управляет циклическими переходами между состояниями.
model TrafficLight {
    /// Счётчик тактов в текущем состоянии.
    var timer: [bit;8] := 0;

    /// Начальное состояние - красный свет.
    /// Автомат всегда стартует здесь.
    start Red {
        enter { timer := 0; }
        always { timer := timer + 1; }
        ref Green: timer = 100;
    }

    /// Зелёный свет - разрешение движения.
    state Green {
        enter { timer := 0; }
        always { timer := timer + 1; }
        ref Yellow: timer = 50;
    }

    /// Жёлтый свет - предупреждение перед сменой.
    state Yellow {
        enter { timer := 0; }
        next Red;
    }
}
