// Пример: управляющие конструкции (if, loop, for) в named blocks.
// loop без условия - бесконечный цикл; loop условие { } - условный.
// do-while удалён из языка.
//
// Проверяет корректное разрешение операторов управления потоком
// внутри именованных блоков состояний.

var counter: [bit; 8] := 0;
var flag: bit := false;
var i: [bit; 8] := 0;

start Running {
    always {
        // if без скобок
        if flag {
            counter := counter;
        }
        if flag {
            counter := counter;
        } else {
            flag := false;
        }

        // loop с условием (аналог while)
        loop counter < 10 {
            counter := counter;
        }

        // бесконечный loop с break
        loop {
            counter := counter;
            break;
        }

        // for без скобок, тело в {}
        for i := 0; i < 5; i := i + 1 {
            counter := counter;
        }
    }
}

state Done {
    enter {
        counter := counter;
    }
}
