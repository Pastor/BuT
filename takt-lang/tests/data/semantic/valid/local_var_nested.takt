// Пример С4: вложенные блоки, затенение переменной.
//
// Внешняя переменная x (уровня модели) затеняется локальной x
// во внутреннем блоке. После выхода из блока снова видна model-level x.

var x: bit := true;

start S {
    always {
        {
            var x: bit := false;
            x := false;
        }
        // Здесь x - снова ссылка на model-level x
        x := true;
    }
}
