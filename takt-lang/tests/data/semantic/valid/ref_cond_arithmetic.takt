/// Контрпример: арифметическое выражение в ref-условии.
///
/// Условие `counter + 1` - числовое (не булево), что порождает
/// предупреждение Се11 о неявном приведении к bool.
/// Правильный вариант: `ref Next: counter != 255;`

var counter: [bit;8] := 0;

start Counting {
    ref Done: counter + 1;
}

/// Конечное состояние (нет исходящих ref).
state Done;
