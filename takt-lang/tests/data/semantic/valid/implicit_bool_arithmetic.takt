// Пример для Се11: арифметическое выражение как условие перехода.
// Семантически допустим (предупреждение - не ошибка).
//
// ref T: timer + 1  ->  Предупреждение Се11: арифметическое сложение

var timer: [bit;8] := 0;

start S {
    always { timer := timer + 1; }
    ref T: timer + 1;    // Предупреждение: числовой результат вместо bool
}

state T {
    next S;
}
