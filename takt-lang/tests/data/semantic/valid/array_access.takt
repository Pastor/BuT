// Пример: корректное обращение к элементам массива.
//
// Проверяет:
// - ArraySubscript в допустимых границах
// - ArraySlice с корректными границами

type Byte = [bit; 8];

// Индекс по упакованному вектору `[bit; N]` - это разряд, и
// узлом он становится тем же, что у записи `buf.0`. Индексация элемента живёт
// на массиве не-битов - ниже.
var buf: Byte := 0;
var bit0: bit := buf[0];
var bit7: bit := buf[7];

var bus: [u8; 4] := {1, 2, 3, 4};
var second: u8 := bus[1];
var last: u8 := bus[3];

start S;
