// Примеры использования встроенных математических функций языка Takt.
//
// Встроенные функции min, max, abs, clamp доступны в любом контексте программы
// и работают с числовыми типами: bit, float, [bit;N].

// Переменные для демонстрации
var a: bit := true;
var b: bit := false;

// Вызов min: возвращает минимум двух значений
// min(a, b) -> минимальное из a и b
var min_result: bit := min(a, b);

// Вызов max: возвращает максимум двух значений
// max(a, b) -> максимальное из a и b
var max_result: bit := max(a, b);

// Вызов abs: возвращает абсолютное значение
// abs(x) -> |x|
var abs_result: bit := abs(a);

// Вызов clamp: ограничение значения в диапазон [lo, hi]
// clamp(x, lo, hi) -> x если lo <= x <= hi; иначе lo или hi
var clamp_result: bit := clamp(a, b, a);

// Конечный автомат с использованием встроенных функций
start Idle {
    always {
        // Применяем min/max/abs/clamp для обработки числовых значений
        var lo: bit := min(a, b);
        var hi: bit := max(a, b);
        var magnitude: bit := abs(a);
        var bounded: bit := clamp(a, b, a);
        debug("вычисление завершено");
    }
    ref Idle: a = 0;
}
