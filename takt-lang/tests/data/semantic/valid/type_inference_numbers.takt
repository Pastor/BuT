// Пример: вывод типов для числовых литералов.
//
// Правило: числовой литерал без аннотации получает минимальный
// целочисленный тип с шагом удвоения начиная с 8 бит:
//   0..=255            -> [bit;8]
//   256..=65535        -> [bit;16]
//   65536..=4294967295 -> [bit;32]
//   иначе              -> [bit;64]

// 8-битные числа (0..=255)
var a := 0;
var b := 100;
var c := 255;

// 16-битные числа (256..=65535)
var d := 256;
var e := 1000;
var f := 65535;

// 32-битные числа (65536..=4294967295)
var g := 65536;
var h := 1000000;
