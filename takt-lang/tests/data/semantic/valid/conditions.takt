// Пример: именованные условия переходов.
//
// Проверяет разрешение всех базовых форм условий:
// - AlwaysTrue / AlwaysFalse - константы
// - IsFlagSet - ссылка на переменную
// - Negated - логическое не
// - Grouped - скобочная группировка

var flag: bit := false;

cond AlwaysTrue  = true;
cond AlwaysFalse = false;
cond IsFlagSet  = flag;
cond Negated      = !flag;
cond Grouped      = (flag);

start Active {
    ref Done: AlwaysTrue;
}
state Done;
