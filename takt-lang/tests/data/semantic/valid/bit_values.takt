// Допустимые значения для типа bit:
//   - числовые литералы 0 и 1
//   - булевы литералы true и false
//   - ссылки на переменные того же типа

var a: bit := 0;
var b: bit := 1;
var c: bit := true;
var d: bit := false;

// Инициализация из другой переменной - допустима
var e: bit := a;

// Константы
const ZERO: bit := 0;
const ONE: bit := 1;

// Массив bit: числовые инициализаторы проверяются иначе
var buf: [bit; 8] := 255;
