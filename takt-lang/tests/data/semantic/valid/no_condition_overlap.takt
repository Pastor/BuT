// Пример: переходы из одного состояния с невзаимоисключающими условиями.
//
// NI4: перекрытия условий здесь нет - каждое условие покрывает уникальное
// подмножество значений переменной.

var level: [bit;8] := 0;

start Idle {
    // Переходы в разные состояния по непересекающимся условиям
    ref Low:  level < 10;
    ref High: level > 20;
}

state Low {
    ref Idle: level >= 10;
}

state High {
    ref Idle: level <= 20;
}
