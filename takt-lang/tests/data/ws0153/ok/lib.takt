// Библиотека рабочей области: её верхнеуровневые объявления
// импорт переносит потребителю (усыновление), поэтому именно они видны
// за границей файла.
var speed: u8 := 0;

fn doubled(x: u8) -> u8 {
    return x;
}

model Helper {
    var inner: u8 := 0;

    start Idle { ref Idle; }
}

start Root = Helper;
