// Потребитель формы `import "файл" as Имя;`: `Lib` введено самим импортом и за
// границей файла ни с чем не связано - переименование обязано отказать
// (граница правила о видах символов рабочей области).
import "lib.takt" as Lib;

var ticks: u8 := 0;

start Tick {
    always {
        ticks := ticks + 1;
    }
    ref Tick;
}
