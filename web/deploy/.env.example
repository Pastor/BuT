# Окружение стенда Takt.
#
# Скопируйте в `web/deploy/.env` и заполните. Сам `.env` в дерево не
# коммитится: в нём пароль базы и секрет подписи токенов.

# Локейшен, под которым сервис отдаёт nginx. Тот же префикс задаётся скрипту
# настройки nginx (`PREFIX=/takt`) - иначе страница будет строить адреса от
# одного корня, а прокси отдавать от другого.
TAKT_WEB_BASE_PATH=/takt

# Секрет подписи access-токенов. Без него подъём стенда отказывает: с
# умолчанием токен подпишет кто угодно.
# Сгенерировать: openssl rand -base64 48
TAKT_WEB_JWT_SECRET=

# База. Пароль - свой, не из примера.
POSTGRES_USER=takt
POSTGRES_PASSWORD=
POSTGRES_DB=takt_web

# Куда слушать: только петля - наружу сервис выпускает nginx.
TAKT_WEB_BIND=127.0.0.1:8730

# Срок хранения проекта без обращений, дней.
TAKT_WEB_RETENTION_DAYS=90

# ── Вход через площадки ────────────────────────────────────────────────────
#
# Без `TAKT_WEB_PUBLIC_URL` ни одна площадка не включится: из него строится
# `redirect_uri`, а он обязан В точности совпасть с зарегистрированным.
# Выводить его из заголовка `Host` нельзя - заголовок приходит от клиента.
# Адрес возврата, который надо зарегистрировать у площадки:
#   <PUBLIC_URL><BASE_PATH>/api/oauth/yandex/callback
#   <PUBLIC_URL><BASE_PATH>/api/oauth/vk/callback
TAKT_WEB_PUBLIC_URL=https://pastor.axatel.ru

# Половина пары роняет старт с названным ключом: молчаливое "площадка
# выключена" при заданном идентификаторе означало бы, что конфигурация врёт.
# Пусто и то и другое - кнопки просто нет.
TAKT_WEB_OAUTH_YANDEX_CLIENT_ID=
TAKT_WEB_OAUTH_YANDEX_CLIENT_SECRET=

TAKT_WEB_OAUTH_VK_CLIENT_ID=
TAKT_WEB_OAUTH_VK_SERVICE_TOKEN=

# Кнопка "Mail" живёт внутри VK ID и включается в его кабинете - сервер узнать
# об этом сам не может.
TAKT_WEB_OAUTH_VK_MAIL=0

# Таймаут исходящего запроса к площадке: без него обработчик висел бы вместе с
# ней, держа соединение к базе.
TAKT_WEB_OAUTH_TIMEOUT=10
