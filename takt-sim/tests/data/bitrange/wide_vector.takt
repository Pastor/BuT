// Разряд за пределами 128-разрядного значения `[bit;96]` (два слова, 0078).
//
// Вход отсекает семантика (`SE-125`), и это правильный ответ:
// объявленная ширина здесь известна, а `SIM-011` говорил бы о носителе.
// Прежде разряд брался у результата вызова - тип не выводился, и до прогона
// дело доходило; с фичи 0432 результат вызова поднимается во временную, тип
// становится известен, и ветвь `SIM-011` для многословного значения стала
// недостижимой (у скаляра она достижима - см. `narrow_scalar.takt`).
var src: [bit; 96] := 0;

var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        probe := src.200;
    }
    ref Run: n < 100;
}
