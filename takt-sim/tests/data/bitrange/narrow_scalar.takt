// Скалярный `[bit;8]` (<= 64 - упакованный скаляр, 0078): разряд 70 вне
// носителя. Объявленной ширины у значения в этот момент нет - эталон говорит
// правду о носителе, а не догадывается об объявлении (граница фичи 0307).
//
// Разряд берётся у выражения: с фичи 0394 литеральный разряд за
// объявленной шириной отвергает семантика (`SE-125`), и до прогона дело не
// доходит. Тип выражения она не выводит - там и виден носитель.
//
// Прежде здесь стоял результат вызова; с фичи 0432 он поднимается во
// временную, тип известен, и вход отсекает `SE-125`.
var src: [bit; 8] := 0;

var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        probe := (src + 0).70;
    }
    ref Run: n < 100;
}
