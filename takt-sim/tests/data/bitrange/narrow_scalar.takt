// Скалярный `[bit;8]` (до 64 - упакованный скаляр): разряд 70 вне
// носителя. Объявленной ширины у значения в этот момент нет - эталон говорит
// правду о носителе, а не догадывается об объявлении.
//
// Разряд берётся у выражения: литеральный разряд за
// объявленной шириной отвергает семантика (`SE-125`), и до прогона дело не
// доходит. Тип выражения она не выводит - там и виден носитель.
//
// Результат вызова здесь не годится: он поднимается во
// временную, тип известен, и вход отсекает `SE-125`.
var src: [bit; 8] := 0;

var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        probe := (src + 0).70;
    }
    ref Run: n < 100;
}
