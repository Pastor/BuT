// контроль: разряд 70 внутри 128 разрядов - эталон его исполняет.
//
// Прежде отказ говорил "вне диапазона 0..64" - ложь: разряд 70 тот же эталон
// исполняет (см. `wide_vector_ok.takt`).
var w: [bit; 96] := 0;
var n: u8 := 0;

out probe: u8 at 0;

start Run {
    always {
        n := n + 1;
        w.70 := 1;
        probe := n;
    }
    ref Run: n < 100;
}
