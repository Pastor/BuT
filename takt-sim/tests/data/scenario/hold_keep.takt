/// Положительный пример: **удержание до конца охлаждения**.
///
/// Тот же контроллер, что и в контрпримере `hold_break.takt`, но спроектированный
/// правильно: выход из `Cooling` возможен **только** при `temperature = 0`
/// (именованное условие `Cooled`), а куда идти дальше - решает счётчик циклов
/// (`CyclesDone`). Состояние удерживает управление, пока не выполнит свою работу.
///
/// Приём: условия выхода **непересекающиеся и покрывающие** - `Cooled &
/// CyclesDone` против `Cooled & !CyclesDone`. Именно он чинит `Cooling -> Done` в
/// `examples/comprehensive.takt`.
model HoldKeep {
    var temperature: u8 := 101;
    var count: u8 := 1;
    const COOL_STEP: u8 := 3;
    const MAX_COUNT: u8 := 1;

    /// Объект охлаждён - работа состояния выполнена
    cond Cooled = temperature = 0;
    /// Программа испытаний выполнена
    cond CyclesDone = count >= MAX_COUNT;

    start Cooling {
        always {
            for var i: u8 := 0; i < COOL_STEP; i := i + 1 {
                if temperature > 0 {
                    temperature := temperature - 1;
                }
            }
        }
        ref Done: Cooled & CyclesDone;
        ref Idle: Cooled & !CyclesDone;
    }

    state Idle {
        enter {
            temperature := 0;
        }
    }

    state Done {
        enter {
            count := 0;
        }
    }
}

start Entry = HoldKeep;
