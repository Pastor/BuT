// Вложенная цепочка `+` внутри параллели - цели `st` и `sv`.
//
// Форма `A + ((B + C) | D)` трудна сразу двумя вещами: цепочка `B + C` стоит
// внутри параллели, которая сама является шагом другой цепочки (место в дереве
// - путь `[1, 0]`), и у вложенной цепочки нет выхода из состояния - её
// завершение читает вмещающая параллель.
//
// Значения ветвей различны и меняются по тактам: превращение цепочки в
// параллель, её пропуск и путаница шагов видны трассой.
model A {
    var n: u8 := 0;
    out oa: u8 at 0x100;
    start Go { always { n := n + 1; oa := n; } ref Fin: n = 2; }
    state Fin;
}

model B {
    var m: u8 := 0;
    out ob: u8 at 0x104;
    start Go { always { m := m + 2; ob := m; } ref Fin: m = 4; }
    state Fin;
}

model C {
    var k: u8 := 0;
    out oc: u8 at 0x108;
    start Go { always { k := k + 3; oc := k; } ref Fin: k = 9; }
    state Fin;
}

model D {
    var q: u8 := 0;
    out od: u8 at 0x10c;
    start Go { always { q := q + 4; od := q; } ref Fin: q = 8; }
    state Fin;
}

start All = A + ((B + C) | D);
