// Именованное условие с вызовом функции.
//
// `cond` разрешается на стадии 3, тела функций - на стадии 5, а поиск функции
// отдаёт снимок определения: условие держало неразрешённую копию, и запись не
// работала ни у эталона, ни у целей.
//
// Наблюдаются две величины: `probe` - значение самой функции, `phase` -
// сторона, выбранная условием. Первое доказывает, что функция посчиталась,
// второе - что условие сработало в верный такт.
model CondCall {
    out probe: u8;

    out phase: u8;

    var step: u8 := 0;

    fn doubled() -> u8 {
        return step * 2;
    }

    cond warm = doubled() > 3;

    start Cold {
        always {
            step := step + 1;
            probe := doubled();
            phase := 1;
        }

        ref Hot: warm;

        ref Cold: step < 200;
    }

    state Hot {
        always {
            probe := doubled();
            phase := 2;
        }

        ref Hot;
    }
}

start Main = CondCall;
