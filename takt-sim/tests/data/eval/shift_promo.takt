/// Сдвиг с целочисленным продвижением.
///
/// В C `uint8_t x = 1; x = x << 8;` даёт 0 без UB: операнд продвигается до int
/// (C11 6.5.7p3), 1<<8 = 256, запись в uint8_t усекает. Проверено на cc.
/// Первоначальная формулировка S4 (считавшая это UB) была ошибочной.
var x: u8 := 1;

start Idle {
    always { x := x << 8; }
}
