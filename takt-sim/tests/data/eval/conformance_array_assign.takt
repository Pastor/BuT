// Сверка присваивания агрегата массива в теле.
//
// До фичи эталон, `c`, `c-hal`, `rust` и `plantuml` вход исполняли, а `st` и
// `sv` отказывали: в IEC 61131-3 агрегатной формы значения массива нет, а у
// `sv` присваивание печаталось как есть. Текст отказа `st` при этом обещал
// на работу, которой не было.
//
// Значения разные по элементам и меняются по тактам: одинаковые элементы не
// показали бы перепутанного порядка, а неизменные - потери присваивания.
var a: [u8; 2] := {0, 0};
var i: u8 := 0;

out first: u8 at 0;
out second: u8 at 1;

start Run {
    always {
        i := i + 1;
        a := {i, i + 10};
        first := a[0];
        second := a[1];
    }
    ref Run: i < 100;
}
