// Массив как возврат функции и индексация результата вызова.
//
// Значения элементов различаются, и оба читаются: перепутанный элемент или
// потерянный вызов видны трассой.
fn pair(base: u8) -> [u8; 2] {
    var r: [u8; 2] := {base, base + 10};
    return r;
}

var got: [u8; 2] := {0, 0};
var k: u8 := 0;
out lo: u8 at 0x100;
out hi: u8 at 0x104;

start Run {
    always {
        k := k + 1;
        got := pair(k);
        lo := got[0];
        hi := pair(k)[1];
    }
    ref Run;
}
