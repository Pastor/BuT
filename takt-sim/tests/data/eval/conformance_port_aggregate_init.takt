// Фикстура сверки начального значения составного порта.
//
// Порт составного типа разворачивается по листам (0350/0417), и до этой фичи
// разворот выбрасывал начальное значение молча: эталон показывал `{4, 5, 6}`,
// а цели не писали ничего - при валидном выводе и нулевом коде возврата.
//
// Держит все три формы объявления, у которых начальное значение агрегатное:
//   * массив,
//   * структура (порядок полей значим - правило 0034),
//   * перечисление (значение варианта известно при компиляции - SE-094).
struct Pair {
    lo: u8,
    hi: u8
}

enum Mode {
    Idle = 1,
    Work = 2
}

model Worker {
    var n: u8 := 0;
    out bus: [u8; 3] := {4, 5, 6};
    out pair: Pair := {7, 8};
    out mode: Mode := Work;
    out probe: u8;

    start Run {
        always {
            n := n + 1;
            // Читать выходной порт нельзя (SE-027), поэтому наблюдаемым служит
            // отдельный порт: сверка смотрит на записи HAL по тактам.
            probe := n;
        }
        ref Run: n < 10;
    }
}

start Main = Worker;
