// Порт составного типа: путь глубже одного шага и в трёх местах.
//
// Порт разворачивается по листам, и обращение к листу -
// цепочка шагов. Здесь она приходит трижды: записью (`cfg.tail.b := ...`),
// чтением в теле (`probe := ...`) и чтением в условии ребра. Контрольный шаг -
// `cfg.head`: путь длиной один, он работает и одношаговым разбором, и без него совпадение
// сторон значило бы лишь, что обе одинаково исполняют исправленное.
//
// Порт двунаправленный: значение, записанное моделью, читают обе стороны, и
// сценарий входов не нужен.
struct Inner {
    a: u8,
    b: u8
}

struct Outer {
    head: u8,
    tail: Inner
}

model NestedPort {
    inout cfg: Outer;

    out probe: u8;

    var step: u8 := 0;

    start Cycle {
        always {
            step := step + 1;
            cfg.head := step;
            cfg.tail.b := step + 10;
            probe := cfg.tail.b + cfg.head;
        }

        ref Hot: cfg.tail.b > 12;

        ref Cycle: step < 200;
    }

    state Hot {
        always {
            probe := 99;
        }

        ref Hot;
    }
}

start Main = NestedPort;
