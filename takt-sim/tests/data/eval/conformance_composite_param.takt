// Сверка массива с составным элементом в параметре функции.
//
// Массив скаляров цель `sv` передаёт плоским вектором, а
// массив структур, перечислений и вложенный массив остались распакованным
// портом функции - "input/output/inout ports cannot have unpacked dimensions"
// у yosys при нулевом коде возврата `taktc`; у цели `st` вложенный массив
// вдобавок давал имя типа со скобками (`TAKT_ARR_2_ARRAY_[0..1]_OF_USINT`),
// которое отвергает `iec2c`. Оба класса невидимы линту: verilator и `taktc`
// принимали прежний вывод.
//
// Наблюдаемые различают края массива и поля элемента, а значения меняются по
// тактам: перепутанный порядок конкатенации даёт валидный RTL с зеркальными
// значениями, и различить его может только сверка.
//
// Наблюдаемые перечисления (`m0`, `m1`) различают позиции (1 против 2), но
// по тактам постоянны: варианты - значения времени компиляции, и менять их
// нечем. Время держат остальные четыре порта.
struct Cell {
    lo: u8,
    hi: u8
}

enum Mode {
    Idle = 1,
    Work = 2
}

var cells: [Cell; 2] := {{1, 2}, {3, 4}};
var grid: [[u8; 2]; 2] := {{5, 6}, {7, 8}};
var modes: [Mode; 2] := {Idle, Work};
var n: u8 := 0;

out lo0: u8 at 0;
out hi1: u8 at 1;
out g00: u8 at 2;
out g11: u8 at 3;
out m0: u8 at 4;
out m1: u8 at 5;

fn first_lo(a: [Cell; 2]) -> u8 {
    return a[0].lo;
}

fn last_hi(a: [Cell; 2]) -> u8 {
    return a[1].hi;
}

fn corner(a: [[u8; 2]; 2]) -> u8 {
    return a[0][0];
}

fn far(a: [[u8; 2]; 2]) -> u8 {
    return a[1][1];
}

fn head_mode(a: [Mode; 2]) -> u8 {
    return a[0] as u8;
}

fn tail_mode(a: [Mode; 2]) -> u8 {
    return a[1] as u8;
}

start Run {
    always {
        n := n + 1;
        cells[0].lo := n;
        cells[1].hi := n + 20;
        grid[0][0] := n + 40;
        grid[1][1] := n + 60;
        lo0 := first_lo(cells);
        hi1 := last_hi(cells);
        g00 := corner(grid);
        g11 := far(grid);
        m0 := head_mode(modes);
        m1 := tail_mode(modes);
    }
    ref Run: n < 100;
}
