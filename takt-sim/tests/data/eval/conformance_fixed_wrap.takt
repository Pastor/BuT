// Переполнение `+` над q(8,8) - wraparound (перенос), не насыщение (T19,
// правило 3 ADR 0061). max repr = 32767 (127.996...); 32767 + 1 = 32768 -> -32768.
model FixedWrap {
    var big: q(8, 8) := 127.99609375;
    var one: q(8, 8) := 0.00390625;
    start S0 { always { big := big + one; } }
}
start Entry = FixedWrap;
