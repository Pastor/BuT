// Сверка длительности в поле структуры и в массиве.
//
// `t.hold as u32` цель `st` отвергала `ST-011` ("тип операнда не определяется
// статически"), хотя тип поля объявлен; цель `sv` печатала агрегат структуры
// безразмерными литералами (`{5, 10}`), и verilator отвечал `WIDTHCONCAT` -
// а гейт цели считает предупреждение ошибкой. Обе - при нулевом коде возврата
// `taktc`.
//
// Массив длительностей - контрольный вход: он работал всегда.
struct Timing { hold: duration, gap: duration }
var t: Timing := {5ms, 10ms};
var arr: [duration;2] := {1ms, 2ms};
var sum: u32 := 0;
out o: u32 at 0;
start Run {
    always {
        sum := (t.hold as u32) + (arr[1] as u32);
        o := sum;
    }
    ref Run: sum = 7;
}
