// Сверка сдвигов `<<`/`>>`.
//
// Ключевой вход - сдвиг вправо отрицательного: до фичи цель `st` печатала
// `SHR` над битовой строкой, а `sv` - логический `>>`, и оба давали **124**
// вместо −4. Эталон, `c` и `rust` давали −4.
//
// Нечётное значение (−7) обязательно: на чётном floor и усечение к нулю
// совпадают, и подмена арифметического сдвига делением была бы незаметна.
var neg: i8 := -7;
var pos: u8 := 3;
var i: u8 := 0;

out right: i8 at 0;
out left: u8 at 1;

start Run {
    always {
        i := i + 1;
        right := neg >> 1;
        left := pos << 2;
    }
    ref Run: i < 100;
}
