// Локальная, которую тело только пишет.
//
// Признак 0376 считал запись использованием, поэтому заглушки такая переменная
// не получала. Замер 2026-08-22 - вывод отвергают инструменты пяти целей при
// нулевом коде возврата `taktc`:
//
//   c, c-hal    `variable 'spare' set but not used` (-Werror);
//   rust        `unused variable: spare` (-D warnings);
//   sv, sv-mmio `UNUSEDSIGNAL` (verilator -Wall);
//   st, st-at   принимают; эталон исполняет.
//
// Значения здесь не расходятся: мёртвая переменная на поведение не влияет.
// Дефект в том, что вывод не собирается, - поэтому сторож гоняет инструменты
// целей, а трасса лишь подтверждает, что заглушки ничего не изменили.
var n: u8 := 0;

out o: u8 at 0;

start Run {
    always {
        var spare: u8 := 0;
        spare := n + 5;
        n := n + 1;
        o := n;
    }
    ref Run: n < 100;
}
