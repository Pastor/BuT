// Фикстура сверки значений типа `duration` для цели `sv`.
//
// Отдельная от `conformance_duration_value.takt` (той, что сверяют `c`, `rust`
// и `st`), и причина названа: приведение `as` цель `sv` не транслирует
// (`SV-002`), поэтому числа миллисекунд у неё через порт не увидеть.
//
// Наблюдение косвенное и потому тройное - значение зажимается с двух сторон и
// проверяется на равенство:
//   late  = elapsed > 500ms    - нижняя граница;
//   exact = elapsed = 1750ms   - точное значение (форма, которой нет в фикстуре
//                                целей `c`/`rust`: там сравнение только одно);
//   over  = elapsed > 1800ms   - верхняя граница.
// Плюс сам сигнал `elapsed` виден тестбенчу иерархическим доступом: у цели `sv`
// длительность - `logic [31:0]` в миллисекундах.
//
// Форма `if`, а не тернарник: `late := (...) ? 1 : 0;` даёт в цели `rust`
// некомпилируемый код - дефект, чужой этой фикстуре.
model Timers {
    var pause: duration := 1s;
    var elapsed: duration := 0s;

    out late: bit at 0;
    out exact: bit at 1;
    out over: bit at 2;

    start Counting {
        always {
            elapsed := pause + 750ms;   // 1750 мс
            if (elapsed > 500ms) { late := 1; } else { late := 0; }
            if (elapsed = 1750ms) { exact := 1; } else { exact := 0; }
            if (elapsed > 1800ms) { over := 1; } else { over := 0; }
        }
    }
}

start Main = Timers;
