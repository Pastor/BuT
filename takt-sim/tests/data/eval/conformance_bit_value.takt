// Сверка разряда в позиции числового значения.
//
// `direct := src.3;` при `direct: u8` - эталон исполняет: разряд даёт 0 либо 1.
// Печатники целей отдают разряд булевым выражением (маска и сравнение), что
// верно в условии и невалидно в присваивании числу: `rustc` отвечал `E0308`,
// `iec2c` - "Incompatible data types for ':=' operation", verilator -
// `WIDTHEXPAND`, и всё это при нулевом коде возврата `taktc`.
//
// `flag` - контрольный вход: тот же разряд в битовую переменную. Он работал
// всегда, и без него "стороны сошлись" значило бы лишь, что они одинаково
// исполняют исправленное.
var src: u8 := 200;

var high: u8 := 0;
var low: u8 := 0;
var flag: bit := 0;

out o_high: u8 at 0;
out o_low: u8 at 1;
out o_flag: bit at 2;

start Run {
    always {
        high := src.7;
        low := src.0;
        flag := src.3;
        o_high := high;
        o_low := low;
        o_flag := flag;
    }
    ref Run: high = 1;
}
