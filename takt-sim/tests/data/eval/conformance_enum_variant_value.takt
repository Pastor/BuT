// Сверка: целая переменная сравнивается с именем варианта.
//
// Подмена значения варианта даёт валидный вывод и другой автомат - переход
// случится не на том такте. Видно это только трассой.
enum Op {
    Nop = 0,
    Step = 1,
    Hlt = 3
}

var op: u8 := 0;

out probe: u8 at 0x100;

start Run {
    always {
        op := op + 1;
        probe := op;
    }
    ref Halted: op = Hlt;
}

state Halted {
    always {
        probe := 9;
    }
    ref Halted;
}
