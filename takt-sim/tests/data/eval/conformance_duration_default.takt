// Фикстура сверки 0354: `duration` без инициализатора.
//
// Значение берётся из умолчания, а тело накапливающее: на постоянном значении
// "умолчание - ноль наносекунд" и "умолчание - целочисленный ноль" неразличимы
// у целей, а эталон на второй форме отказывал в такте (`SIM-005`).
//
// Имя `tick_len`, а не `step`: `step` зарезервировано в IEC 61131-3 и
// отказ цели `st` пришёл бы раньше предмета (правило 30, одна причина за раз).
var d: duration;
var tick_len: duration := 1s;
out late: bit at 0x100;
out ms: u32 at 0x104;

start Run {
    always {
        d := d + tick_len;
        late := d > 2s;
        ms := d as u32;
    }
    ref Done: d > 4s;
}

state Done {
}
