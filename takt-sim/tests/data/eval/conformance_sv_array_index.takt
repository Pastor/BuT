// Сверка распакованного массива цели `sv`: сброс и переменный индекс
// (фича 0365).
//
// Массив объявлен без инициализатора: в ветви сброса цель печатала `'0`, а
// verilator отвечает ошибкой "CONST is not an unpacked array". Порт `spare`
// читает элемент, который тело не трогает, - при неверном сбросе он не будет
// нулём (в RTL - X, и трасса разойдётся).
//
// Индекс `idx` объявлен `u8`, а массив адресуется двумя разрядами: без
// сужения verilator отвечает `WIDTHTRUNC`, а гейт цели считает предупреждение
// ошибкой.
//
// Тело накапливающее и пишет по переменному индексу: на идемпотентном теле
// пропуск и двойное исполнение неразличимы.
var slots: [u8; 4];
var idx: u8 := 0;
var acc: u8 := 0;
var i: u8 := 0;

out probe: u8 at 0;
out picked: u8 at 1;
out spare: u8 at 2;

start Run {
    always {
        slots[idx] := idx + 1;
        acc := acc + slots[idx];
        picked := slots[idx];
        probe := acc;
        spare := slots[3];
        idx := idx + 1;
        i := i + 1;
    }
    ref Run: i < 100;
}
