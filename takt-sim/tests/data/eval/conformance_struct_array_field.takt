// Массив как поле структуры.
//
// Элементы различны и меняются по тактам: перепутанный порядок в упакованной
// конкатенации (цель `sv`) или потерянный инициализатор (цель `st`) дают
// другую трассу, а инструменты обеих целей вывод при этом принимают.
struct Buf { data: [u8; 3], n: u8 }

var b: Buf := {{1, 2, 3}, 0};
out probe: u8 at 0x100;
out first: u8 at 0x104;
out last: u8 at 0x108;

start Run {
    always {
        b.data[0] := b.data[0] + 1;
        b.n := b.n + b.data[0];
        probe := b.n;
        first := b.data[0];
        last := b.data[2];
    }
    ref Run;
}
