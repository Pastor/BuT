// Двунаправленный порт: чтение и запись одного адреса.
//
// Значение меняется каждый такт и зависит от прочитанного: перепутанный
// перечислитель (чтение из выходного слота или наоборот) даёт другую трассу.
inout line: u8 at 0x200;
var v: u8 := 0;
var e: u8 := 0;

start Run {
    always {
        e := e + 1;
        v := line + e;
        line := v;
    }
    ref Run;
}
