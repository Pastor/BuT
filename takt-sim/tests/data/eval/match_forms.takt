// Пять форм `match` в одной модели.
//
// Каждая форма выбирает свою ветвь и даёт своё приращение; сумма наблюдаема
// через порт `beat`. Расхождение цели с эталоном видно по значению, а не по
// форме вывода: у `c` это `switch`, у `rust` - цепочка сравнений, у
// `sv` - `case` с обязательным `default`, у `st` - цепочка `IF`.
//
// Приращения разные (1, 2, 4, 8, 16): при одинаковых потеря ветви сошлась
// бы в сумме. Значение 31 достижимо единственным набором выборов.
model Probe {
    enum Phase {
        Low,
        High
    }

    var phase: Phase := Low;
    var sel: u8 := 0;
    // Разбирается вторым образцом многообразцовой ветви: при `sel` (то есть
    // первом) потеря второго образца осталась бы незаметной - мутация "печатать
    // только первый" проходила бы молча.
    var alt: u8 := 1;
    var k: u8 := 0;
    out beat: u8;

    start Go {
        always {
            // 1. Ветвь `_` при несовпадении образца: +1.
            match sel {
                9 => { k := k + 100; }
                _ => { k := k + 1; }
            }
            // 2. Без ветви `_`: совпадает первый образец, +2.
            match sel {
                0 => { k := k + 2; }
                1 => { k := k + 100; }
            }
            // 3. Несколько образцов в ветви: срабатывает второй, +4.
            match alt {
                0, 1 => { k := k + 4; }
                _ => { k := k + 100; }
            }
            // 4. Образцы - варианты перечисления: +8.
            match phase {
                Low => { k := k + 8; }
                _ => { k := k + 100; }
            }
            // 5. Вложенный `match`: +16.
            match sel {
                0 => {
                    match phase {
                        Low => { k := k + 16; }
                        _ => { k := k + 100; }
                    }
                }
                _ => { k := k + 100; }
            }
            beat := k;
        }
        next Done;
    }
    state Done;
}

start Main = Probe;
