// Сверка порядка функций.
//
// `quad` вызывает `twice`, а печатались они по алфавиту - `Loops_quad` первой.
// В IEC 61131-3 опережающих ссылок нет, и `iec2c` отвечал "';' missing at the
// end of statement" при нулевом коде возврата `taktc`; сообщение причины не
// называло.
//
// Имена выбраны так, что алфавит противоречит порядку вызова: `quad` <
// `twice`. Иначе тест проходил бы и без правки.
fn twice(v: u8) -> u8 { var r: u8 := 0; r := v + v; return r; }
fn quad(v: u8) -> u8 { var r: u8 := 0; r := twice(twice(v)); return r; }

var value: u8 := 0;
out o: u8 at 0;

start Run {
    always {
        value := quad(3);
        o := value;
    }
    ref Run: value = 12;
}
