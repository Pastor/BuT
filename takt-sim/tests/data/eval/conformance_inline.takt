// Фикстура потактовой сверки подстановки тела функции.
//
// Держит всё, чем подстановка может разойтись с вызовом:
//   * `[inline]` с локальной переменной в теле - её имя обязано быть
//     переименовано, иначе подстановка читает переменную места вызова;
//   * параметр `v`, одноимённый переменной модели: без переименования
//     подставленное тело считает по чужому значению;
//   * `[noinline]` рядом - вызов обязан остаться вызовом;
//   * два вызова одной функции в одном операторе - имена подстановок обязаны
//     быть разными;
//   * накапливающее тело (`n := n + 1`): на идемпотентном пропуск и двойное
//     исполнение неразличимы.
model Worker {
    var n: u8 := 0;
    var v: u8 := 5;
    out probe: u8;

    [inline] fn twice(v: u8) -> u8 {
        var half: u8 := v + 1;
        return half * 2;
    }

    [noinline] fn keep(v: u8) -> u8 {
        return v + 3;
    }

    start Run {
        always {
            n := n + 1;
            v := v + 2;
            probe := twice(n) + twice(v) + keep(v);
        }
        ref Run: n < 20;
    }
}

start Main = Worker;
