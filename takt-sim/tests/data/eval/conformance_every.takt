// Фикстура сверки периодического блока `every`. Профиль "часы"
// (нет объявления `clock`): период 3 мс через модельное время, тестбенч ведёт
// его 1 мс/такт. Наблюдение - выходной порт `led` (счётчик срабатываний).
//
// Счётчик держим во внутренней `var count` (out-порт в C не читается -
// `read_numeric` для него не эмитится), а в порт `led` только пишем. Переход
// `after 100ms` держит состояние резидентным на окне теста, но не срабатывает -
// иначе state без переходов терминален и уходит в END.
model Blinker {
    var count: u8 := 0;
    out led: u8 at 0;

    start Running {
        every 3ms {
            count := count + 1;
            led := count;
        }
        ref Done: after 100ms;
    }

    state Done {
        enter { led := 0; }
    }
}

start Main = Blinker;
