// Библиотека фичи 0469: имя модели совпадает с именем файла.
//
// Полный импорт (`import "clash.takt";`) вносит контейнер файла под именем
// `Clash`, а внутри него объявлена модель с тем же именем. Путь до состояния
// получает два одинаковых сегмента подряд (`...:Clash:Clash:Work`), и до фичи
// 0469 карта возвращала на нём контейнер - у него состояния `Work` нет, и три
// цели отвечали "Состояние ... не найдено" на корректной программе.
model Clash {
    // Порт нужен сверке как наблюдаемое; он же включает признак "нужен HAL" -
    // второй слой дефекта жил именно в нём (вызов `tick(&mut *hal)` из
    // функции без параметра `hal`).
    out beat: u8;

    var h: u8 := 0;

    start Work {
        always {
            h := h + 1;
            beat := h;
        }
        ref Work: h < 3;
        next Done;
    }
    state Done;
}

start Root = Clash;
