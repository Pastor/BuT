// Фикстура сверки 0355: присваивание среза массива.
//
// Тело накапливающее: источник меняется каждый такт, и срез обязан следовать
// за ним - на постоянных данных "скопировали верный кусок" и "скопировали
// не тот" неразличимы.
//
// Границы взяты смещёнными (`src[1:3]`, а не `src[0:2]`): при нулевом начале
// "start + k" и "k" дают одно и то же, и ошибка в начале среза не видна.
var src: [u8; 4] := {1, 2, 3, 4};
var part: [u8; 2] := {0, 0};
var n: u8 := 0;
out lo: u8 at 0x100;
out hi: u8 at 0x104;

start Run {
    always {
        n := n + 1;
        src[1] := src[1] + n;
        src[2] := src[2] + 10;
        part := src[1:3];
        lo := part[0];
        hi := part[1];
    }
    ref Done: n >= 4;
}

state Done {
}
