// Фикстура сверки начального значения выходного порта (задача 05).
//
// Наблюдение - выходной порт `led`: он получает значение `:=` до первого такта
// (в симуляторе - при построении, в цели `c` - в `_init`), а затем пишется
// телом автомата. Счётчик держим во внутренней `var count`: выходной порт в
// цели `c` не читается - `read_numeric` для него не эмитится.
//
// Переход в `Done` останавливает запись: последние такты проверяют, что после
// прекращения записи значение порта не "сползает" ни у эталона, ни у цели.
model Blinker {
    var count: u8 := 0;
    out led: u8 at 0 := 7;

    start Running {
        always {
            count := count + 1;
            led := count + 10;
        }
        ref Done: count = 3;
    }

    state Done;
}

start Main = Blinker;
