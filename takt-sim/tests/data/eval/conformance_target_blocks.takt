// Блоки, адресованные не самой модели.
//
// Безымянная вставка принадлежит всем целям и эталону: её тело - обычные
// операторы Takt. Блок формул адресован внешнему анализатору и поведения не
// меняет: у эталона и у всех восьми целей он молчит.
model TargetBlocks {
    var level: u8 := 0;

    out o: u8;

    start Run {
        always {
            assembly {
                level := level + 2;
            }

            formula {
                holds(level)
            }

            o := level;
        }

        ref Run: level < 200;
    }
}

start Main = TargetBlocks;
