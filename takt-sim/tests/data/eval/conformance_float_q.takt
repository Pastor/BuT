// Сверка прозрачного `float` -> q(8,8) с целью sv.
//
// Структурно идентична `conformance_fixed.takt`, но типы - `float`. Под флагом
// `--float-as-q=8.8` каждый `float` понижается в q(8,8), и трасса `acc`
// (представление) обязана совпасть с q-версией побитово:
//   S0: -1.5 * 2.0   = -3.0   (repr -768)   - умножение отрицательных;
//   S1: acc / 2.0    = -1.5   (repr -384)   - деление;
//   S2: -1.5 * tiny  = -2·2⁻⁸ (repr   -2)   - floor к -∞ (trunc дал бы -1!);
//   S3: acc + 2.0    =         (repr  510)  - сложение.
//
// Тела - только на переменных (как `regulator`): литерал `float` в теле не
// понижается (паритет с q 0061), а в инициализаторе - понижается глобальной
// точностью. Обёрнута под-моделью (`start Entry = FloatFixed`).
model FloatFixed {
    var x: float := -1.5;
    var two: float := 2.0;
    var tiny: float := 0.00390625;
    var acc: float := 0.0;

    start S0 { always { acc := x * two; } ref S1; }
    state S1 { always { acc := acc / two; } ref S2; }
    state S2 { always { acc := x * tiny; } ref S3; }
    state S3 { always { acc := acc + two; } }
}
start Entry = FloatFixed;
