// Шесть форм цикла в одной модели.
//
// Каждая форма даёт своё приращение, и все они наблюдаемы через порт `beat`:
// расхождение цели с эталоном видно по значению, а не по форме вывода.
//
// Формы подобраны так, чтобы приращения были разными (3, 3, 3, 4, 3): при
// одинаковых потеря целого цикла осталась бы незаметной - сумма сошлась бы.
model Probe {
    var k: u8 := 0;
    var i: u8 := 0;
    out beat: u8;

    start Go {
        always {
            // 1. `for` со статическими границами: +3.
            for var n: u8 := 0; n < 3; n := n + 1 {
                k := k + 1;
            }
            // 2. `for` без инициализатора: +3 (счётчик - переменная модели).
            for ; i < 3; i := i + 1 {
                k := k + 1;
            }
            // 3. `while`: +3 - до границы 9.
            while k < 9 {
                k := k + 1;
            }
            // 4. Вложенные циклы: +4.
            for var a: u8 := 0; a < 2; a := a + 1 {
                for var b: u8 := 0; b < 2; b := b + 1 {
                    k := k + 1;
                }
            }
            // 5. `continue`: из четырёх итераций считают три (+3).
            for var c: u8 := 0; c < 4; c := c + 1 {
                if c = 1 {
                    continue;
                }
                k := k + 1;
            }
            // 6. Бесконечный `loop` с выходом по `break`: +1.
            loop {
                k := k + 1;
                break;
            }
            beat := k;
        }
        next Done;
    }
    state Done;
}

start Main = Probe;
