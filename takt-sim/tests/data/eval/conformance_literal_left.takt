// Фикстура сверки: арифметика с литералом слева.
//
// Цель `rust` печатает обёрточную арифметику методом (`wrapping_add`), и
// литерал в позиции получателя требует типа: вывод типа в Rust сквозь вызов
// метода не проходит. Наблюдаемые порты меняются каждый такт, поэтому потеря
// или подмена операнда видна трассой.
model M {
    var n: u8 := 0;
    out sum: u8;
    out diff: u8;
    out prod: u8;

    start Go {
        always {
            n := n + 1;
            sum := 10 + n;
            diff := 200 - n;
            prod := 3 * n;
        }
        ref Go: n > 0;
    }
}

start Main = M;
