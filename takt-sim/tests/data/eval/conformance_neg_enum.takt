/// Фикстура: отрицательное перечисление в цели `c`.
///
/// Без общего факта `get_c_type` смотрит только на `max` и всегда беззнаков:
/// `enum Level { Low = -5 }` давал `uint8_t lv;`, `model->lv = -5` заворачивался
/// в `251`, условие `if (model->lv == -5)` было тождественно ложно, переход
/// `ref Done: lv = Low` не срабатывал никогда - автомат стоял на `Run`.
/// Симулятор и три другие цели (`st`/`rust`/`sv`) дают `-5` и переход исполняют.
///
/// Наблюдается: `lv` (эталон −5; беззнаковый тип дал бы 251) и `reached` (1 - переход
/// сработал, иначе 0). Мутация "вернуть расчёт по max" валит сверку по обоим.
///
/// Обёрнута в `model` с корневым `start` - как `conformance_u8.takt`: харнесс
/// читает поля через `m.entry.<имя>`.
enum Level {
    Low = -5,
    Mid = 0,
    High = 5
}

model NegEnum {
    var lv: Level := Mid;
    var reached: u8 := 0;

    start Run {
        enter { lv := Low; }
        ref Done: lv = Low;
    }
    state Done {
        enter { reached := 1; }
    }
}

start Entry = NegEnum;
