/// Арифметика в теле блока.
///
/// До фичи 0025 `c := a + 1` молча пропускалось: runtime-вычислитель не знал
/// `Add`, а `None` приводил к пропуску присваивания без диагностики.
/// Ожидается: a=5, b=5, c=6 (было c=0).
var a: u8 := 0;
var b: u8 := 0;
var c: u8 := 0;

start Idle {
    always {
        a := 5;
        b := a;
        c := a + 1;
    }
}
