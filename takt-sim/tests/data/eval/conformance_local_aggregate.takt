// Сверка агрегата в локальном объявлении тела.
//
// `var p: Point := {0, 0};` внутри функции: цель `st` отвечала `ST-011`
// ("агрегат в позиции значения"), цель `sv` - `SV-002` ("инициализатор
// структуры"), тогда как эталон, `c` и `rust` вход исполняли. То есть отказ
// приходил на запись, у которой есть верное поведение.
//
// `plain` - контрольная функция без агрегата: она работала всегда.
struct Point { x: u8, y: u8 }

fn origin(k: u8) -> u8 {
    var p: Point := {0, 0};
    p.x := k;
    p.y := 2;
    return p.x + p.y;
}

fn plain(k: u8) -> u8 {
    var acc: u8 := 1;
    acc := acc + k;
    return acc;
}

var sum: u8 := 0;
var ctl: u8 := 0;

out o_sum: u8 at 0;
out o_ctl: u8 at 1;

start Run {
    always {
        sum := origin(5);
        ctl := plain(2);
        o_sum := sum;
        o_ctl := ctl;
    }
    ref Run: sum = 7;
}
