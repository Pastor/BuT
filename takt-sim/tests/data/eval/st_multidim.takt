// Фикстура потактовой сверки многомерного массива.
//
// В IEC 61131-3 массивы не вкладываются: цель `st` объявляет `[[u8; 2]; 2]`
// многомерной формой `ARRAY [0..1, 0..1] OF USINT`, а индексацию печатала
// формой C (`grid[1][0]`) - `iec2c` такой вывод отвергает ("Number of
// subscripts/indexes does not match"). Значит фикстура обязана проверять не
// только компилируемость, но и значения: у многомерного массива перестановка
// индексов даёт валидный вывод с другим поведением.
//
// Значения по индексам разные и меняются по тактам: на симметричной матрице
// (или на постоянном теле) перестановка `[0][1]` ↔ `[1][0]` неразличима.
// Тело накапливающее - на идемпотентном лишний либо пропущенный такт
// невидим (урок фикса 0181-01).
model Grid {
    out lamp: u8 at 0x600;

    var cells: [[u8; 2]; 2] := {{1, 2}, {3, 4}};
    var n: u8 := 0;
    var got: u8 := 0;
    var other: u8 := 0;

    start Run {
        always {
            n := n + 1;
            // Растёт только один элемент: 2 -> 12 -> 22 -> 32.
            cells[0][1] := cells[0][1] + 10;
            got := cells[0][1];
            // Сосед по "переставленному" индексу стоит на месте (3) - именно
            // он отличает верную индексацию от зеркальной.
            other := cells[1][0];
            lamp := got;
        }
        ref Done: n >= 3;
    }

    state Done;
}

start Main = Grid;
