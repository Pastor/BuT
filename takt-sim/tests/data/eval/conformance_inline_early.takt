// Фикстура потактовой сверки подстановки тела с ранним возвратом.
//
// Держит все формы, которыми признак выхода может разойтись с вызовом:
//   * ранний выход из `if` и хвостовой возврат после него;
//   * три возврата, из них два ранних (цепочка порогов);
//   * ветвление, где возвращают обе ветви (`if/else`) - признак тогда не нужен
//     вовсе, и подстановка не должна его заводить;
//   * локальная переменная тела и параметр, одноимённый переменной модели;
//   * ранний выход из цикла: подстановка гасит тело признаком, а
//     завершает цикл его собственный счётчик; хвостовой возврат после цикла
//     обязан сработать только тогда, когда выхода не было;
//   * накапливающее тело: на идемпотентном пропуск и двойное исполнение
//     неразличимы.
model Worker {
    var n: u8 := 0;
    var v: u8 := 1;
    out probe: u8;

    [inline] fn grade(v: u8) -> u8 {
        var doubled: u8 := v * 2;
        if doubled > 12 {
            return 90;
        }
        if doubled > 6 {
            return 50;
        }
        return doubled;
    }

    [inline] fn parity(v: u8) -> u8 {
        if v > 5 {
            return 2;
        } else {
            return 3;
        }
    }

    // Первый индекс, на котором порог превышен: возврат стоит внутри цикла, а
    // после цикла - хвостовой возврат "не нашли". Трасса проходит через оба.
    [inline] fn first_over(v: u8) -> u8 {
        for var i: u8 := 1; i < 5; i := i + 1 {
            if i * 3 > v {
                return i * 10;
            }
        }
        return 99;
    }

    start Run {
        always {
            n := n + 1;
            v := v + 1;
            probe := grade(n) + parity(v) + first_over(n);
        }
        ref Run: n < 20;
    }
}

start Main = Worker;
