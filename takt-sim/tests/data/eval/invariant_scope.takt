// Инвариант состояния действует только в своём состоянии.
//
// `OnlyHere` объявлен в `Go`, где `k` не превышает 2. В `Done` величина растёт
// до 7 - и это не нарушение: обязательство говорит о прогонах состояния, в
// котором объявлено (правило 0044/0051).
//
// Стой проверка в общем теле такта, прошивка упала бы на третьем шаге, а
// эталон продолжил бы счёт: расхождение молчаливое - вывод целей валиден,
// поведение разное. Отличает исходы только трасса.
model Probe {
    var k: u8 := 0;
    out beat: u8;

    start Go {
        invariant OnlyHere = k < 3;

        always {
            k := k + 1;
            beat := k;
        }
        ref Go: k < 2;
        next Done;
    }

    state Done {
        always {
            k := k + 5;
            beat := k;
        }
    }
}

start Main = Probe;
