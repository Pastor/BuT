// Время в состоянии при самопереходе (решение заказчика).
//
// Замер 2026-08-22: самопереход сбрасывал у эталона отсчёт "времени с входа",
// а у целей - нет (там признак входа `state != prev_state`). Один вход давал
// другой автомат:
//   `every 3ms` - тело у эталона не срабатывало никогда, у целей срабатывало;
//   `after 3ms` - эталон в `Done` не уходил, цель `c` уходила на 4-м такте.
//
// Фикстура наблюдает оба следствия сразу: счётчик `every` и такт перехода по
// выдержке. Самопереход `ref Run: i < 4` срабатывает первые такты, потом
// уступает выдержке - так видно и "свободный отсчёт", и сам переход.
clock 1kHz;

var ticks: u8 := 0;
var i: u8 := 0;
var done: u8 := 0;

start Run {
    every 3ms { ticks := ticks + 1; }
    always { i := i + 1; }
    ref Done: after 5ms;
    ref Run: i < 100;
}

state Done {
    enter { done := 1; }
    ref Done;
}
