/// Фикстура потактовой сверки model-level `always` у модели-**композиции**
/// (фича 0194).
///
/// Контракт 0083 ("тело `always` вне состояния исполняется каждый такт до
/// диспетчеризации состояния") соблюдали все четыре цели, а эталон - только у
/// модели со своими состояниями. У модели, чьё состояние есть композиция, он не
/// исполнял тело вовсе: `build_impl` делегировал в `build_extend`, а поле
/// `executions` у `Parallel`/`Sequential` никогда не наполнялось.
///
/// Тело **накапливающее** (`n := n + 1`), и это не стиль: на идемпотентном
/// (`n := выражение`) ни пропуск, ни двойное исполнение неразличимы - именно
/// поэтому фикс 0181-01 (тело исполнялось дважды) дожил незамеченным.
///
/// Ожидаемая трасса `n`: 1 -> 2 -> 3 - по одному исполнению на такт. Пропуск дал
/// бы 0, 0, 0; двойное исполнение - 2, 4, 6.
model Tuner {
    start Count {
        ref Count;
    }
}

model Root2 {
    var n: u8 := 0;

    always { n := n + 1; }

    start Inner = Tuner | Tuner;
}

start Entry = Root2;
