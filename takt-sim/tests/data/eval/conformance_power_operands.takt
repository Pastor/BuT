// Степень во всех четырёх формах записи операндов.
//
// Значения меняются каждый такт: на постоянных перепутанные операнды и
// потерянное слагаемое неотличимы от верного вывода.
var b: u8 := 2;
var n: u32 := 1;
var k: u8 := 1;
var v: u8 := 0;
var e: u8 := 0;
out probe: u8 at 0x100;

start Run {
    always {
        // Формы: литеральная база; переменная база с литеральным показателем;
        // показатель типа u32 (приведение излишне); показатель типа u8
        // (приведение обязательно).
        v := (2 ** 2) + (b ** 2) + (b ** n) + (b ** k);
        b := b + 1;
        n := n + 1;
        k := k + 1;
        e := e + 1;
        probe := v;
    }
    ref Done: e = 3;
}

state Done {
}
