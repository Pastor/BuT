// Фикстура потактовой сверки остатка в сравнении.
//
// Цель `rust` печатает `x % k = 0` методом `is_multiple_of` - форма, которой
// требует `clippy` под флагами проверки самой цели. Замена обязана быть
// тождественной, поэтому фикстура держит:
//   * `= 0` и `!= 0` с ненулевым литералом, а также литерал слева (`0 = x % k`):
//     линтер видит все три записи одинаково, значит и правило обязано;
//   * остаток с переменным делителем - под правило он не подпадает (на нуле
//     `%` и `is_multiple_of` расходятся), и печататься обязан по-прежнему;
//   * знаковый операнд - у него метода в стабильном Rust нет вовсе;
//   * накапливающее тело: на идемпотентном пропуск и двойное исполнение
//     неразличимы.
model Worker {
    var n: u8 := 0;
    var d: u8 := 3;
    var s: i16 := -8;
    out probe: u8;

    start Run {
        always {
            n := n + 1;
            s := s + 3;
            var acc: u8 := 0;
            if n % 2 = 0 {
                acc := acc + 1;
            }
            if n % 3 != 0 {
                acc := acc + 2;
            }
            if n % d = 0 {
                acc := acc + 4;
            }
            if s % 2 = 0 {
                acc := acc + 8;
            }
            if 0 = n % 5 {
                acc := acc + 16;
            }
            probe := acc;
        }
        ref Run: n < 30;
    }
}

start Main = Worker;
