// Структура с агрегатным инициализатором - фикстура сверок фичи 0293.
//
// Наблюдаемая `sum` различает исход: у эталона она равна 5 (kp + ki), и такой
// же обязана быть у целей `st`, `rust` и `sv`. Прежде цель `st` молча теряла
// инициализатор (`g : Gains;` без `:=`) и считала с нулей, цель `sv` печатала
// ссылку на необъявленный тип, а `rust` отказывал `RS-011` на доступе к полю.
struct Gains {
    kp: u8,
    ki: u8
}

model Loop {
    var g: Gains := {2, 3};
    var sum: u8 := 0;
    var n: u8 := 0;
    out probe: u8 := 0;

    start Run {
        always {
            n := n + 1;
            sum := g.kp + g.ki;
            probe := sum;
        }
        ref Done: n = 3;
    }

    state Done;
}

start Main = Loop;
