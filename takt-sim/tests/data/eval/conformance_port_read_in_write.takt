// Сверка: значение выходного порта читает порт.
//
// Запись "эхо входа на выход" у цели `rust` давала `E0499 cannot borrow *hal
// as mutable more than once` при нулевом коде возврата `taktc`: методы
// HAL-трейта берут `&mut self`, и чтение внутри записи - два изменяемых
// заимствования разом. Значение поднимается во временную, и сверка требует,
// чтобы подъём не сдвинул ни одно значение: собраться вывод может и с неверной
// величиной.
//
// Порт `line` двунаправленный намеренно: значение, которое модель в него
// записала, читают обе стороны, и сценарий входов сверке не нужен.
//
// `o_plain` - контрольный выход: та же запись, но значение порта не читает.
// Без него совпадение сторон значило бы лишь, что они одинаково исполняют
// исправленное.
inout line: u8 at 0x200;

out o_sum: u8 at 0x14;

out o_bit: bit at 0x12:0;

out o_plain: u8 at 0x13;

var ticks: u8 := 0;

fn twice(k: u8) -> u8 {
    return k + k;
}

start Run {
    always {
        ticks := ticks + 1;
        line := ticks * 3;
        o_sum := twice(line) + ticks;
        o_bit := line > 5;
        o_plain := ticks;
    }

    ref Run: ticks < 3;
}
