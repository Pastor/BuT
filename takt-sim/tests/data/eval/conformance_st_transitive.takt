// Цепочка функций, читающих состояние.
//
// В IEC 61131-3 `FUNCTION` чистая, и цель `st` передаёт ей нужные переменные
// через `VAR_IN_OUT`. Список обязан быть транзитивным: `outer` зовёт `mid`,
// `mid` зовёт `hot`, а читает состояние только `hot`.
//
// Переменные разные по величине и читаются на разных уровнях цепочки:
// свяжись `VAR_IN_OUT` не с той, вывод остался бы валидным, а значение
// разошлось бы. Именно это и проверяется - компиляцию доказывает проверка цели.
model StTrans {
    out probe: u8;

    var ticks: u8 := 0;

    var gain: u8 := 3;

    fn hot() -> u8 {
        return ticks + 1;
    }

    fn mid(v: u8) -> u8 {
        return v + hot();
    }

    fn outer(k: u8) -> u8 {
        return mid(k) * gain;
    }

    start Run {
        always {
            ticks := ticks + 1;
            probe := outer(ticks);
        }

        ref Run: ticks < 200;
    }
}

start Main = StTrans;
