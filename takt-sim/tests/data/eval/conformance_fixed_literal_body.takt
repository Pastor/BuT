// Сверка понижения q-литерала в телах и условиях.
//
// Дробный литерал понижался в представление `q(m, n)` только в объявлении
// (`var gain: q(8, 8) := 1.5;` -> 384). В теле и в условии он доезжал до целей
// как написан, и цель `c` печатала `model->gain = 2.0;` - значение **2**
// вместо 512. Замер 2026-08-22 дал расхождение значений у эталона и цели, а на
// ребре - **другой автомат**: `gain > 1.0` при `gain = 0.5` сравнивало
// представление 128 с единицей и срабатывало, тогда как эталон переход не
// делает.
//
// Фикстура держит четыре позиции приёмника разом:
//   `set`   - присваивание литерала;
//   `arg`   - аргумент вызова (параметр `q(8, 8)`);
//   `loc`   - инициализатор локального объявления;
//   `guard` - сравнение в условии `if`.
// Ребро `ref` со сравнением проверяет пятую: условие перехода.
//
// Арифметики с литералом (`gain + 1.5`) здесь нет намеренно: её отвергает
// `SE-059` - неявное смешение `q` и `float`. Понижать литерал там значило бы
// ухудшить сообщение, назвав тип, которого автор не писал.
var gain: q(8, 8) := 0.5;
var n: u8 := 0;

out set_v: u8 at 0;
out arg_v: u8 at 1;
out loc_v: u8 at 2;
out guard_v: u8 at 3;

fn whole(v: q(8, 8)) -> u8 {
    return v as u8;
}

start Run {
    always {
        n := n + 1;
        gain := 2.5;
        set_v := gain as u8;
        arg_v := whole(3.0);
        var local_gain: q(8, 8) := 4.5;
        loc_v := local_gain as u8;
        guard_v := 0;
        if gain > 2.0 {
            guard_v := 1;
        }
    }
    // Ребро сравнивает с литералом: до фичи цель уходила в Done на первом же
    // такте, потому что сравнивала представление с единицей.
    ref Done: gain > 100.0;
    ref Run: n < 100;
}

state Done {
}
