// Сверка массива цели `sv` с эталоном.
//
// До фичи цель отвергала уже объявление: агрегатный инициализатор
// `{1, 2, 3}` печатался в ветвь сброса конкатенацией, которой у
// распакованного массива нет, - отказ `SV-002` при том, что тип массива цель
// печатать умела и раньше, а остальные семь потребителей вход исполняли.
//
// Тело накапливающее (`acc := acc + arr[1]`) и **пишет** в массив: на
// идемпотентном теле пропуск и двойное исполнение неразличимы,
// а без записи не проверялась бы индексная запись `arr[0] := ...`.
var arr: [u8; 3] := {1, 2, 3};
var acc: u8 := 0;
var i: u8 := 0;

out probe: u8 at 0;
out first: u8 at 1;

start Run {
    always {
        acc := acc + arr[1];
        arr[0] := acc;
        i := i + 1;
        probe := acc;
        first := arr[0];
    }
    ref Run: i < 100;
}
