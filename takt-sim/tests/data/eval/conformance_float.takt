/// Сверка симулятора с порождённым C по типу `float`.
///
/// С отображением `Rational` в `float` сверка по нему исключена: генератор C
/// отображал `float` в `float` (f32), тогда как симулятор считает в f64
/// (`eval::Value::Real`). Сверять с эталоном, заведомо расходящимся по
/// точности, - значит узаконить его дефект. Отображение сменено на
/// на `double`, и сужение снято.
///
/// Значения подобраны так, чтобы f32 и f64 расходились в печати: иначе тест
/// прошёл бы и на старом (дефектном) отображении, ничего не проверив.
///   sum   - 0.1 + 0.2: f64 даёт 0.30000000000000004, f32 - 0.30000001192092896
///   third - 1.0 / 3.0: f64 даёт 0.33333333333333331, f32 - 0.33333334326744080
/// Обе константы в двоичной дроби непредставимы точно, поэтому разрядность
/// мантиссы видна прямо в результате.
///
/// exact - контроль: 1.5 + 2.25 = 3.75 представимо точно в обеих разрядностях.
/// Если разойдётся и оно, дело не в точности, а в самой арифметике.
///
/// Модель обёрнута в `model` по образцу `conformance_u8.takt`: имена символов C
/// (`ConformanceFloat_*`) зависят от обёртки, и разворачивание сменило бы
/// ожидания сверки, ничего не проверив сверх.

model Conf {
    var sum: float := 0.0;
    var third: float := 0.0;
    var exact: float := 0.0;

    start Idle {
        always {
            sum := 0.1;
            sum := sum + 0.2;
            third := 1.0 / 3.0;
            exact := 1.5 + 2.25;
        }
    }
}

start Entry = Conf;
