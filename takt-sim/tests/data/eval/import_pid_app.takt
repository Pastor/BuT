// Применение сверки импорта: подключает модель и объявления связи,
// замыкает их своей моделью. Наблюдаемое - порт `lvl`: он показывает, что обе
// модели пишут в одну переменную, а не в свои копии.
import { Pid, ctrl, meas } from "import_pid_lib.takt";

model Plant {
    out lvl: u8 at 0;
    start Run {
        always {
            meas := meas + ctrl;
            lvl := meas;
        }
        ref Run: true;
    }
}

start ImportPidApp = Pid | Plant;
