// Сверка именованного условия в теле блока.
//
// До фичи один вход давал три ответа: эталон - `SIM-014` в такте, цель `c` -
// макрос `COND_...`, которого нигде не определяла (порождённый C не собирался
// при нулевом коде возврата), `st`/`rust`/`sv` - честный отказ.
//
// Условие меняется по тактам: постоянно истинное или ложное не показало бы
// подмены условия его отрицанием.
var i: u8 := 0;
var v: u8 := 0;

cond warm = i > 2;

out probe: u8 at 0;
out step: u8 at 1;

start Run {
    always {
        i := i + 1;
        if warm {
            v := 1;
        } else {
            v := 0;
        }
        probe := v;
        step := i;
    }
    ref Run: i < 100;
}
