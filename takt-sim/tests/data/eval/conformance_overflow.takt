/// Фикстура сверки семантики переполнения беззнакового целого.
///
/// Правило языка: переполнение
/// беззнакового целого - **обёртка mod 2^N**. Это определённое поведение C, и
/// эталон-симулятор его воспроизводит усечением по объявленному типу при записи.
///
/// Трасса `t` начинается с 253, поэтому обёртка случается **внутри** прогона, а
/// не на границе: 254 -> 255 -> 0 -> 1 -> 2 -> 3. Ловушка, ради которой фикстура
/// заведена: цель `rust` печатала `n += 1` и на 255 + 1 **паниковала**
/// (`attempt to add with overflow`) там, где симулятор, C и SV считали дальше.
///
/// Обёрнута в `start Entry = Wrap;` (глубина 2, доступ `m.entry.t`) - как
/// `conformance_ticks.takt`, ради того же способа доступа к полю в C-харнессе.
model Wrap {
    var t: u8 := 253;

    start Counting {
        always { t := t + 1; }   // на 255 обязана дать 0, а не отказ
        ref Done: t = 3;         // достижимо только ПОСЛЕ обёртки
    }

    state Done {}
}

start Entry = Wrap;
