// Фикстура сверки 0358: индексация поля структуры.
//
// Прежде `b.data[1]` не разбирался вовсе (`SY-002`), тогда как `ps[1].x`
// работал. Здесь обе цепочки идут рядом - и в чтении, и в записи.
//
// Тело накапливающее и берёт разные элементы: на одном элементе ошибка в
// индексе неотличима, а на постоянном значении - ошибка в базе.
struct Cell {
    v: u8
}

struct Buf {
    data: [u8; 2],
    n: u8
}

var b: Buf := {{7, 9}, 3};
var cells: [Cell; 2] := {{1}, {2}};
out lo: u8 at 0x100;
var n: u8 := 0;
out hi: u8 at 0x104;

start Run {
    always {
        n := n + 1;
        b.data[0] := b.data[0] + 1;
        b.data[1] := b.data[1] + 2;
        lo := b.data[0];
        hi := b.data[1] + cells[1].v;
    }
    ref Done: n >= 4;
}

state Done {
}
