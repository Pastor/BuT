// Сверка 0507: беззнаковое накопление с расширением переполняется на третьем
// такте. Эталон переносит, и порождённый Rust обязан делать то
// же: отладочная сборка на `+` здесь паникует, на `wrapping_add` - считает.
var total: u16 := 65000;
var step: u8 := 200;

out probe: u16 at 0x100;

start Run {
    always {
        total := total + step;
        probe := total;
    }
    ref Run;
}
