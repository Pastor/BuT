// Фикстура сверки: значения умолчаний структуры и q(m, n).
//
// Ни одно объявление здесь не несёт инициализатора там, где предмет сверки, -
// значение поля берётся из умолчания цели. Тело накапливающее: на постоянном
// значении "умолчание ноль" и "значение не пишется вовсе" неразличимы.
//
// Порог `mark` подобран так, чтобы `grew` переключался на третьем такте: иное
// умолчание `f` сдвинуло бы переключение, то есть трасса чувствительна к
// самому предмету, а не только к факту компиляции.
struct Bb {
    m: u8
}

struct Aa {
    b: Bb,
    n: u8
}

var v: Aa;
var f: q(4, 4);
var step: q(4, 4) := 1.0 as q(4, 4);
var mark: q(4, 4) := 2.0 as q(4, 4);
out acc: u8 at 0x100;
out grew: bit at 0x104;

start Run {
    always {
        v.n := v.n + 1;
        v.b.m := v.b.m + 2;
        f := f + step;
        acc := v.n + v.b.m;
        grew := f > mark;
    }
    ref Done: v.n >= 4;
}

state Done {
}
