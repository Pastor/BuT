/// Эталонная Q-арифметика симулятора через полный путь
/// (инициализация литерала -> арифметика в теле блока -> наблюдение значения).
///
/// Ожидается (представления q(8, 8)):
///   sum    = a + c            = 1.5 + 0.5 = 2.0  -> 512
///   prod   = neg * two        = −1.5 · 2.0 = −3.0 -> −768  (floor к −∞, T9)
///   scaled = a + (b as q)     = 1.5 + 3.0 = 4.5  -> 1152  (каст масштабирует)
///   wrap   = big + big        = переполнение    -> wraparound (T19)
var a: q(8, 8) := 1.5;
var c: q(8, 8) := 0.5;
var neg: q(8, 8) := -1.5;
var two: q(8, 8) := 2.0;
var big: q(8, 8) := 100.0;
var b: u8 := 3;

var sum: q(8, 8) := 0.0;
var prod: q(8, 8) := 0.0;
var scaled: q(8, 8) := 0.0;
var wrap: q(8, 8) := 0.0;

start Idle {
    always {
        sum := a + c;
        prod := neg * two;
        scaled := a + (b as q(8, 8));
        wrap := big + big;
    }
}
