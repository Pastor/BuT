// Применение: вариант импортированного перечисления в образце `match`.
//
// Наблюдаемое - `seen`: по варианту `Lda` эталон обязан выбрать первую ветвь
// (1), по `Hlt` - вторую (2). Значение, а не "прогон не упал": вариант,
// разрешённый не в тот номер, прогон переживает.
import {Op} from "import_enum_lib.takt";

var v: Op := Lda;
var seen: u8 := 0;

start Run {
    always {
        match v {
            Lda => { seen := 1; v := Hlt; }
            Hlt => { seen := 2; }
        }
    }
    ref Run;
}
