// Сверка Q-арифметики fixed-point с целями.
//
// Трасса `acc` (представление q(8,8)) подобрана так, чтобы поймать:
//   S0: -1.5 * 2.0   = -3.0   (repr -768)   - умножение отрицательных;
//   S1: acc / 2.0    = -1.5   (repr -384)   - деление;
//   S2: -1.5 * tiny  = -2·2⁻⁸ (repr   -2)   - floor к -∞ (усечение дало бы -1);
//   S3: acc + 2.0    =         (repr  510)  - сложение.
//
// tiny = 0.00390625 = 2⁻⁸, представление 1: -384·1 >> 8 = floor(-1.5) = -2.
// Обёрнута под-моделью (`start Entry = Fixed`) - поле `entry` в структуре цели C.
model Fixed {
    var x: q(8, 8) := -1.5;
    var two: q(8, 8) := 2.0;
    var tiny: q(8, 8) := 0.00390625;
    var acc: q(8, 8) := 0.0;

    start S0 { always { acc := x * two; } ref S1; }
    state S1 { always { acc := acc / two; } ref S2; }
    state S2 { always { acc := x * tiny; } ref S3; }
    state S3 { always { acc := acc + two; } }
}
start Entry = Fixed;
