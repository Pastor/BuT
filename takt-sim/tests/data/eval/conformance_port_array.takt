// Порт-массив: эталон против цели `c`.
//
// Значения элементов различны и меняются по тактам: на постоянных
// перепутанные листы ("bus_0 <- src[1]") неотличимы от верного вывода.
var a: u8 := 7;
var b: u8 := 9;
var e: u8 := 0;
out bus: [u8; 2] at 0x200;
out probe: u8 at 0x100;

start Run {
    always {
        e := e + 1;
        a := a + 1;
        b := b + 2;
        bus := {a, b};
        probe := e;
    }
    ref Run;
}
