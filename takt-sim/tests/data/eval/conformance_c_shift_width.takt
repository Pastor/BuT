// Сдвиг на величину, не меньшую ширины продвинутого типа C.
//
// Величины подобраны так, что ошибка в правиле видна значением: беззнаковый
// обязан дать 0, знаковый - −1 (остался только знак), а контрольный сдвиг в
// пределах продвинутого типа (u8 >> 8) обязан считаться как прежде.
//
// Сдвига на 64 здесь нет намеренно: эталон отвечает на него SIM-002 и
// останавливает прогон - у записи нет верного значения вовсе (разделение
// обязанностей), и сверять её не с чем.
var w: u32 := 200;
var s: i32 := -8;
var narrow: u8 := 200;

var o_unsigned: u32 := 111;
var o_signed: i32 := 111;
var o_narrow: u8 := 111;

start Run {
    always {
        o_unsigned := w >> 32;
        o_signed := s >> 32;
        o_narrow := narrow >> 8;
    }
    ref Run;
}
