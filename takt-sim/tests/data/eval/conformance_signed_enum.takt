// Перечисление с отрицательным значением варианта.
//
// Значение варианта попадает в вывод буквально: у цели `sv` отрицательное
// требует знаковой формы литерала. Трасса меняется по тактам - на постоянной
// подмена варианта неотличима от верного вывода.
enum Level { Low = -5, Mid = 0, High = 7 }

var l: Level := Low;
var s: i8 := 0;
out probe: i8 at 0x100;

start Run {
    always {
        match l {
            Low => { s := s - 1; l := Mid; }
            Mid => { s := s + 3; l := High; }
            _ => { s := s + 10; }
        }
        probe := s;
    }
    ref Run;
}
