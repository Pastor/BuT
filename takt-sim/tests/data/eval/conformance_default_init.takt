// Фикстура сверки 0353: переменные без инициализатора.
//
// Значение каждой берётся из умолчания цели, а тело накапливающее: на
// постоянном значении "умолчание ноль" и "поле не пишется вовсе" неразличимы,
// а мусор стека, с которого начиналась цель `c`, тем более.
//
// Формы взяты разные намеренно: скаляр, элемент массива и поле структуры -
// в C они печатаются тремя разными способами (присваивание, по элементам, по
// полям), и общая ветвь покрыла бы лишь первую.
struct Pair {
    x: u8,
    y: u8
}

var n: u8;
var arr: [u8; 3];
var p: Pair;
out acc: u8 at 0x100;

start Run {
    always {
        n := n + 1;
        arr[1] := arr[1] + 2;
        p.y := p.y + 3;
        acc := n + arr[1] + p.y;
    }
    ref Done: n >= 4;
}

state Done {
}
