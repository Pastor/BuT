// Фикстура сверки значений типа `duration`: арифметика, сравнение и
// приведение к числу обязаны давать одно и то же у эталона и у порождённого кода.
//
// Проверяются не такты срабатывания, а сами значения: представление эталона -
// наносекунды, представление целей - миллисекунды, и это ровно та
// граница, на которой ошибка была бы молчаливой.
//
// Выход `ms` несёт число миллисекунд `elapsed` - так значение видно и симулятору
// (через переменную), и харнессу цели (через порт).
model Timers {
    // Имя `elapsed`, а не `left`: `left` - стандартная функция IEC, и
    // цель `st` его отвергает (`ST-014`; ловушка описана в живом контексте).
    var pause: duration := 1s;
    var elapsed: duration := 0s;

    out ms: u32 at 0;
    out late: bit at 0;

    start Counting {
        always {
            elapsed := pause + 750ms;   // 1750 мс
            ms := elapsed as u32;       // приведение бесплатно: единица та же
            // Форма `if`, а не тернарник: `late := (...) ? 1 : 0;` даёт в цели
            // `rust` некомпилируемый код (фикс 0148-03) - дефект чужой этой
            // фиче, и обходить его здесь честнее, чем блокировать сверку.
            if (elapsed > 500ms) { late := 1; } else { late := 0; }
        }
        ref Counting: false;
    }
}

start Main = Timers;
