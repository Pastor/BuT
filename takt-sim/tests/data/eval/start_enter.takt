/// Enter стартового состояния.
///
/// До фичи 0025 enter вызывался только в ветке перехода, поэтому стартовое
/// состояние в него никогда не "входило": e оставалось 0.
/// Ожидается: e=7, ровно один раз (n не растёт).
var e: u8 := 0;
var n: u8 := 0;
var t: u8 := 0;

start Idle {
    enter {
        e := 7;
        n := n + 1;
    }
    always { t := t + 1; }
    ref Hot: t > 100;
}

state Hot {
}
