// Сверка приведения литерала к q(m, n) в теле.
//
// Значение `2.5 as q(8, 8)` известно при компиляции - его считает
// `const_eval::fixed_repr` (0317), но зовётся тот только из свёртки
// инициализаторов. В теле приведение доезжало до целей как написано, и замер
// 2026-08-22 дал пять отказов на записи, которую эталон исполняет:
//
//   c, c-hal   `(int16_t)floor((2.5) * 256.0)` - вызов libm В рантайме ради
//              константы (класс, названный 0317 и починенный ею только в
//              инициализаторах);
//   st, st-at  ST-011 "приведение в q: тип источника не выводится статически"
//              - при том что источник есть литерал;
//   rust       RS-011 "нужен floor, которого нет в no_std без libm
//              (литеральный float понижается на этапе компиляции)" - текст
//              обещал ровно то, чего в теле не делал никто;
//   sv, sv-mmio SV-002 "вещественный литерал".
//
// Фикстура держит три формы разом:
//   `set_v`  - присваивание приведения (`gain := 2.5 as q(8, 8);`);
//   `mul_v`  - приведение внутри арифметики (`gain * (2.0 as q(8, 8))`) - та
//              самая запись, которой автор снимает SE-059;
//   `neg_v`  - отрицательный литерал (`-1.5 as q(8, 8)`): у него другая ветвь
//              печати (в SV размерный литерал беззнаков, в носителе - floor
//              к −∞, а не усечение).
//
// Значения меняются по тактам: постоянное не отличит верное представление
// от "случайно совпавшего" - та же причина, по которой это сверка значений, а
// не факт компиляции (`model->gain = floor(...)` компилируется и считает верно,
// но требует libm; `2.5` в поле `int16_t` компилируется и считает неверно).
var gain: q(8, 8) := 0.5;
var work: q(8, 8) := 1.0;
// Эталонное значение того же литерала, полученное другим путём - свёрткой
// инициализатора (0061/0317). Сравнение с ним ловит искажение представления в
// теле: наблюдаемые `as u8` слишком грубы (ошибка в один разряд представления
// в них не видна - проверено мутацией).
var ref_gain: q(8, 8) := 2.5;
var n: u8 := 0;

out set_v: u8 at 0;
out mul_v: u8 at 1;
out neg_v: u8 at 2;
out eq_v: u8 at 3;

start Run {
    always {
        n := n + 1;
        // Присваивание приведения: 2.5 -> представление 640.
        gain := 2.5 as q(8, 8);
        set_v := gain as u8;
        // Приведение внутри арифметики: work удваивается каждый такт.
        work := work * (2.0 as q(8, 8));
        mul_v := work as u8;
        // Отрицательный литерал: floor(-1.5 · 256) = -384; после `as u8`
        // значение переносится по правилу целого - наблюдаем через сложение.
        neg_v := (work + (-1.5 as q(8, 8))) as u8;
        // Кросс-проверка путей: тело против инициализатора. Оба обязаны дать
        // одно представление - иначе автор, написавший литерал в объявлении и
        // в теле, получил бы два разных значения.
        eq_v := 0;
        if gain = ref_gain {
            eq_v := 1;
        }
    }
    ref Run: n < 100;
}
