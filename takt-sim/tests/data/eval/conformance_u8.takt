/// Сверка симулятора с кодом, порождённым `taktc -t c`.
///
/// Модель намеренно ограничена типами, для которых эталон C **пригоден**
/// (`Integer`/`Enum`/`Bool`). Для `Rational`, `Bit` и `Array` генератор C
/// дефектен (см. бэклог), поэтому сверка по ним анализом исключена.
///
/// Модель обёрнута в `model` с корневым `start`. Изначально это был **обход**
/// дефекта: для одиночной корневой модели генератор не эмитил `typedef`, и
/// порождённый C не компилировался. Обёртка под-моделью
/// больше не нужна, но сохранена: разворачивание сменило бы имена символов C
/// (`Conf` -> корень), а с ними и ожидания сверки, ничего не проверив сверх.
///
/// Проверяемые правила:
///   S1 - обёртка беззнакового: 255 + 1 -> 0
///   S9 - усечение при записи:  200+100 -> 44
///   S7 - вариант enum как целое
///   бул. приведение: (bool)2 -> true -> 1
enum Mode {
    Auto = 0,
    Manual = 1
}

model Conf {
    var wrapped: u8 := 0;
    var truncated: u8 := 0;
    // Слагаемые - переменные: усечение обязано проверяться вычислением.
    // Литералом (`truncated := 300`) его записать больше нельзя - литерал вне
    // диапазона типа отвергает SE-089, и это разные вопросы:
    // Норма арифметики и запись заведомо не влезающей
    // константы.
    var part_a: u8 := 200;
    var part_b: u8 := 100;
    var mode: Mode := Auto;
    var flag: bool := false;
    var divided: u8 := 0;
    var shifted: u8 := 0;

    start Idle {
        always {
            wrapped := 255;
            wrapped := wrapped + 1;
            truncated := part_a + part_b;
            mode := Manual;
            flag := true;
            divided := 7 / 2;
            shifted := 1 << 8;
        }
    }
}

start Entry = Conf;
