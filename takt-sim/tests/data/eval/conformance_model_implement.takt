/// Фикстура потактовой сверки формы `model M = A | B { ... }`.
///
/// Форма разбиралась грамматикой, но не работала ни в одной стороне: эталон
/// давал пустую трассу, все четыре цели отказывали. Теперь она разворачивается
/// в синтетическое стартовое состояние - то есть становится синонимом записи
/// `model M { start Имя = A | B; }`.
///
/// Тело **накапливающее** (`n := n + 1`): проверяется не только то, что
/// `always` владельца исполняется, но и то, что он исполняется **ровно раз за
/// такт**. На идемпотентном теле пропуск и двойное
/// исполнение неразличимы.
///
/// Ожидаемая трасса `n`: 1, 2, 3, ... - по одному исполнению на такт.
model A {
    start C1 {
        ref C1;
    }
}

model B {
    start C2 {
        ref C2;
    }
}

model Root2 = A | B {
    var n: u8 := 0;

    always { n := n + 1; }
}

start Entry = Root2;
