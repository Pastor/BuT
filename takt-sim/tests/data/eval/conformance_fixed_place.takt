// Сверка понижения q-литерала, когда приёмник - поле или элемент.
//
// Понижение по имени приёмника берёт формат `q(m, n)` у ячейки ссылки
// брался у ячейки ссылки. Поле структуры и элемент массива под правило не
// подпали, хотя тип объявлен рядом. Замер 2026-08-22:
//
//   `g.kp := 2.0;`      цель `c` печатала `model->g.kp = 2.0;` - значение 2
//                       вместо 512, то есть set_v = 0 против 2 у эталона;
//   `gains[0] := 2.0;`  то же, а `iec2c` и `rustc` вывод отвергали;
//   `g.kp > 1.0`        эталон отвечал SIM-005 В такте, а цель `c` сравнивала
//                       представление 128 с единицей и считала истиной;
//   `ref ... : g.kp > ...;` то же на ребре - другой автомат при нулевом коде
//                       возврата `taktc`.
//
// Фикстура держит четыре позиции разом:
//   `set_v`  - присваивание литерала полю структуры;
//   `arr_v`  - присваивание литерала элементу массива;
//   `cmp_v`  - сравнение поля с литералом в теле;
//   ребро    - сравнение поля с литералом в условии `ref` (сырой АСД).
//
// Значения подобраны так, чтобы понижение меняло ответ: `kp = 0.5` - это
// представление 128, а литерал `1.0` - 256, поэтому `kp > 1.0` ложно. Без
// понижения сравнение шло бы с единицей и давало истину, то есть мутация
// "вернуть прежний признак" роняет сверку, а не проходит незаметно.
//
// Арифметики с литералом (`g.kp + 1.5`) здесь нет намеренно: её отвергает
// `SE-059` - названная граница правила.
struct Gains {
    kp: q(8, 8),
    ki: q(8, 8)
}

var g: Gains := {0.5, 0.25};
var gains: [q(8, 8); 2] := {0.5, 0.25};
var n: u8 := 0;

out set_v: u8 at 0;
out arr_v: u8 at 1;
out cmp_v: u8 at 2;
out edge_v: u8 at 3;

start Run {
    always {
        n := n + 1;
        // Приёмник - поле структуры: 2.0 обязано стать 512, и `as u8` вернуть 2.
        g.kp := 2.0;
        set_v := g.kp as u8;
        // Приёмник - элемент массива: то же правило.
        gains[0] := 3.0;
        arr_v := gains[0] as u8;
        // Сравнение поля с литералом: ki = 0.25 (64) против 1.0 (256) - ложь.
        cmp_v := 0;
        if g.ki > 1.0 {
            cmp_v := 1;
        }
        edge_v := 0;
    }
    // Условие ребра - сырой АСД: ki = 0.25 (64) против 4.0 (1024) - ложь,
    // то есть автомат остаётся в Run. Без понижения сравнение шло бы с 4 и
    // уводило цель в Done на первом же такте.
    ref Done: g.ki > 4.0;
    ref Run: n < 100;
}

state Done {
    always {
        edge_v := 1;
    }
}
