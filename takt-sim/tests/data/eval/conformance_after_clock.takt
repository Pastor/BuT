// Фикстура сверки выдержки в профиле "часы" (фича 0134-04b): нет объявления
// `clock`, поэтому время меряется внешним источником `now_ms`, а не счётом
// тактов. При 1 мс на такт выдержка 5 мс срабатывает через 5 тактов от входа -
// тот же номер такта, что и у профиля "такты", но механизм другой (метка
// времени и разность, а не счётчик). Проверяется номер такта срабатывания.
model Dwell {
    out done: bit at 0;

    start Waiting {
        ref Ready: after 5ms;
    }

    state Ready {
        enter { done := 1; }
    }
}

start Main = Dwell;
