// Guard границ массива: индекс растёт и выходит за границу.
//
// Индекс переменный - литеральный и константный судит семантика (SE-028).
// Значения элементов различаются, чтобы трасса отличала подмену элемента от
// пропуска доступа.
var data: [u8; 3] := {2, 4, 6};
var i: u8 := 0;
out probe: u8 at 0x100;

start Run {
    always {
        probe := data[i];
        i := i + 1;
    }
    ref Run;
}
