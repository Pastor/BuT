// Сверка приведения имени константы к q(m, n).
//
// Цели считают `2.5 as q(8, 8)` при компиляции, но признак
// требовал литерала. Имя константы под него не подпадало, и замер 2026-08-22
// дал на `gain := K as q(8, 8);` при `const K: float := 2.5;`:
//
//   эталон, c  исполняют (out_v = 2);
//   st, st-at  ST-014 "LREAL_TO_INT округляет к ближайшему, а q требует floor;
//              литеральный float понижается на этапе компиляции";
//   rust       RS-011 с тем же обещанием;
//   sv, sv-mmio SV-003 - но не на приведении, а на самом объявлении константы:
//              вещественного типа в синтезируемом RTL нет.
//
// Второй слой вскрылся правкой: свернув приведение, цели перестают печатать
// имя константы - и `rust` под `-D warnings` отвечает "constant is never used",
// а `sv` по-прежнему падает на её объявлении. Поэтому константа, все обращения
// к которой свёрнуты, в вывод не эмитится вовсе.
//
// Имя второй константы - `BUMP`, а не `STEP`: последнее зарезервировано в
// IEC 61131-3, и цель `st` отвечала бы `ST-014` - посторонней
// причиной, к предмету отношения не имеющей.
//
// `mix_v` держит вторую константу, которая используется И в приведении, И
// обычным путём: она обязана остаться в выводе - иначе правка читалась бы как
// "константы под приведением выбрасываются всегда".
const K: float := 2.5;
const BUMP: u8 := 3;

var gain: q(8, 8) := 0.5;
var ref_gain: q(8, 8) := 2.5;
var n: u8 := 0;

out set_v: u8 at 0;
out eq_v: u8 at 1;
out mix_v: u8 at 2;

start Run {
    always {
        n := n + 1;
        gain := K as q(8, 8);
        set_v := gain as u8;
        // Кросс-проверка путей: значение из тела против значения того же
        // литерала из объявления (свёртка представления).
        eq_v := 0;
        if gain = ref_gain {
            eq_v := 1;
        }
        // Константа, используемая обычным путём, остаётся в выводе.
        mix_v := n + BUMP;
    }
    ref Run: n < 100;
}
