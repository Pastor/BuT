// Умолчание переменной перечислимого типа - первый по тексту вариант
// (решение заказчика 2026-08-23).
//
// Замер 2026-08-22 дал молчаливое расхождение: эталон, `c`, `st` и `sv`
// давали 0 - значение, которого в наборе нет, - а `rust` первый вариант (5).
// Все инструменты вывод принимали, коды возврата совпадали.
//
// Фикстура держит три случая, и каждый различает правило:
//   `Mode`   - первый вариант 5, нуля в наборе нет: 0 и 5 различимы;
//   `Order`  - первый по тексту (2) не наименьший (1): различает "первый по
//              тексту" и "наименьший по значению" - они дают разные ответы;
//   `Plain`  - первый вариант 0: контроль, что прежнее поведение сохранено
//              там, где два правила совпадают.
enum Mode { Idle = 5, Work = 7 }
enum Order { Second = 2, First = 1 }
enum Plain { Zero = 0, One = 1 }

var m: Mode;
var r: Order;
var p: Plain;

var o_mode: u8 := 0;
var o_order: u8 := 0;
var o_plain: u8 := 0;

start Run {
    always {
        o_mode := m as u8;
        o_order := r as u8;
        o_plain := p as u8;
    }
    ref Run;
}
