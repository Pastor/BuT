// Тот же приём наблюдения, что у `conformance_fixed_probe.takt` (выходной
// float-порт несёт представление q побитово), но формат - **q(6, 6)**: ширина
// W = 12 при типе хранения 16 бит.
//
// Смысл фикстуры - граница переноса. Правило требует
// переноса к W, то есть repr ∈ [−2048, 2047]; сужение к типу хранения дало бы
// границу 16 бит и другие значения. Прежние фикстуры сверки состояли только из
// q(8, 8) и q(4, 4), где W совпадает с шириной хранения, - там расхождение
// невидимо.
//
// Трасса `probe` (= repr/64): 30.0 -> +8.0 -> −26.0 (перенос) -> −18.0 -> −10.0.
model FixedProbeW12 {
    var acc: q(6, 6) := 30.0;
    var delta: q(6, 6) := 8.0;
    out probe: float := 0.0;

    start S0 { always { acc := acc + delta; probe := acc as float; } ref S1; }
    state S1 { always { acc := acc + delta; probe := acc as float; } ref S2; }
    state S2 { always { acc := acc + delta; probe := acc as float; } }
}
start Entry = FixedProbeW12;
