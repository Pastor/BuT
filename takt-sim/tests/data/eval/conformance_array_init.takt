// Сверка инициализатора массива.
//
// Цель `st` теряла его молча: `a : ARRAY [0..1] OF USINT;` без `:=`. Замер
// прогоном через `iec2c` + `cc`: ST давал `o = 0`, эталон - `3`, и код
// возврата `taktc` был нулевым.
//
// Массив структур - второй случай: форму агрегата `iec2c` не принимает ни в
// одном из трёх проверенных видов, поэтому значения кладутся операторами
// первого скана.
struct Cell { v: u8, w: u8 }

var flat: [u8;2] := {1, 2};
var cells: [Cell;2] := {{3, 4}, {5, 6}};

var sum: u8 := 0;
var ctl: u8 := 0;

out o_sum: u8 at 0;
out o_ctl: u8 at 1;

start Run {
    always {
        sum := cells[0].v + cells[1].w;
        ctl := flat[0] + flat[1];
        o_sum := sum;
        o_ctl := ctl;
    }
    ref Run: sum = 9;
}
