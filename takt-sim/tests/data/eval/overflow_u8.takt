/// Усечение по объявленному типу при записи.
///
/// Сверено с C (cc -std=c11): uint8_t b = 200+100 -> 44; uint8_t a = 255; a+1 -> 0.
///
/// Слагаемые - переменные: литерал вне диапазона типа отвергает SE-089
/// диапазона типа, а проверяется здесь поведение арифметики.
var wrapped: u8 := 0;
var truncated: u8 := 0;
var part_a: u8 := 200;
var part_b: u8 := 100;

start Idle {
    always {
        wrapped := 255;
        wrapped := wrapped + 1;
        truncated := part_a + part_b;
    }
}
