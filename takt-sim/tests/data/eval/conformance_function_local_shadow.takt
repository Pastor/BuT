// Локальная переменная функции, имя которой совпало с переменной модели
// функции.
//
// `s` модели читается после вызова: если функция пишет в её сигнал вместо
// своей локальной, значение сдвигается - а RTL при этом остаётся валидным,
// и оба инструмента SV его принимают.
fn boost(x: u8) -> u8 {
    var s: u8 := 0;
    s := x + 3;
    return s;
}

var s: u8 := 100;
var seen: u8 := 0;
var e: u8 := 0;
out probe: u8 at 0x100;
out kept: u8 at 0x104;

start Run {
    always {
        e := e + 1;
        seen := boost(e) + s;
        s := s + 1;
        probe := seen;
        kept := s;
    }
    ref Run;
}
