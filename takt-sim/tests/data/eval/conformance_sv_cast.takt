// Сверка приведения `as` цели `sv` с эталоном.
//
// До фичи цель не переводила приведение вовсе (`SV-002`), тогда как эталон и
// шесть целей его исполняли.
//
// Проверяются оба направления: расширение (`u8 -> u16`) и сужение с обёрткой
// (`u16 -> u8`, норма переполнения). Сужение обязательно: на расширении ошибка в
// ширине незаметна - старшие разряды и так нули.
var a: u8 := 200;
var wide: u16 := 0;
var narrow: u8 := 0;
var i: u8 := 0;

out probe: u16 at 0;
out cut: u8 at 1;

start Run {
    always {
        i := i + 1;
        wide := (a as u16) + 100;
        narrow := wide as u8;
        probe := wide;
        cut := narrow;
    }
    ref Run: i < 100;
}
