// Момент готовности вложенной цепочки.
//
// Форма `((A + B) | C) + E`: цепочка `A + B` стоит внутри параллели, а сама
// параллель - первый шаг внешней цепочки. Пока параллель не готова, шаг `E`
// не идёт, поэтому момент, в который вложенная цепочка объявляет себя
// завершённой, наблюдается значением `oe`: сдвиг на такт виден трассой.
//
// У соседней фикстуры (`A + ((B + C) | D)`) такой наблюдаемой нет: после
// завершения вложенной цепочки её выходы не меняются, и лишний скан невидим.
model A {
    var n: u8 := 0;
    out oa: u8 at 0x100;
    start Go { always { n := n + 1; oa := n; } ref Fin: n = 2; }
    state Fin;
}

model B {
    var m: u8 := 0;
    out ob: u8 at 0x104;
    start Go { always { m := m + 2; ob := m; } ref Fin: m = 4; }
    state Fin;
}

model C {
    var k: u8 := 0;
    out oc: u8 at 0x108;
    start Go { always { k := k + 3; oc := k; } ref Fin: k = 9; }
    state Fin;
}

model E {
    var e: u8 := 0;
    out oe: u8 at 0x10c;
    start Go { always { e := e + 1; oe := e; } ref Fin: e = 3; }
    state Fin;
}

start All = ((A + B) | C) + E;
