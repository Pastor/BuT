// Сверка присваивания агрегата в теле.
//
// `body := {3, 4};` при `body: Point` - цель `c` печатала `model->body = {3,
// 4};` (в C такой формы нет вовсе), а `st` и `sv` адресовали структуру как
// массив: `body[0] := 3;`. Всё - при нулевом коде возврата `taktc`.
//
// `arr` - контрольный вход: тот же агрегат массиву. Он работал,
// и без него правка читалась бы как "агрегат печатается по имени поля всегда".
struct Point { x: u8, y: u8 }

var body: Point := {0, 0};
var arr: [u8;2] := {0, 0};
var sum: u8 := 0;
var actl: u8 := 0;

out o_sum: u8 at 0;
out o_ctl: u8 at 1;

start Run {
    always {
        body := {3, 4};
        arr := {5, 6};
        sum := body.x + body.y;
        actl := arr[0] + arr[1];
        o_sum := sum;
        o_ctl := actl;
    }
    ref Run: sum = 7;
}
