// Фикстура сверки: разряд участвует в арифметике как число 0/1.
//
// Соседняя фикстура `conformance_bit_value.takt` сверяет разряд в
// позиции числового значения (`direct := src.3;`); здесь предмет иной -
// разряд как операнд арифметики, что эталон без правки отвергает `SIM-005` в такте.
//
// Тело накапливающее, источник меняется по тактам: на постоянном значении
// "взяли верный разряд" и "взяли соседний" неразличимы. Разрядов два - на
// одном ошибка в номере тоже была бы невидима.
var src: u8 := 200;
var acc: u8 := 0;
var n: u8 := 0;
out o: u8 at 0x100;

start Run {
    always {
        n := n + 1;
        src := src + 1;
        acc := acc + src.7 + src.6;
        o := acc;
    }
    ref Done: n >= 4;
}

state Done {
}
