// Узел-поддерево составного порта: чтение и запись.
//
// Порт развёрнут по листьям, и узел ветвления собирается из них временной.
// Ошибись сборка порядком (`{b, a}` вместо `{a, b}`) - вывод остался бы
// валидным, а значения разошлись бы: поэтому листья здесь разные по величине,
// а наблюдаются оба.
//
// Порт двунаправленный: значение, записанное моделью, читают обе стороны, и
// сценарий входов не нужен (приём фикстуры 0499).
struct Inner {
    a: u8,
    b: u8
}

struct Outer {
    head: u8,
    tail: Inner
}

model PortSubtree {
    inout cfg: Outer;

    out probe: u8;

    var seen: Inner;

    var step: u8 := 0;

    start Cycle {
        always {
            step := step + 1;
            // Запись в узел: значение раздаётся листьям `tail.a` и `tail.b`.
            cfg.tail := {step, step + 10};
            cfg.head := step + 100;
            // Чтение узла: собирается из листьев во временную.
            seen := cfg.tail;
            probe := seen.b - seen.a;
        }

        ref Cycle: step < 200;
    }
}

start Main = PortSubtree;
