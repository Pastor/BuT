// Сверка целой степени `**`.
//
// Ключевой вход - широкий тип: цель `c` печатала `pow((double)...)`, и на
// `3 ** 40` это давало 12157665459056928768 против 12157665459056928801 у
// эталона - у `double` 53 разряда мантиссы, а число требует 64. Расхождение
// молчаливое: код собирался и работал.
//
// Узкий тип добавлен контролем: на нём `double` точен, и подмена целой
// арифметики вещественной была бы незаметна.
var wide: u64 := 3;
var narrow: u8 := 2;
var big: u64 := 0;
// Имя `cube_v`, а не `small`: `small` - ключевое слово SystemVerilog
// (`SV-012`), и модель не переводилась бы целью `sv`.
var cube_v: u8 := 0;
var i: u8 := 0;

out probe: u64 at 0;
out cube: u8 at 1;

start Run {
    always {
        i := i + 1;
        big := wide ** 40;
        cube_v := narrow ** 3;
        probe := big;
        cube := cube_v;
    }
    ref Run: i < 100;
}
