/// Фикстура потактовой сверки model-level `always`.
///
/// `always { n := n + 1; }` объявлен **на уровне модели** (вне состояния) -
/// без него такой блок молча теряется во всех целях и в эталоне. По
/// контракту он исполняется каждый такт до диспетчеризации состояния, безусловно по
/// состоянию (в т.ч. в терминальном).
///
/// Ожидаемая трасса `n`: 1 -> 2 -> 3 (переход при n > 2) -> 4 (такт в `Done` перед
/// уходом в END). Обёрнута в `start Entry = Counter;` (доступ `m.entry.n`), как и
/// прочие фикстуры сверки.
model Counter {
    var n: u8 := 0;

    always { n := n + 1; }

    start Run {
        ref Done: n > 2;
    }
    state Done;
}

start Entry = Counter;
