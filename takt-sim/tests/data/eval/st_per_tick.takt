// Фикстура потактовой сверки цели `st`.
//
// Устроена так, чтобы оба расхождения, которые фича устраняет, были видны
// именно в трассе, а не только в тексте вывода:
//
//  * вложенность >= 2 (`Main = Blinker`) - синтетическое `INIT` каждого уровня
//    стоило скана, и трасса ST оказывалась сдвинута на глубину вложенности;
//  * условие перехода читает `mask` - переменную типа `[bit;8]` с
//    инициализатором. Потеряй цель `st` этот инициализатор (а она теряла), и
//    `mask = 255` никогда не выполнится: автомат застрянет в `Hold`, то есть
//    трасса разойдётся с эталоном.
//
// Тела накапливающие (`n := n + 1`), а не идемпотентные: на идемпотентном
// теле лишний либо пропущенный такт неразличим.
model Blinker {
    out lamp: u8 at 0x600;
    var n: u8 := 7;
    var mask: [bit;8] := 255;

    start Run {
        always {
            n := n + 1;
            lamp := n;
        }
        ref Hold: n >= 10;
    }

    state Hold {
        always {
            n := n + 1;
            lamp := n;
        }
        ref Done: mask = 255;
    }

    state Done;
}

start Main = Blinker;
