/// Фикстура потактовой сверки (R4/A6).
///
/// В отличие от `conformance_u8.takt` (завершается за один такт), эта модель
/// эволюционирует несколько тактов: переменная `n` принимает 1 -> 2 -> 3 по мере
/// переходов S0 -> S1 -> S2. Это делает потактовую трассу содержательной - сдвиг
/// на `INIT`-такт (если бы он вернулся) сместил бы всю трассу и был бы пойман.
///
/// Обёрнута в `start Entry = Counter;` (глубина 2, доступ `m.entry.n`), как и
/// `conformance_u8.takt` - тот же способ доступа к полю в C-харнессе.
///
/// Типы - только `Integer` (`u8`): область сверки сужена по типам независимо от
/// 0033 (см. заголовок `conformance_c_tests.rs`).
model Counter {
    var n: u8 := 0;

    start S0 {
        always { n := 1; }
        ref S1;
    }
    state S1 {
        always { n := 2; }
        ref S2;
    }
    state S2 {
        always { n := 3; }
    }
}

start Entry = Counter;
