// Библиотека сверки импорта: объявления связи на верхнем уровне и
// модель, которая их обслуживает. Самостоятельным автоматом файл не является -
// он подключается импортёром (`import_pid_app.takt`).
var ctrl: u8 := 0;
var meas: u8 := 0;

model Pid {
    start Control {
        always {
            ctrl := meas + 1;
        }
        // Явная самопетля: состояние без исходящих рёбер эталон и цель `c`
        // трактуют по-разному (цель уводит в END после одного такта), а предмет
        // этой фикстуры - привязка импортированных объявлений, не переходы.
        ref Control: true;
    }
}
