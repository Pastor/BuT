// Фикстура сверки: арифметика в типе приёмника.
//
// `r: u16 := a + b;` при `a, b: u8` - обычное накопление; сумма 300 **не
// помещается** в восемь бит, поэтому фикстура отличает верное расширение от
// "посчитали в u8 и обернули": тогда вышло бы 44.
//
// Значения меняются по тактам: на постоянном ошибка в операнде незаметна.
var a: u8 := 200;
var b: u8 := 100;
var wide: u16 := 0;
var n: u8 := 0;
out sum: u16 at 0x100;
out step: u8 at 0x104;

start Run {
    always {
        n := n + 1;
        b := b + 10;
        wide := a + b;
        sum := wide;
        step := n;
    }
    ref Done: n >= 4;
}

state Done {
}
