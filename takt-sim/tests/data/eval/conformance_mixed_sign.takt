// Фикстура сверки: сравнение знакового с беззнаковым.
//
// Оба случая разом: 8 бит (общий тип есть) и 64 бита (его нет - раскрытие
// проверкой знака). Знаковый растёт и пересекает порог, поэтому ответ меняется
// по ходу трассы: на постоянном ответе ошибка в правиле неотличима.
//
// Прежняя редакция брала `u = 200`, и `s8 < u8v` было истинно всегда -
// такая сверка зелена и при полностью сломанном правиле.
var s8: i8 := -2;
var u8v: u8 := 1;
var s64: i64 := -2;
var u64v: u64 := 1;
var n: u8 := 0;
out lo: u8 at 0x100;
out hi: u8 at 0x104;

start Run {
    always {
        n := n + 1;
        s8 := s8 + 1;
        s64 := s64 + 1;
        if s8 < u8v {
            lo := 1;
        } else {
            lo := 2;
        }
        if s64 > u64v {
            hi := 1;
        } else {
            hi := 2;
        }
    }
    ref Done: n >= 4;
}

state Done {
}
