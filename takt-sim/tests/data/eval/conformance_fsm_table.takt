// Фикстура потактовой сверки табличной формы автомата.
//
// Держит всё, чем формы могут разойтись: условное ребро, блоки `enter` и
// `exit`, накапливающее тело (на идемпотентном пропуск и двойное исполнение
// неразличимы) и терминальное состояние, которому цель подставляет `END`.
model Worker {
    var n: u8 := 0;
    out probe: u8;

    start Low {
        always {
            n := n + 1;
            probe := n;
        }
        ref High: n = 2;
    }

    state High {
        enter {
            probe := 100;
        }
        always {
            n := n + 1;
            probe := n;
        }
        // Два конкурирующих ребра: при n = 4 истинны оба. Выбрать обязано
        // первое по объявлению - на этом стоит проверка порядка строк
        // таблицы: перестановка даёт валидный вывод и другой автомат.
        ref Tail: n = 4;
        ref Trap: n > 3;
        exit {
            probe := 200;
        }
    }

    // Состояние-ловушка: сюда автомат попадает, только если порядок рёбер
    // нарушен.
    state Trap {
        always {
            probe := 77;
        }
        ref Trap: n > 0;
    }

    state Tail {
        always {
            n := n + 1;
            probe := n;
        }
        ref Tail: n > 0;
    }
}

start Main = Worker;
