// Сверка вложенного агрегата: массив структур и массив массивов
// получают значение целиком, а раскрытие идёт до листьев.
//
// Без раскрытия цель `st` отвергает обе записи (`ST-011`): раскрытие было
// одноуровневым, и элемент-агрегат печатался как выражение, которого в IEC
// нет. Форма адресации у цели своя - многомерный массив адресуется одной парой
// скобок (`cells[1, 0]`), - поэтому проверяются значения: путь,
// собранный неверно, компилируется и даёт другое число.
//
// Значения разные по позициям и меняются по тактам: на одинаковых
// перестановка полей и индексов неразличима.
struct Point {
    x: u8,
    y: u8
}

model Grid {
    out lamp: u8 at 0x600;

    var pts: [Point; 2] := {{1, 2}, {3, 4}};
    var cells: [[u8; 2]; 2] := {{0, 0}, {0, 0}};
    var n: u8 := 0;
    var a: u8 := 0;
    var b: u8 := 0;

    start Run {
        always {
            n := n + 1;
            pts := {{n, n + 1}, {n + 2, n + 3}};
            cells := {{n + 4, n + 5}, {n + 6, n + 7}};
            a := pts[1].y;
            b := cells[1][0];
            lamp := a;
        }
        ref Done: n >= 3;
    }

    state Done;
}

start Main = Grid;
