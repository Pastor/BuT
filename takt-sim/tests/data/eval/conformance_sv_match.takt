// Сверка оператора `match` цели `sv` с эталоном.
//
// До фичи цель отвергала `match` (`SV-002`), хотя в SystemVerilog есть прямой
// аналог - `case`; остальные семь потребителей вход исполняли.
//
// Наблюдаемая меняется по веткам: `mode` переключается по тактам, и каждая
// ветка даёт своё значение. Одна ветка проверяла бы лишь то, что `case`
// напечатан, - но не то, что выбрана верная.
enum Mode { Idle, Run, Stop }

var mode: Mode := Idle;
var v: u8 := 0;
var i: u8 := 0;

out probe: u8 at 0;
out step: u8 at 1;

start Run {
    always {
        i := i + 1;
        match mode {
            Idle => { v := 10; }
            Run => { v := 20; }
            _ => { v := 30; }
        }
        probe := v;
        step := i;
        // Переключение ветки на следующем такте: 1 -> Idle, 2 -> Run, далее Stop.
        if i = 1 {
            mode := Run;
        } else {
            mode := Stop;
        }
    }
    ref Run: i < 100;
}
