// Фикстура сверки выдержки цели `sv`. Профиль "часы" (нет объявления
// `clock`): выдержка 5 мс через служебный вход `time_ms`, тестбенч подаёт его
// модельным временем. Результат - в выходной порт `level` (наблюдается
// иерархической ссылкой dut.level).
model Dwell {
    out level: u8 at 0;

    start Waiting {
        ref Ready: after 5ms;
    }

    state Ready {
        enter { level := 1; }
    }
}

start Main = Dwell;
