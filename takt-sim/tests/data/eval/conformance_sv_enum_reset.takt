// Сверка сброса перечислимого регистра у цели `sv`.
//
// Переменная перечислимого типа без инициализатора сбрасывалась в `'0`, и
// verilator отвечал ошибкой `%Error-ENUMVALUE` ("Implicit conversion to enum
// ... from 'bit'"): перечисления SystemVerilog строго типизированы, а гейт цели
// считает предупреждение ошибкой. `taktc` возвращал ноль; эталон, `c`, `st` и
// `rust` тот же вход исполняют.
//
// Фикстура держит два перечисления, чтобы различать умолчание и ноль
// (фича 0391 сделала умолчанием первый по тексту вариант):
//   `Mode`  - первый вариант `Idle = 1`, нуля в наборе нет;
//   `Phase` - первый вариант `Zero = 0`, то есть умолчание совпадает с нулём.
// Разные ответы у этих двух и отличают правило "первый вариант" от "ноль".
//
// Наблюдаемые снимаются до первой записи, поэтому такт 1 показывает именно
// значение сброса - то, ради чего фикстура и заведена.
enum Mode {
    Idle = 1,
    Work = 2
}

enum Phase {
    Zero = 0,
    One = 1
}

var m: Mode;
var p: Phase;
var n: u8 := 0;

out reset_mode: u8 at 0;
out reset_phase: u8 at 1;

start Run {
    always {
        n := n + 1;
        reset_mode := m as u8;
        reset_phase := p as u8;
        m := Work;
        p := One;
    }
    ref Run: n < 100;
}
