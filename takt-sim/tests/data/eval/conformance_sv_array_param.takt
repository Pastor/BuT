// Сверка массива В параметре функции у цели `sv`.
//
// Распакованную размерность у порта функции yosys не принимает вовсе
// ("input/output/inout ports cannot have unpacked dimensions"), а verilator
// пропускает - вывод компилировался и не синтезировался при нулевом коде
// возврата `taktc`. Массив передаётся плоским вектором, аргумент -
// конкатенацией.
//
// Наблюдаемые различают края массива: `low` читает первый элемент, `high` -
// последний, и оба меняются по тактам. Перепутанный порядок конкатенации даёт
// валидный RTL с зеркальными значениями, и только сверка это видит; на
// постоянных значениях ошибка неотличима.
var cells: [u8; 3] := {4, 5, 6};
var n: u8 := 0;

out low: u8 at 0;
out high: u8 at 1;
out sum: u8 at 2;

fn first(a: [u8; 3]) -> u8 {
    return a[0];
}

fn last(a: [u8; 3]) -> u8 {
    return a[2];
}

start Run {
    always {
        n := n + 1;
        cells[0] := n;
        cells[2] := n + 20;
        low := first(cells);
        high := last(cells);
        sum := first(cells) + last(cells);
    }
    ref Run: n < 100;
}
