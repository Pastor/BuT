// Срез массива в аргументе вызова.
//
// Значения подобраны так, что ошибка в границах видна: `mid` берёт [1:3] и
// даёт 6, `tail` берёт [2:4] и даёт 7 - перепутанные границы или потерянное
// смещение дают другое число, а не отказ.
fn first(a: [u8; 2]) -> u8 {
    return a[0];
}

fn total(a: [u8; 2]) -> u8 {
    return a[0] + a[1];
}

var src: [u8; 4] := {5, 6, 7, 8};

var o_mid: u8 := 0;
var o_tail: u8 := 0;
var o_sum: u8 := 0;

start Run {
    always {
        o_mid := first(src[1:3]);
        o_tail := first(src[2:4]);
        o_sum := total(src[0:2]);
    }
    ref Run;
}
