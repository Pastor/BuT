// Фикстура потактовой сверки цели `st` - доказывает фикс
// 0041-01 (Tier 1) поведенчески, а не только структурно.
//
// Две модели, у каждой одноимённая `fn helper`, но разные тела (`x+1` и `x+2`).
// До префиксации POU цель `st` склеивала их по голому имени: обе модели звали
// тело первой, и модель B молча считала `wb = 2` вместо `wb = 3`.
//
// Переменные названы по-разному (`wa`/`wb`) намеренно: в композиции `A | B`
// симулятор адресует вложенную переменную по имени, и одноимённые `w` были бы
// неразличимы. Разные имена дают независимую точку наблюдения на каждую модель.
//
// Эталон (симулятор и цель `c`): wa = 2, wb = 3. Мутация "вернуть дедуп по
// голому имени" даёт в ST wb = 2 -> сверка падает, а гейт `iec2c` проходит.
model A {
  fn helper(x: u8) -> u8 { return x + 1; }
  var wa: u8 := 0;
  start Run1 { always { wa := helper(1); } ref Done1: wa = 2; }
  state Done1 {}
}

model B {
  fn helper(x: u8) -> u8 { return x + 2; }
  var wb: u8 := 0;
  start Run2 { always { wb := helper(1); } ref Done2: wb = 3; }
  state Done2 {}
}

start Top = A | B;
