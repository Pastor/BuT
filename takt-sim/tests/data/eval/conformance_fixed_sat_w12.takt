// Насыщение `q(m, n) sat` на формате **q(6, 6)**: ширина W = 12
// при типе хранения 16 бит. Формат выбран намеренно - при `q(8, 8)` границы
// формата и хранения совпадают, и цель, прижимающая к ширине хранения вместо
// ширины формата, оставалась бы неотличимой (дыра в покрытии, стоившая фикса
// 0061-01).
//
// Насыщение прижимает к repr ∈ [−2048, 2047]. Шаг 8.0 = repr 512.
//
// Трасса (repr):
//   такт 1: up = 512,  down = −512,  neg = 512
//   такт 2: up = 1024, down = −1024, neg = 1024
//   такт 3: up = 1536, down = −1536, neg = 1536
//   такт 4: up = 2047 (2048 прижато), down = −2048 (ровно граница),
//           neg = 2047 - край −(−2^(W−1)): у переноса он дал бы −2048
//   такт 5: up = 2047, down = −2048 (−2560 прижато), neg = 2047
//   такт 6+: значения удерживаются
//
// `neg := -down;` - единственное место, где перенос и насыщение расходятся
// на унарной операции, и обычные значения этого различия не показывают.
//
// Шаг назван `dv`, а не `step`: пространство имён IEC 61131-3 плоское и
// регистронезависимое, и `step` там занято (цель `st` отвечает `ST-014`).
// Фикстура сверяется в том числе с целью `st`, поэтому имя обязано быть
// пригодным для ПЛК.
model FixedSatW12 {
    var up: q(6, 6) sat := 0.0;
    var down: q(6, 6) sat := 0.0;
    var neg: q(6, 6) sat := 0.0;
    var dv: q(6, 6) sat := 8.0;
    var seen: u8 := 0;
    // Самопереход держит модель живой всю трассу: одного выхода за границу мало
    // - сверяется и то, что значение на границе удерживается.
    start S0 {
        always {
            up := up + dv;
            down := down - dv;
            neg := -down;
            seen := seen + 1;
        }
        ref S0: seen < 100;
    }
}
start Entry = FixedSatW12;
