// Сдвиг на переменную величину.
//
// Величина растёт по тактам (16 -> 32 -> 48) и на втором такте достигает ширины
// продвинутого типа: там `v >> n` в C есть UB, а эталон насыщает. Значения
// подобраны так, что ошибка видна числом на каждом такте - на постоянных
// пропуск насыщения неотличим от верного вывода.
var w: u32 := 4294967295;
var s: i32 := 0 - 70000;
var narrow: u8 := 200;
var n: u32 := 0;

var o_unsigned: u32 := 0;
var o_signed: i32 := 0;
var o_left: u32 := 0;
// Контроль: узкий тип продвигается до `int`, и там правило C уже совпадает с
// эталоном - вывод для него меняться не должен.
var o_narrow: u8 := 0;

start Run {
    always {
        n := n + 16;
        o_unsigned := w >> n;
        o_signed := s >> n;
        o_left := w << n;
        o_narrow := narrow >> n;
    }
    ref Run;
}
