// Q-двойник `conformance_float_q.takt`: та же модель,
// но типы записаны явным `q(8, 8)` вместо `float`. Служит эталоном **byte-equality**:
// вывод `conformance_float_q.takt` под `--float-as-q=8.8 --float-embedded` обязан
// совпасть с выводом этого файла байт-В-байт (одинаковый basename) - доказательство,
// что трансформация float->q даёт ровно проверенный 0061 q-кодоген.
//
// Имена (модель FloatFixed, переменные, состояния) совпадают с float-версией -
// иначе символы порождённого кода разошлись бы.
model FloatFixed {
    var x: q(8, 8) := -1.5;
    var two: q(8, 8) := 2.0;
    var tiny: q(8, 8) := 0.00390625;
    var acc: q(8, 8) := 0.0;

    start S0 { always { acc := x * two; } ref S1; }
    state S1 { always { acc := acc / two; } ref S2; }
    state S2 { always { acc := x * tiny; } ref S3; }
    state S3 { always { acc := acc + two; } }
}
start Entry = FloatFixed;
