// Сверка: повторяющийся образец `match`.
//
// `match` берёт первое совпадение, поэтому вторая ветвь недостижима. Цели её
// не печатают - но печатать они обязаны первую: подмена на вторую даёт
// валидный вывод и другой автомат, и инструменты этого не видят.
var op: u8 := 0;
var acc: u8 := 0;

out probe: u8 at 0x100;

start Run {
    always {
        op := op + 1;
        match op {
            1 => { acc := acc + 1; }
            1 => { acc := acc + 10; }
            2 => { acc := acc + 100; }
        }
        probe := acc;
    }
    ref Run;
}
