// Тот же приём наблюдения, что у `conformance_fixed_probe_w12.takt` (выходной
// float-порт несёт представление q побитово), но формат насыщающий:
// `q(6, 6) sat` - W = 12 при типе хранения 16 бит.
//
// Фикстура нужна цели `rust`: её поля приватны, а q-порта у неё нет (RS-016),
// поэтому единственное наблюдаемое - вещественный выходной порт.
//
// Шаг 24.0 = repr 1536; насыщение прижимает к repr ∈ [−2048, 2047].
//
// Трасса `probe` (= repr/64):
//   S0: 1536       ->  24.0
//   S1: 3072 -> 2047 ->  31.984375 (прижато сверху)
//   S2: 2047 − 1536 =  511  ->   7.984375
//   S3: 511 − 1536  = −1025 -> −16.015625
//   S4: −1025 − 1536 = −2561 -> −2048 -> −32.0 (прижато снизу)
//
// Все значения кратны 2⁻⁶ и потому точны в f64 - сверка идёт по битам.
model FixedSatProbeW12 {
    var acc: q(6, 6) sat := 0.0;
    var dv: q(6, 6) sat := 24.0;
    out probe: float := 0.0;

    start S0 { always { acc := acc + dv; probe := acc as float; } ref S1; }
    state S1 { always { acc := acc + dv; probe := acc as float; } ref S2; }
    state S2 { always { acc := acc - dv; probe := acc as float; } ref S3; }
    state S3 { always { acc := acc - dv; probe := acc as float; } ref S4; }
    state S4 { always { acc := acc - dv; probe := acc as float; } }
}
start Entry = FixedSatProbeW12;
