// Фикстура сверки выдержки цели `st`. Профиль "часы" (нет объявления
// `clock`): выдержка 5 мс через штатный TON, время подаётся драйвером в
// __CURRENT_TIME (проба П3 анализа). Результат - в порт `level` (поля структуры
// FB наблюдаются как регистры ПЛК).
model Dwell {
    out level: u8 at 0;

    start Waiting {
        ref Ready: after 5ms;
    }

    state Ready {
        enter { level := 1; }
    }
}

start Main = Dwell;
