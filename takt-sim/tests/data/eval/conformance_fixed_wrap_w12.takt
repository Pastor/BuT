// Переполнение `+` над q(6, 6) - ширина W = 12 бит, а тип хранения - 16 бит
// (фикс 0061-01). Именно на таком формате видно, к какой границе идёт перенос:
// правило 3 ADR 0061 требует переноса к W, то есть repr ∈ [−2048, 2047].
//
// 30.0 -> repr 1920; 8.0 -> repr 512; 1920 + 512 = 2432 > 2047 -> 2432 − 4096 =
// −1664 (то есть −26.0). Перенос к 16 битам дал бы 2432 и значение 38.0 -
// ровно это и печатали цели c/rust/st до фикса, пока фикстуры сверки состояли
// только из q(8, 8) и q(4, 4), где W совпадает с шириной хранения.
model FixedWrapW12 {
    var acc: q(6, 6) := 30.0;
    var delta: q(6, 6) := 8.0;
    var seen: u8 := 0;
    // Самопереход держит модель живой все такты трассы: одного переполнения
    // мало - сверяется вся последовательность, включая возврат в положительные.
    start S0 {
        always { acc := acc + delta; seen := seen + 1; }
        ref S0: seen < 100;
    }
}
start Entry = FixedWrapW12;
