// Сверка 0510: ветвь `match` с вложенным `if` стоит перед `_`.
//
// Внутреннее условие ложно, поэтому на первом такте не делается ничего. Слей
// цель эту ветвь с её условием - управление ушло бы в `_`, и такт первый дал бы
// 10 вместо 0: валидный вывод и другой автомат.
var op: u8 := 0;
var acc: u8 := 0;

out probe: u8 at 0x100;

start Run {
    always {
        op := op + 1;
        match op {
            1 => {
                if acc > 100 {
                    acc := 1;
                }
            }
            _ => {
                acc := acc + 10;
            }
        }
        probe := acc;
    }
    ref Run;
}
