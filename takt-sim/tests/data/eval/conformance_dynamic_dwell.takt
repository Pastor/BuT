// Фикстура сверки вычисляемой выдержки: порог задан выражением над
// переменной, то есть известен только в такте.
//
// Проверяется номер такта срабатывания: расхождение на такт компилируется молча
// (тот же капкан, что у цели `sv`). При 1 кГц выдержка `base + 2ms`
// равна 5 мс, то есть пяти тактам от входа в стартовое состояние.
model Dwell {
    clock 1kHz;

    var base: duration := 3ms;
    out done: bit at 0;

    start Waiting {
        ref Ready: after (base + 2ms);
    }

    state Ready {
        enter { done := 1; }
    }
}

start Main = Dwell;
