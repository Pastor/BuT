/// Вызов локальной функции в выражении.
///
/// Модель повторяет travel_time из examples/stacker.takt - метрику Чебышёва.
/// Ожидается: eta = max(5, 3, 7) = 7.
var eta: u8 := 0;

fn chebyshev(a: u8, b: u8, c: u8) -> u8 {
    var t: u8 := 0;
    t := a;
    if b > t { t := b; }
    if c > t { t := c; }
    return t;
}

start Idle {
    always { eta := chebyshev(5, 3, 7); }
}
