// Сверка FIXED-POINT В параметре функции.
//
// `fn half(v: q(8, 8)) -> u8` до фичи давала **`SE-119`** - "внутренний
// инвариант семантики нарушен: параметр функции без типа", то есть отказ,
// объявляющий дефект компилятора, на законной записи: тип параметра грамматика
// хранит выражением, и `q(8, 8)` приходит туда вызовом. Вывода не получал
// никто, включая эталон.
//
// Значения меняются по тактам: масштаб 2ⁿ теряется молча (класс 0371), и
// постоянное значение этого не отличит. Меняет их тело состояния приведением
// из целого: дробный литерал в приведении (`2.0 as q(8, 8)`) переводит только
// цель `c` - соседний класс, вынесенный кандидатом.
//
// `whole` читается до присваивания, `doubled` - после: одна функция, два
// разных аргумента в одном такте.
var gain: q(8, 8) := 1.5;
var n: u8 := 0;

out whole: u8 at 0;
out doubled: u8 at 1;

fn whole_part(v: q(8, 8)) -> u8 {
    return v as u8;
}

start Run {
    always {
        n := n + 1;
        whole := whole_part(gain);
        gain := n as q(8, 8);
        doubled := whole_part(gain);
    }
    ref Run: n < 100;
}
