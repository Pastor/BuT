/// Переменная **без инициализатора** существует со значением по
/// умолчанию (нулевым, как default-init в C), а не даёт SIM-009 "переменная не
/// найдена". Так регистрировалась только структура; скаляр без
/// init оставался невидимым.
///
/// Ожидается после первого такта (блок `always`):
///   seen_q     := q     -> 0   (u8)
///   seen_flag  := flag  -> 0   (bit)
///   seen_ratio := ratio -> 0.0 (q(8, 8), repr 0)
///
/// (Массивы намеренно не включены: их исполнение в симуляторе - отдельная
/// массивы эталоном не исполнялись; регистрация массива нулей при этом уже работает.)
var q: u8;
var flag: bit;
var ratio: q(8, 8);

var seen_q: u8 := 7;
var seen_flag: bit := true;
var seen_ratio: q(8, 8) := 9.0;

start Idle {
    always {
        seen_q := q;
        seen_flag := flag;
        seen_ratio := ratio;
    }
}
