// Свойства и время: инварианты, охранные формулы, LTL, выдержки.
//
// Свойство - обязательство модели, которое инструменты проверяют: инвариант
// исполняется на такте, LTL-формула проверяется на графе состояний.
model Properties {
    clock 100Hz;

    const DWELL: duration := 2s;

    var level: u8 := 0;
    var alarm: bit := 0;
    var beats: u8 := 0;

    cond Overflow = level > 200;

    // Именованный инвариант уровня модели: обязательство на каждом такте.
    invariant LevelInRange = level <= 250;

    // Охранная формула: краткая форма и явная - синонимы.
    : level <= 250;
    : [Guard] alarm = 0 | Overflow;
    : true;

    // Именованные условия - атомы временной логики.
    cond Filling = level > 0;
    cond Alarmed = alarm = 1;

    // Временная логика: свойство пути по графу состояний. Атом формулы -
    // имя состояния либо имя условия.
    : [LTL] G (!Overflow) & F Filling;
    : [LTL] X true, Filling U Alarmed, G Filling -> F Alarmed;
    : [LTL] !false, Filling R (!Alarmed | Filling);

    // Вставка на языке цели уровня модели: исполняется каждый такт, как блок
    // `always` уровня модели.
    assembly "c" {
        beats := beats + 0;
    }

    // Блок формул на языке внешнего анализатора: диалект, вызовы и вложенный
    // блок. Такие обязательства проверяет внешний инструмент, а не компилятор.
    formula "smt" {
        assume(level, 250)
        {
            holds(unit.level, "fill", true, 42)
            reachable(check(level))
        }
    }

    start Fill {
        // Инвариант состояния: обязательство, пока автомат здесь.
        invariant NotAlarming = alarm = 0;

        // Блок формул и вставка на уровне состояния: те же конструкции, что на
        // уровне модели и в теле, - места у них выровнены.
        formula {
            state_holds(level)
        }

        assembly "c" {
            beats := beats + 0;
        }

        // Безымянная охранная формула уровня состояния: то же обязательство,
        // но записанное элементом состояния, а не элементом модели.
        : [Guard] level <= 250;

        // Периодическое действие: тело исполняется раз в указанный период.
        every 500ms {
            beats := beats + 1;
        }

        always {
            // Обязательство внутри тела блока, блок формул и вставка на языке
            // цели - три формы, у каждой свой разбор.
            level := level + 1;
            : level <= 250;
            formula {
                step_holds(level)
            }
            assembly "c" {
                beats := beats + 0;
            }
        }

        // Выдержка: литеральная, через константу и вычисляемая.
        ref Hold: after 1s;
        // Выдержка в тактах: частота для неё не нужна.
        ref Hold: after 5t;
        ref Hold: after DWELL;
        ref Hold: after (DWELL + 500ms);
    }

    state Hold {
        always {
            alarm := 1;
        }
    }
}

start Main = Properties;
