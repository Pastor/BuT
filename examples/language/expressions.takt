// Выражения и операторы: арифметика, побитовые, сравнения, приведение.
//
// Каждый оператор языка встречается здесь хотя бы раз — и в теле блока
// (выражение), и на ребре перехода (условие): это два разных разбора.
model Expressions {
    const MASK: u8 := 15;

    var a: u8 := 12;
    var b: u8 := 5;
    var wide: u16 := 0;
    var value: i8 := -3;
    var flags: u8 := 0;
    var window: [u8; 4] := {1, 2, 3, 4};
    var part: [u8; 2] := {0, 0};
    var ready: bit := 0;
    var scaled: q(8, 8) := 1.5;

    start Compute {
        always {
            // Арифметика: сложение, вычитание, умножение, деление, остаток,
            // степень, унарные плюс и минус.
            a := b + 1;
            a := a - b;
            a := b * 2;
            a := a / 2;
            a := a % 3;
            wide := b ** 2;
            value := -b;
            value := +value;

            // Побитовые: И, или, исключающее или, инверсия, сдвиги.
            flags := flags & MASK;
            flags := flags | 16;
            flags := flags ^ 32;
            flags := ~flags;
            flags := flags << 1;
            flags := flags >> 2;

            // Доступ к разряду и к элементу массива, срез массива.
            ready := flags.0;
            a := window[1];
            part := window[0:2];

            // Приведение типа и условный оператор.
            wide := a as u16;
            a := ready ? b : 0;

            // Логическое отрицание и сравнения в выражении.
            ready := !ready;
            ready := a != b;
            scaled := 2.5;

            // Нестрогие сравнения, скобки и логические связки — в позиции
            // выражения. Это другой разбор, чем те же знаки в условии ребра:
            // язык разделяет выражения и условия намеренно, а связок `&&`
            // и `||` условная грамматика не принимает вовсе.
            ready := a <= b;
            ready := a >= b;
            ready := (a <= b) && (b >= 1);
            ready := (a > b) || (b = 5);
        }

        // Условия ребра: сравнения, скобки, конъюнкция, дизъюнкция,
        // арифметика внутри условия, разряд, элемент массива, литералы.
        ref Done: (a >= b) & (window[0] < 9) | !ready;
        ref Done: a + 1 = 13;
        ref Done: a - 1 != 0;
        ref Done: flags.1 = 1;
        ref Done: scaled > 1.0;
        // Ячейка памяти в условии перехода.
        ref Done: #0x300.0 = 1;
    }

    state Done;
}

start Main = Expressions;
