// Управление 9-этажным лифтом - минимальная модель
//
// Архитектура:
//   Motor  - управляет электродвигателем (Up/Down/Stop), реагирует на команду и концевые датчики
//   Cabin  - отслеживает текущий этаж, принимает вызовы, управляет дверью
//   Main   - параллельный запуск Cabin | Motor
//
// Разделяемые переменные (видны обоим авторам):
//   command       : Command  - направление движения, устанавливается Cabin
//   current_floor : u8       - текущий этаж (обновляется по датчикам нижней зоны этажа)
//   target_floor  : u8       - целевой этаж (0 = нет задания)
enum Command {
    Up,
    Down,
    Stop
}

var command: Command := Stop;
var current_floor: u8 := 1;
var target_floor: u8 := 0;

// ─── Модель мотора ────────────────────────────────────────────────────────────
// Простой трёхсостоянный автомат: Idle ↔ Up | Down -> Stop -> Idle.
// Команда Stop или срабатывание концевого датчика прерывает движение.
model Motor {
    start Idle {
        ref Up: command = Up;
        ref Down: command = Down;
        ref Stop: command = Stop;
        enter {
            elevator_motor_stop := true;
        }
    }
    state Up {
        ref Stop: command = Stop | elevator_motor_sensor_u;
        always {
            elevator_motor_up := true;
        }
    }
    state Down {
        ref Stop: command = Stop | elevator_motor_sensor_d;
        always {
            elevator_motor_down := true;
        }
    }
    state Stop {
        next Idle;
        always {
            elevator_motor_stop := true;
        }
    }

    // Выходные порты управления двигателем
    out elevator_motor_up: bit;
    out elevator_motor_down: bit;
    out elevator_motor_stop: bit;
    // Входные порты концевых датчиков (аппаратная защита от перехода)
    in elevator_motor_sensor_u: bit;
    in elevator_motor_sensor_d: bit;
}

// ─── Модель кабины ────────────────────────────────────────────────────────────
// Idle   - ожидание вызова (door open), обновление этажа, приём кнопок
// Moving - движение к целевому этажу, постоянное обновление этажа по датчикам
// AtFloor - прибытие: дверь открыта, ожидаем нажатия DC (закрыть дверь)
model Cabin {

    // ── Ожидание ────────────────────────────────────────────────────────────
    start Idle {
        // Обновляем current_floor по нижнему датчику зоны этажа
        always {
            if floor_sensor_f1_bottom {
                current_floor := 1;
            }
            if floor_sensor_f2_bottom {
                current_floor := 2;
            }
            if floor_sensor_f3_bottom {
                current_floor := 3;
            }
            if floor_sensor_f4_bottom {
                current_floor := 4;
            }
            if floor_sensor_f5_bottom {
                current_floor := 5;
            }
            if floor_sensor_f6_bottom {
                current_floor := 6;
            }
            if floor_sensor_f7_bottom {
                current_floor := 7;
            }
            if floor_sensor_f8_bottom {
                current_floor := 8;
            }
            if floor_sensor_f9_bottom {
                current_floor := 9;
            }
        }
        // Принимаем вызовы: кнопки кабины и кнопки вызова на этажах
        always {
            if cabin_button_f1 {
                target_floor := 1;
            }
            if cabin_button_f2 {
                target_floor := 2;
            }
            if cabin_button_f3 {
                target_floor := 3;
            }
            if cabin_button_f4 {
                target_floor := 4;
            }
            if cabin_button_f5 {
                target_floor := 5;
            }
            if cabin_button_f6 {
                target_floor := 6;
            }
            if cabin_button_f7 {
                target_floor := 7;
            }
            if cabin_button_f8 {
                target_floor := 8;
            }
            if cabin_button_f9 {
                target_floor := 9;
            }
            if floor_button_f1 {
                target_floor := 1;
            }
            if floor_button_f2 {
                target_floor := 2;
            }
            if floor_button_f3 {
                target_floor := 3;
            }
            if floor_button_f4 {
                target_floor := 4;
            }
            if floor_button_f5 {
                target_floor := 5;
            }
            if floor_button_f6 {
                target_floor := 6;
            }
            if floor_button_f7 {
                target_floor := 7;
            }
            if floor_button_f8 {
                target_floor := 8;
            }
            if floor_button_f9 {
                target_floor := 9;
            }
        }
        // Дверь открыта пока в Idle
        always {
            door_open := true;
        }
        // Начать движение при наличии задания
        ref Moving: target_floor != 0;
        enter {
            command := Stop;
        }
    }

    // ── Движение ─────────────────────────────────────────────────────────────
    state Moving {
        // Непрерывно обновляем current_floor по датчикам
        always {
            if floor_sensor_f1_bottom {
                current_floor := 1;
            }
            if floor_sensor_f2_bottom {
                current_floor := 2;
            }
            if floor_sensor_f3_bottom {
                current_floor := 3;
            }
            if floor_sensor_f4_bottom {
                current_floor := 4;
            }
            if floor_sensor_f5_bottom {
                current_floor := 5;
            }
            if floor_sensor_f6_bottom {
                current_floor := 6;
            }
            if floor_sensor_f7_bottom {
                current_floor := 7;
            }
            if floor_sensor_f8_bottom {
                current_floor := 8;
            }
            if floor_sensor_f9_bottom {
                current_floor := 9;
            }
        }
        // Выбираем направление: выше - Up, ниже - Down
        always {
            if target_floor > current_floor {
                command := Up;
            }
            if target_floor < current_floor {
                command := Down;
            }
        }
        // Прибыли на целевой этаж
        ref AtFloor: target_floor = current_floor;
    }

    // ── Прибытие на этаж ─────────────────────────────────────────────────────
    state AtFloor {
        // Дверь открыта всё время пребывания на этаже
        always {
            door_open := true;
        }
        enter {
            command := Stop;
            target_floor := 0;
        }
        // Ждём нажатия кнопки закрытия двери (DC = Door Close)
        ref Idle: cabin_button_dc;
    }

    // Выходные порты двери
    out door_open: bit;

    // Входные порты: кнопки вызова на этажах
    in floor_button_f1: bit;
    in floor_button_f2: bit;
    in floor_button_f3: bit;
    in floor_button_f4: bit;
    in floor_button_f5: bit;
    in floor_button_f6: bit;
    in floor_button_f7: bit;
    in floor_button_f8: bit;
    in floor_button_f9: bit;

    // Входные порты: датчики зоны этажа (Top = верхняя граница, Bottom = нижняя)
    in floor_sensor_f1_top: bit;
    in floor_sensor_f1_bottom: bit;
    in floor_sensor_f2_top: bit;
    in floor_sensor_f2_bottom: bit;
    in floor_sensor_f3_top: bit;
    in floor_sensor_f3_bottom: bit;
    in floor_sensor_f4_top: bit;
    in floor_sensor_f4_bottom: bit;
    in floor_sensor_f5_top: bit;
    in floor_sensor_f5_bottom: bit;
    in floor_sensor_f6_top: bit;
    in floor_sensor_f6_bottom: bit;
    in floor_sensor_f7_top: bit;
    in floor_sensor_f7_bottom: bit;
    in floor_sensor_f8_top: bit;
    in floor_sensor_f8_bottom: bit;
    in floor_sensor_f9_top: bit;
    in floor_sensor_f9_bottom: bit;

    // Входные порты: кнопки кабины (F1-F9, DO = открыть дверь, DC = закрыть дверь)
    in cabin_button_f1: bit;
    in cabin_button_f2: bit;
    in cabin_button_f3: bit;
    in cabin_button_f4: bit;
    in cabin_button_f5: bit;
    in cabin_button_f6: bit;
    in cabin_button_f7: bit;
    in cabin_button_f8: bit;
    in cabin_button_f9: bit;
    in cabin_button_do: bit;
    in cabin_button_dc: bit;
}

start Main = Cabin | Motor;
