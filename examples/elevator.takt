// Модель лифта 9-этажного здания (позитивный тест парсера)
//
// Архитектура управления:
//   Перемещение определяется показаниями датчиков, а не счётчиком тактов.
//   Каждый порт датчиков/кнопок хранит несколько сигналов в отдельных битах.
//     Доступ к отдельному биту: port.N (BitAccess), где N - номер бита (0..7).
//
// Схема размещения сигналов в портах:
//
//   sensors_N  (N=1..9)  - датчики положения на N-м этаже:
//       бит 0 (lo) - нижний оптодатчик: срабатывает первым при подъёме
//       бит 1 (hi) - верхний оптодатчик: срабатывает первым при спуске
//     Оба бита = 1 -> кабина точно в зоне остановки N-го этажа.
//
//   sensors_cab           - датчики внутри кабины:
//       бит 0 - PIR-датчик присутствия пассажира
//       бит 1 - датчик перегрузки (грузоподъёмность превышена)
//
//   btns_floor_N (N=1..9) - кнопки вызова на N-м этаже:
//       бит 0 - кнопка "вверх" (не установлена на 9-м этаже)
//       бит 1 - кнопка "вниз"  (не установлена на 1-м этаже)
//
//   btns_cab_lo / btns_cab_hi - кнопки выбора этажа внутри кабины:
//       btns_cab_lo: биты 0-7 -> этажи 1-8
//       btns_cab_hi: бит  0   -> этаж  9
//     Кнопки кабины опрашиваются только при наличии пассажира (бит 0 sensors_cab).
//
// Схема адресации портов:
//   0x10000000..0x10000008 - sensors_1..sensors_9
//   0x10000009             - sensors_cab
//   0x20000000..0x20000008 - btns_floor_1..btns_floor_9
//   0x30000000             - btns_cab_lo
//   0x30000001             - btns_cab_hi

// ══ порты датчиков положения кабины (1 порт на этаж, 2 бита) ════════════════
in sensors_1: u8 at 268435456; // этаж 1: бит 0 = lo, бит 1 = hi
in sensors_2: u8 at 268435457; // этаж 2: бит 0 = lo, бит 1 = hi
in sensors_3: u8 at 268435458; // этаж 3: бит 0 = lo, бит 1 = hi
in sensors_4: u8 at 268435459; // этаж 4: бит 0 = lo, бит 1 = hi
in sensors_5: u8 at 268435460; // этаж 5: бит 0 = lo, бит 1 = hi
in sensors_6: u8 at 268435461; // этаж 6: бит 0 = lo, бит 1 = hi
in sensors_7: u8 at 268435462; // этаж 7: бит 0 = lo, бит 1 = hi
in sensors_8: u8 at 268435463; // этаж 8: бит 0 = lo, бит 1 = hi
in sensors_9: u8 at 268435464; // этаж 9: бит 0 = lo, бит 1 = hi

// ══ порт датчиков кабины (2 бита в одном регистре) ══════════════════════════
in sensors_cab: u8 at 268435465; // бит 0 = присутствие, бит 1 = перегрузка

// ══ порты кнопок вызова на этажах (1 порт на этаж, 2 бита) ════════════════
in btns_floor_1: u8 at 536870912; // этаж 1: бит 0 = вверх, бит 1 = вниз
in btns_floor_2: u8 at 536870913; // этаж 2: бит 0 = вверх, бит 1 = вниз
in btns_floor_3: u8 at 536870914; // этаж 3: бит 0 = вверх, бит 1 = вниз
in btns_floor_4: u8 at 536870915; // этаж 4: бит 0 = вверх, бит 1 = вниз
in btns_floor_5: u8 at 536870916; // этаж 5: бит 0 = вверх, бит 1 = вниз
in btns_floor_6: u8 at 536870917; // этаж 6: бит 0 = вверх, бит 1 = вниз
in btns_floor_7: u8 at 536870918; // этаж 7: бит 0 = вверх, бит 1 = вниз
in btns_floor_8: u8 at 536870919; // этаж 8: бит 0 = вверх, бит 1 = вниз
in btns_floor_9: u8 at 536870920; // этаж 9: бит 0 = вверх, бит 1 = вниз

// ══ порты кнопок В кабине (9 кнопок = 2 байта) ══════════════════════════════
in btns_cab_lo: u8 at 805306368; // биты 0-7 → кнопки этажей 1-8
in btns_cab_hi: u8 at 805306369; // бит  0   → кнопка этажа 9

// ══ переменные состояния ════════════════════════════════════════════════════
var current_floor: u8 := 1; // текущий этаж кабины (обновляется read_floor_sensors)
var target_floor: u8 := 1; // целевой этаж (обновляется scan_floor/cabin_buttons)
var has_call: u8 := 0; // 1 = есть необработанный вызов

// ══ условия точного нахождения на этаже ════════════════════════════════════
// Оба датчика активны (бит 0 И бит 1) -> кабина в зоне точной остановки.
cond AtFloor1 = sensors_1.0 & sensors_1.1; // кабина на уровне 1-го этажа
cond AtFloor2 = sensors_2.0 & sensors_2.1; // кабина на уровне 2-го этажа
cond AtFloor3 = sensors_3.0 & sensors_3.1; // кабина на уровне 3-го этажа
cond AtFloor4 = sensors_4.0 & sensors_4.1; // кабина на уровне 4-го этажа
cond AtFloor5 = sensors_5.0 & sensors_5.1; // кабина на уровне 5-го этажа
cond AtFloor6 = sensors_6.0 & sensors_6.1; // кабина на уровне 6-го этажа
cond AtFloor7 = sensors_7.0 & sensors_7.1; // кабина на уровне 7-го этажа
cond AtFloor8 = sensors_8.0 & sensors_8.1; // кабина на уровне 8-го этажа
cond AtFloor9 = sensors_9.0 & sensors_9.1; // кабина на уровне 9-го этажа

// ══ условия управления движением ════════════════════════════════════════════
cond Occupied = sensors_cab.0; // бит 0: в кабине есть пассажир
cond Overloaded = sensors_cab.1; // бит 1: превышена грузоподъёмность
cond AtTarget = current_floor = target_floor; // кабина уже на целевом этаже
cond NeedUp = current_floor < target_floor; // цель выше → движение вверх
cond NeedDown = current_floor > target_floor; // цель ниже → движение вниз
cond HasCall = has_call = 1; // есть необработанный вызов

// Начать движение: есть вызов И кабина не на целевом этаже
cond ShouldMove = HasCall & !AtTarget;

// ══ внешние функции управления аппаратурой ══════════════════════════════════
extern fn motor_up();
// включить двигатель на подъём
extern fn motor_down();
// включить двигатель на спуск
extern fn motor_stop();
// отключить двигатель (торможение)
extern fn door_open();
// открыть двери кабины
extern fn door_close();
// закрыть двери кабины

// Читает sensors_N.0 и sensors_N.1 для каждого этажа N;
// устанавливает current_floor = N, когда оба бита активны.
extern fn read_floor_sensors();

// Читает биты btns_floor_N.0 (вверх) и btns_floor_N.1 (вниз) для всех этажей;
// обновляет target_floor и has_call. Работает всегда, независимо от кабины.
extern fn scan_floor_buttons();

// Читает btns_cab_lo (биты 0-7 -> этажи 1-8) и btns_cab_hi (бит 0 -> этаж 9);
// обновляет target_floor и has_call.
// Вызывается только при sensors_cab.0 = 1 (пассажир в кабине).
extern fn scan_cabin_buttons();

enum Floor {
    Bottom = 80,
    Top
}

// ══ модель лифта ════════════════════════════════════════════════════════════
model Engine {
    enum Action {
        Idle = 670,
        Closing
    }
    // ── Idle: двери открыты, ожидание вызова ──────────────────────────────
    // Каждый такт:
    //   1. Опрашиваем кнопки вызова на этажах (всегда).
    //   2. Опрашиваем кнопки кабины только если sensors_cab.0 (пассажир есть):
    //      пустая кабина не может самостоятельно задать целевой этаж.
    // При появлении нового вызова на другой этаж (ShouldMove) закрываем двери.
    start Idle {
        ref DoorClosing: ShouldMove;
        enter {
            door_open();
        }
        always {
            scan_floor_buttons();
            if sensors_cab.0 {
                scan_cabin_buttons();
            }
        }
    }

    // ── DoorClosing: двери закрываются перед началом движения ─────────────
    // Перегрузка (sensors_cab.1) или совпадение этажей прерывают закрытие.
    // Иначе автомат выбирает направление и переходит в MovingUp/MovingDown.
    state DoorClosing {
        ref Idle: Overloaded | AtTarget;
        // перегрузка или вызов снят
        ref MovingUp: !Overloaded & NeedUp;
        // цель выше - ехать вверх
        ref MovingDown: !Overloaded & NeedDown;
        // цель ниже - ехать вниз
        always {
            door_close();
        }
    }

    // ── MovingUp: подъём кабины ───────────────────────────────────────────
    // read_floor_sensors() считывает sensors_N.0 и sensors_N.1 и обновляет
    // current_floor. Как только датчики целевого этажа оба активны (AtTarget),
    // автомат переходит к открытию дверей.
    // Попутные вызовы принимаются через scan_floor_buttons / scan_cabin_buttons.
    state MovingUp {
        ref DoorOpening: AtTarget;
        always {
            motor_up();
            read_floor_sensors();
            scan_floor_buttons();
            if sensors_cab.0 {
                scan_cabin_buttons();
            }
        }
    }

    // ── MovingDown: спуск кабины ──────────────────────────────────────────
    state MovingDown {
        ref DoorOpening: AtTarget;
        always {
            motor_down();
            read_floor_sensors();
            scan_floor_buttons();
            if sensors_cab.0 {
                scan_cabin_buttons();
            }
        }
    }

    // ── DoorOpening: прибытие - останов, открытие дверей, сброс вызова ────
    state DoorOpening {
        next Idle;
        enter {
            motor_stop();
            door_open();
            has_call := 0;
        }
    }
    var action: Action := Closing;
}
start Main = Engine {
    next Middle;
}
state Middle = Engine + (Engine | Engine) + Engine + Engine + Engine {
    next End;
}
state End;
