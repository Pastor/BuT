// ПИД-регулятор (Пропорционально-Интегрально-Дифференциальный) на `float` —
// пример фичи. Самый распространённый закон управления.
//
// Представление чисел (фича, «прозрачный float»). Автор пишет `float`;
// представление выбирают флаги сборки, а не тип в исходнике:
//   цели `c`/`rust`/`st` (профиль с FPU) — нативный `double`/`f64`/`LREAL`;
//   встраиваемые `c-hal`/`st-at` (МК без FPU) — q через
//     `--float-embedded --float-as-q=8.8` (fixed-point q(8, 8));
//   цель `sv` (FPGA/ASIC, нативного float нет) — q через `--float-as-q=8.8`
//     (иначе `SV-003`); float→q(8,8) байт-в-байт равно явному q.
// Явный q(8, 8) как тип языка демонстрирует соседний `regulator.takt`.
//
// Теория. Непрерывный ПИД по рассогласованию err = target − meas:
//     ctrl = Kp·err + Ki·∫err dt + Kd·derr/dt
// Позиционная дискретная форма (такт = шаг, Ts = 1):
//     err[k]  = target − meas[k]
//     i_acc[k] = i_acc[k−1] + err[k]        (интеграл — сумма ошибок)
//     deriv[k] = err[k] − err_prev[k]       (производная — разность назад)
//     ctrl[k]  = Kp·err[k] + Ki·i_acc[k] + Kd·deriv[k]
// Замкнутый контур: объект 1-го порядка meas[k+1] = meas[k] + Kplant·ctrl[k] —
// контур самодостаточен (без внешних входов), проходит проверка достижимости 0030.
//
// ANTI-WINDUP. В q(m, n)-представлении (sv/встраиваемые) арифметика — перенос
// (wraparound), не насыщение; без ограничения интеграл i_acc переполнил бы q и
// «перевернулся» (+127 → −128) — регулятор стал бы неустойчивым. Поэтому i_acc
// ограничен [−Imax, Imax] условиями (насыщающего оператора в языке нет —
// кандидат на будущее). Для нативного float ограничение безвредно (широкий
// диапазон), но оставлено ради единой логики во всех представлениях.
//
// Имена не конфликтуют со стандартными фб IEC 61131-3 (идентификаторы IEC
// регистронезависимы): `integral`/`pv` заняты (FB INTEGRAL, вход PV), поэтому
// `i_acc`/`meas`.
//
// Обёрнут под-моделью (цель `c`: typedef корня); порт `ready` — наблюдаемая
// точка схождения контура, на неё смотрит тестбенч цели `sv` (не поднялся —
// `$error`). Тела написаны на переменных (не на литералах):
// литерал `float` в теле дал бы `SV-003` — литералы только в
// инициализаторах объявлений.
model Pid {
    // Бит 0 регистра статуса 0x600: «контур сошёлся» (инициализатор порта
    // задаёт адрес, а не начальное значение).
    out ready: bit at 0x600:0;

    // Контур управления.
    var target: float := 8.0; // уставка SP
    var meas: float := 0.0; // измерение PV (выход объекта)
    var i_acc: float := 0.0; // накопитель интеграла
    var err_prev: float := 0.0; // ошибка на прошлом такте (для производной)

    // Коэффициенты ПИД и объекта (дробные — потребитель дробной арифметики).
    var kp: float := 0.5; // пропорциональный
    var ki: float := 0.0625; // интегральный
    var kd: float := 0.25; // дифференциальный
    var kplant: float := 0.5; // усиление объекта

    // Пределы anti-windup и порог завершения.
    var imax: float := 32.0;
    var neg_imax: float := -32.0;
    var eps: float := 0.125;

    // Рабочие величины такта.
    var err: float := 0.0;
    var deriv: float := 0.0;
    var ctrl: float := 0.0;

    start Control {
        always {
            err := target - meas;
            i_acc := i_acc + err;
            if i_acc > imax {
                i_acc := imax;
            }
            if i_acc < neg_imax {
                i_acc := neg_imax;
            }
            deriv := err - err_prev;
            ctrl := kp * err + ki * i_acc + kd * deriv;
            meas := meas + kplant * ctrl;
            err_prev := err;
        }
        // Сошлись: err мало (порог > шага квантования, иначе предельный цикл).
        ref Settled: err < eps;
    }
    // Доводим точно до уставки.
    state Settled {
        always {
            meas := target;
        }
        ref Done;
    }
    // Установившееся состояние: флаг готовности.
    state Done {
        always {
            ready := 1;
        }
    }
}

start Main = Pid;
