// Технологический цикл из трёх фаз - пример последовательной композиции `+`.
//
// Дозирование -> перемешивание -> слив. Каждая фаза - своя модель; фазы идут
// Одна за другой, и следующая начинается только после того, как предыдущая
// пришла в терминальное состояние:
//
//     start Cycle = Dose + Mix + Drain { next Done; }
//
// Это и есть смысл `+` (в отличие от `|`, где ветви работают одновременно).
// Переход `next` берётся не по условию, а по завершению всей цепочки.
//
// Фазы наблюдаемы снаружи через общую переменную `stage` (1, 2, 3): каждая
// фаза держит её своим номером, пока активна. Так по трассе видно, что цикл
// прошёл все три этапа по порядку, а не проскочил их.
//
// Имена. Порт и состояние не должны называться одинаково: цель `c`
// печатает и битовые порты, и состояния перечислениями, а перечислители в C
// делят область видимости - совпадение имён даёт `redefinition of enumerator`.
// Поэтому завершающее состояние здесь `Done`, а не `Ready`. По той же причине
// счётчики фаз названы по-разному (`dosed`/`stirred`/`drained`): одинаковое имя
// в трёх моделях сделало бы голое обращение к нему неоднозначным.
//
// Выходной порт `ready` - наблюдаемая точка завершения цикла: на него смотрит
// тестбенч цели `sv` (не поднялся - `$error`), причём вместе с порядком фаз.
// Бит 0 регистра статуса 0x600: цикл завершён. Инициализатор порта задаёт
// Адрес, а не начальное значение.
out ready: bit at 0x600:0;
// Номер активной фазы - общая переменная, её пишут все три под-модели.
var stage: u8 := 0;

// Фаза 1: дозирование. Набираем три порции и закрываем клапан.
model Dose {
    var dosed: u8 := 0;

    start Fill {
        always {
            stage := 1;
            dosed := dosed + 1;
        }
        ref Full: dosed >= 3;
    }
    // Терминальное состояние фазы: его достижение и означает "фаза закончена".
    state Full;
}

// Фаза 2: перемешивание.
model Mix {
    var stirred: u8 := 0;

    start Stir {
        always {
            stage := 2;
            stirred := stirred + 1;
        }
        ref Blended: stirred >= 2;
    }
    state Blended;
}

// Фаза 3: слив.
model Drain {
    var drained: u8 := 0;

    start Empty {
        always {
            stage := 3;
            drained := drained + 1;
        }
        ref Dry: drained >= 2;
    }
    state Dry;
}

// Цепочка фаз. `next Done` срабатывает, когда отработал последний шаг.
start Cycle = Dose + Mix + Drain {
    next Done;
}

// Цикл завершён: поднимаем готовность. Переходов нет - состояние терминальное.
state Done {
    always {
        ready := 1;
    }
}
