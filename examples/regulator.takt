// Пропорциональный регулятор на fixed-point q(8, 8) - пример фичи.
//
// Типовой потребитель дробной арифметики на FPGA/МК: подтягивает измеряемую
// величину `value` к уставке `setpoint` шагами, пропорциональными рассогласованию
// (`value += half · (setpoint − value)`). Демонстрирует q-арифметику `+`, `−`,
// `*` (умножение - суть fixed-point, floor к −∞) и сравнение q в условии ребра.
//
// Сценарий без входных данных (для проверки достижимости): регулятор сходится
// сам и завершается - Adjust -> Settled -> Done.
//
// Обёрнут под-моделью (`start Main = Regulator`): модель без под-моделей не даёт
// typedef корня в цели `c`. Выходной порт `ready` - наблюдаемая
// точка завершения: на него смотрит тестбенч цели `sv` (не поднялся - `$error`),
// а проверке `sv-mmio` этот пример нужен как единственный, у которого все порты
// выходные (шине писать некуда - фича). Снимать порт нельзя: оба проверки
// покраснеют.
model Regulator {
    // Бит 0 регистра статуса 0x600: "уставка достигнута" (адрес - из карты
    // регистров устройства; инициализатор порта задаёт адрес, а не значение).
    out ready: bit at 0x600:0;

    // Формат q(8, 8): 8 целых бит (со знаком), 8 дробных. Представимо v·2⁻⁸.
    var setpoint: q(8, 8) := 10.0; // уставка
    var value: q(8, 8) := 0.0; // регулируемая величина
    var half: q(8, 8) := 0.5; // коэффициент пропорциональности Kp
    var near: q(8, 8) := 9.5; // порог «достаточно близко»

    // Каждый такт: value += Kp · (setpoint − value). Сходится к setpoint.
    start Adjust {
        always {
            value := value + (setpoint - value) * half;
        }
        ref Settled: value >= near;
    }
    // Близко - доводим точно до уставки.
    state Settled {
        always {
            value := setpoint;
        }
        ref Done;
    }
    // Установившееся состояние: поднимаем флаг готовности.
    state Done {
        always {
            ready := 1;
        }
    }
}

start Main = Regulator;
