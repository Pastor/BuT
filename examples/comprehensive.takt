/// Всесторонний пример: демонстрирует возможности языка Takt.
///
/// Модель - контроллер термоциклирования испытательной камеры: прогреть объект
/// до MAX_TEMP, охладить до нуля, повторить MAX_COUNT раз, завершить работу.
/// Заявленный сценарий: Idle -> Heating -> Cooling -> ... MAX_COUNT раз -> Done;
/// он проверяется прогоном (`takt-sim/tests/sim/examples_scenario_tests.rs`).
///
/// Использует: переменные, константы, перечисления, внешние функции,
/// условные операторы (if/else), циклы (loop, for, while), вызовы функций,
/// именованные условия (cond), состояния (start/state), оператор match.

/// Перечисление режимов работы
enum Mode {
    Auto = 0,
    Manual = 1,
    Emergency = 2
}

/// Внешние функции платформенного слоя
extern fn log_temp(value: u8);
extern fn log_count(n: u8);

/// Модель контроллера термоциклирования
model Controller {
    var temperature: u8 := 0;
    var count: u8 := 0;
    var mode: Mode := Auto;
    const MAX_TEMP: u8 := 100;
    const MAX_COUNT: u8 := 3;
    const HEAT_STEP: u8 := 8;
    const COOL_STEP: u8 := 3;
    const WARMUP_TEMP: u8 := 10;

    /// Объект прогрет до порога - пора охлаждать
    cond Overheated = temperature >= MAX_TEMP;
    /// Объект охлаждён до нуля - цикл завершён
    cond Cooled = temperature = 0;
    /// Программа испытаний выполнена
    cond CyclesDone = count >= MAX_COUNT;

    /// Ограничивает значение сверху порогом MAX_TEMP
    fn clamp_temp(value: u8) -> u8 {
        if value > MAX_TEMP {
            return MAX_TEMP;
        }
        return value;
    }

    /// Увеличивает счётчик циклов на 1
    fn increment(n: u8) -> u8 {
        return n + 1;
    }

    /// Телеметрия: сколько ступеней нагрева осталось до порога
    fn steps_to_limit(value: u8) -> u8 {
        var remaining: u8 := 0;
        var v: u8 := value;
        while v < MAX_TEMP {
            v := v + HEAT_STEP;
            remaining := remaining + 1;
        }
        return remaining;
    }

    /// Телеметрия: сколько ступеней охлаждения осталось до нуля (loop == while)
    fn steps_to_zero(value: u8) -> u8 {
        var remaining: u8 := 0;
        var v: u8 := value;
        loop v > 0 {
            if v > COOL_STEP {
                v := v - COOL_STEP;
            } else {
                v := 0;
            }
            remaining := remaining + 1;
        }
        return remaining;
    }

    /// Начальное состояние: подготовка камеры - прогрев до рабочего порога.
    /// Выход считает начатый цикл испытаний.
    start Idle {
        enter {
            temperature := 0;
        }
        always {
            var delta: u8 := 1;
            temperature := temperature + delta;
            log_temp(temperature);
        }
        exit {
            count := increment(count);
        }
        ref Heating: temperature > WARMUP_TEMP;
    }

    /// Состояние нагрева - демонстрация while (в телеметрии) и match
    state Heating {
        always {
            temperature := clamp_temp(temperature + HEAT_STEP);
            match mode {
                Auto => {
                    log_count(steps_to_limit(temperature));
                }
                Manual => {
                    log_temp(temperature);
                }
                _ => {
                    mode := Auto;
                }
            }
        }
        ref Cooling: Overheated;
    }

    /// Состояние охлаждения - удерживает управление до конца охлаждения
    state Cooling {
        always {
            for var i: u8 := 0; i < COOL_STEP; i := i + 1 {
                if temperature > 0 {
                    temperature := temperature - 1;
                }
            }
            log_count(steps_to_zero(temperature));
        }
        ref Done: Cooled & CyclesDone;
        ref Idle: Cooled & !CyclesDone;
    }

    /// Конечное состояние - программа испытаний выполнена (нет переходов)
    state Done {
        enter {
            temperature := 0;
            count := 0;
        }
    }
}

start Entry = Controller;
