var x: u8 := 1;
var y: u8 := 2;
const ENABLED: bool := true;
struct Coord {
    x: [bit; 32],
    y: [bit; 32],
    z: [bit; 32]
}
const ORIGIN: Coord := {0, 0, 0};
enum Constant {
    X,
    Y,
    Z
}
out idle: bit at 0x44533932:1;
out work: bit at 0x44533932:2;
in wait: bit at 0x44533932:33;

fn is_collected(c: Constant, v: u8) -> bool {
    return (c = X && v = 1) || (c = Y && v = 2) || (x.2 = 0);
}

extern fn has_flag(v: bool) -> bool;

model A {
    start Start;
}
model B {
    start Start {
        always {
            if wait {
                work := 0;
                idle := 1;
            } else {
                idle := 0;
                work := 1;
            }
        }

        // Шаг цепочки обязан завершиться, чтобы передать ход дальше: состояние
        // с телом автомат не покидает само — оно стабильно, пока его не увели.
        next Done;
    }

    state Done;
}
model C {
    enum Point {
        Global,
        Local
    }
    model C1 {
        start Start {
            ref End: is_collected(Y, y) & is_collected(X, x) & has_flag(ENABLED);
        }
        state End;
    }
    model C2 {
        start Start;
    }
    start Start = C1 | C2 {
        next End;
    }
    state End;
}
model D {
    start Start;
}
model E {
    start Start = D + F {
        next End;
    }
    state End;
}
model F {
    start Start;
}
start Start = A + B + (C | D) + E {
    next Next;
    : E != End;
    : x > 0;
}
state Next = F;
