// Пропорциональный регулятор на прозрачном `float` — пример фичи.
//
// Тот же регулятор, что `regulator.takt`, но записан на `float`, а не на явном
// `q(8, 8)`. Демонстрирует «прозрачную» плавающую точку: автор пишет `float`, а
// представление выбирается флагами генерации, не текстом типа:
//   по умолчанию цели `c`/`rust`/`st` — нативный float (`double`/`f64`/`LREAL`);
//   `--float-embedded --float-as-q=m.n` — те же цели идут целочисленным `q(m,n)`
//     (embedded без FPU), побитово как `regulator.takt`;
//   `-t sv --float-as-q=m.n` — `float → q(m, n)`, синтезируемо (снятие `SV-003`).
//
// Тела — только на переменных (литерал `float` в теле не понижается в Q; паритет
// с явным `q` 0061). Сценарий без входов (проверка достижимости 0030): регулятор
// сходится сам и завершается — Adjust → Settled → Done.
//
// Обёрнут под-моделью (`start Main = FloatRegulator`): модель без под-моделей не
// даёт typedef корня в цели `c` (дефект 0026). Выходной порт `ready` держит
// паритет с `regulator.takt` — тот же регулятор, тот же наблюдаемый флаг
// готовности; проверкой порт здесь не удерживается (в цель `sv` пример без
// `--float-as-q` не транслируется вовсе — `SV-003`, а контракт сценария
// проверяет цепочку состояний).
model FloatRegulator {
    // Бит 0 регистра статуса 0x600: «уставка достигнута» (инициализатор порта
    // задаёт адрес, а не начальное значение).
    out ready: bit at 0x600:0;

    var setpoint: float := 10.0; // уставка
    var value: float := 0.0; // регулируемая величина
    var half: float := 0.5; // коэффициент пропорциональности Kp
    var near: float := 9.5; // порог «достаточно близко»

    // Каждый такт: value += Kp · (setpoint − value). Сходится к setpoint.
    start Adjust {
        always {
            value := value + (setpoint - value) * half;
        }
        ref Settled: value >= near;
    }
    // Близко — доводим точно до уставки.
    state Settled {
        always {
            value := setpoint;
        }
        ref Done;
    }
    // Установившееся состояние: поднимаем флаг готовности.
    state Done {
        always {
            ready := 1;
        }
    }
}

start Main = FloatRegulator;
