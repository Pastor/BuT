// Автоматизированный штабелятор (стэкер/штабелятор-укладчик)
//
// Параметры склада:
//   - 10 штабелей (ось X, номера 1–10)
//   - 10 рядов в каждом штабеле (ось Z, высота, номера 1–10)
//   - 20 секций в каждом штабеле (ось Y, глубина, номера 1–20)
//   - Проходной склад: приёмка с торца X=0, отгрузка с торца X=11
//   - Зона подзарядки при простое: X=0, Z=0, Y=0
//
// Тип задания (task_type):
//   0 — Приёмка: забрать паллет из зоны приёмки, уложить в ячейку [stack,row,section]
//   1 — Отгрузка: забрать паллет из ячейки [stack,row,section], доставить в зону выдачи
//
// Алгоритм кратчайшего пути:
//   Штабелятор движется по трём осям одновременно (X, Y, Z независимо).
//   Время прибытия определяется Чебышёвским расстоянием:
//       time = max(|Δstack|, |Δrow|, |Δsection|)
//
// Архитектура — три параллельные модели:
//   CommandReceiver    — приём и регистрация задания от сус
//   MovementController — исполнение задания: управление двигателями перемещения
//   LiftController     — управление подъёмником (вилами)
//
// Внутренний интерфейс между моделями (координационные переменные):
//   lift_request: MovementController запрашивает операцию вилами
//   lift_op:      тип операции (0=захват, 1=укладка/выдача)
//   lift_done:    LiftController подтверждает завершение операции

// ─── Константы ────────────────────────────────────────────────────────────────
const STACK_COUNT: u8 := 10;
const ROW_COUNT: u8 := 10;
const SECTION_COUNT: u8 := 20;

// Зона зарядки (вне рабочего пространства)
const CHARGE_STACK: u8 := 0;
const CHARGE_ROW: u8 := 0;
const CHARGE_SECTION: u8 := 0;

// Зона приёмки (один торец проходного склада)
const PICKUP_STACK: u8 := 0;
const PICKUP_ROW: u8 := 1;
const PICKUP_SECTION: u8 := 1;

// Зона выдачи (другой торец проходного склада)
const DROPOFF_STACK: u8 := 11;
const DROPOFF_ROW: u8 := 1;
const DROPOFF_SECTION: u8 := 1;

// ─── Входные порты (датчики и интерфейс сус) ──────────────────────────────────

// Задание от системы управления складом (WMS)
in task_valid: bit at 0x100:0; // новое задание готово к приёму
in task_type: bit at 0x101:0; // 0=приёмка, 1=отгрузка
in task_stack_no: u8 at 0x102:0; // номер штабеля задания (1–10)
in task_row_no: u8 at 0x103:0; // номер ряда задания (1–10)
in task_section_no: u8 at 0x104:0; // номер секции задания (1–20)

// Датчики положения (энкодеры / лазерные метки)
in pos_stack: u8 at 0x200:0; // текущий штабель
in pos_row: u8 at 0x201:0; // текущий ряд
in pos_section: u8 at 0x202:0; // текущая секция

// Датчики состояния
in sense_loaded: bit at 0x300:0; // груз на вилах
in sense_at_charge: bit at 0x301:0; // в зоне зарядки
in sense_battery_low: bit at 0x302:0; // заряд ниже порога

// ─── Выходные порты (управление приводами) ────────────────────────────────────
out cmd_target_stack: u8 at 0x400:0; // целевой штабель
out cmd_target_row: u8 at 0x401:0; // целевой ряд
out cmd_target_section: u8 at 0x402:0; // целевая секция
out cmd_fork: bit at 0x500:0; // 1=выдвинуть вилы, 0=убрать вилы
out cmd_ack: bit at 0x600:0; // подтверждение приёма задания
out cmd_done: bit at 0x601:0; // задание выполнено

// ─── Рабочие переменные ───────────────────────────────────────────────────────
var tgt_stack: u8 := 0; // параметры текущего задания
var tgt_row: u8 := 0;
var tgt_section: u8 := 0;
var tgt_type: bit := 0; // тип: 0=приёмка, 1=отгрузка
var busy: bit := 0; // флаг активного задания
var eta: u8 := 0; // расчётное время прибытия к цели (в тактах)

// ─── Координационные переменные (внутренний интерфейс между моделями) ─────────
var lift_request: bit := 0; // запрос операции вилами (MovementController → LiftController)
var lift_op: bit := 0; // тип операции: 0=захват (ждём Loaded), 1=укладка (ждём Unloaded)
var lift_done: bit := 0; // подтверждение завершения (LiftController → MovementController)

// ─── Функции поиска кратчайшего пути ─────────────────────────────────────────
//
// Штабелятор движется по всем трём осям одновременно и независимо.
// Метрика кратчайшего пути — расстояние Чебышёва:
//
//     time = max( |Δstack|, |Δrow|, |Δsection| )
//
// Т.е. время определяется самой длинной из трёх проекций траектории.

// Абсолютная разность двух u8-значений.
fn abs_diff(a: u8, b: u8) -> u8 {
    if a > b {
        return a - b;
    }
    return b - a;
}

// Максимум из двух u8-значений.
fn max2(a: u8, b: u8) -> u8 {
    if a > b {
        return a;
    }
    return b;
}

// Время движения от текущей позиции (pos_stack, pos_row, pos_section)
// до целевой ячейки. Возвращает число тактов по метрике Чебышёва.
fn travel_time(to_stack: u8, to_row: u8, to_section: u8) -> u8 {
    var ds: u8 := 0;
    var dr: u8 := 0;
    var dy: u8 := 0;
    var t: u8 := 0;
    if pos_stack > to_stack {
        ds := pos_stack - to_stack;
    } else {
        ds := to_stack - pos_stack;
    }
    if pos_row > to_row {
        dr := pos_row - to_row;
    } else {
        dr := to_row - pos_row;
    }
    if pos_section > to_section {
        dy := pos_section - to_section;
    } else {
        dy := to_section - pos_section;
    }
    t := ds;
    if dr > t {
        t := dr;
    }
    if dy > t {
        t := dy;
    }
    return t;
}

// ─── Условия переходов ────────────────────────────────────────────────────────
cond AtTgtStack = pos_stack = tgt_stack;
cond AtTgtRow = pos_row = tgt_row;
cond AtTgtSection = pos_section = tgt_section;
cond AtTarget = AtTgtStack & AtTgtRow & AtTgtSection;

cond AtPickup = pos_stack = PICKUP_STACK & pos_row = PICKUP_ROW & pos_section = PICKUP_SECTION;

cond AtDropoff = pos_stack = DROPOFF_STACK & pos_row = DROPOFF_ROW & pos_section = DROPOFF_SECTION;

cond AtChargeZone = sense_at_charge;

cond IsInbound = !tgt_type;
cond IsOutbound = tgt_type;
cond Loaded = sense_loaded;
cond Unloaded = !sense_loaded;
cond Charged = !sense_battery_low;

// ─── Модель 1: Приём команды ──────────────────────────────────────────────────
//
// Отслеживает поступление задания от сус и фиксирует принятие на исполнение.
// Устанавливает cmd_ack=1 в момент приёма, сохраняет параметры в tgt_*.
// Переходит в TaskActive (busy=1) до момента завершения задания (busy→0).
model CommandReceiver {
    // Ожидание нового задания (батарея достаточно заряжена)
    start WaitingForTask {
        enter {
            cmd_ack := 0;
        }
        ref AcceptingTask: task_valid & !busy & !sense_battery_low;
    }

    // Фиксация задания: сохранение параметров, вычисление ETA, подтверждение приёма (cmd_ack=1)
    state AcceptingTask {
        enter {
            tgt_stack := task_stack_no;
            tgt_row := task_row_no;
            tgt_section := task_section_no;
            tgt_type := task_type;
            eta := travel_time(task_stack_no, task_row_no, task_section_no);
            busy := 1;
            cmd_ack := 1;
        }
        next TaskActive;
    }

    // Задание принято к исполнению; ждём завершения (busy опускает MovementController)
    state TaskActive {
        enter {
            cmd_ack := 0;
        }
        ref WaitingForTask: !busy;
    }
}

// ─── Модель 2: Исполнение команды — двигатели перемещения ─────────────────────
//
// Управляет целевыми координатами (cmd_target_*) по трём осям.
// На каждом этапе, требующем операции вилами, выставляет lift_request и ждёт
// lift_done от LiftController перед переходом к следующему движению.
// При разряде батареи прерывает задание и уходит на аварийную зарядку.
model MovementController {
    // Простой у зарядки, ожидание задания
    start MovementIdle {
        enter {
            cmd_target_stack := CHARGE_STACK;
            cmd_target_row := CHARGE_ROW;
            cmd_target_section := CHARGE_SECTION;
            cmd_done := 0;
        }
        ref DispatchMove: busy & Charged;
    }

    // Диспетчеризация: выбор ветки по типу задания
    state DispatchMove {
        ref MovingToPickup: IsInbound;
        ref MovingToStorage: IsOutbound;
    }

    // ── Ветка приёмка (in-bound): получить паллет → уложить в ячейку ──────────

    // Движение к зоне приёмки (все три оси одновременно)
    state MovingToPickup {
        enter {
            cmd_target_stack := PICKUP_STACK;
            cmd_target_row := PICKUP_ROW;
            cmd_target_section := PICKUP_SECTION;
        }
        ref WaitingForkAtPickup: AtPickup;
        ref EmergencyCharge: sense_battery_low;
    }

    // Ожидание захвата паллета на приёмке (запрос к LiftController, op=захват)
    state WaitingForkAtPickup {
        enter {
            lift_request := 1;
            lift_op := 0;
        }
        ref MovingToCell: lift_done;
    }

    // Движение к целевой ячейке хранения
    state MovingToCell {
        enter {
            lift_request := 0;
            lift_done := 0;
            cmd_target_stack := tgt_stack;
            cmd_target_row := tgt_row;
            cmd_target_section := tgt_section;
        }
        ref WaitingForkAtCell: AtTarget;
        ref EmergencyCharge: sense_battery_low;
    }

    // Ожидание укладки паллета в ячейку (запрос к LiftController, op=укладка)
    state WaitingForkAtCell {
        enter {
            lift_request := 1;
            lift_op := 1;
        }
        ref TaskCompleting: lift_done;
    }

    // ── Ветка отгрузка (out-bound): забрать из ячейки → доставить в зону выдачи

    // Движение к ячейке хранения
    state MovingToStorage {
        enter {
            lift_request := 0;
            lift_done := 0;
            cmd_target_stack := tgt_stack;
            cmd_target_row := tgt_row;
            cmd_target_section := tgt_section;
        }
        ref WaitingForkAtStorage: AtTarget;
        ref EmergencyCharge: sense_battery_low;
    }

    // Ожидание захвата паллета из ячейки (запрос к LiftController, op=захват)
    state WaitingForkAtStorage {
        enter {
            lift_request := 1;
            lift_op := 0;
        }
        ref MovingToDropoff: lift_done;
    }

    // Движение к зоне выдачи
    state MovingToDropoff {
        enter {
            lift_request := 0;
            lift_done := 0;
            cmd_target_stack := DROPOFF_STACK;
            cmd_target_row := DROPOFF_ROW;
            cmd_target_section := DROPOFF_SECTION;
        }
        ref WaitingForkAtDropoff: AtDropoff;
        ref EmergencyCharge: sense_battery_low;
    }

    // Ожидание передачи паллета в зону выдачи (запрос к LiftController, op=укладка)
    state WaitingForkAtDropoff {
        enter {
            lift_request := 1;
            lift_op := 1;
        }
        ref TaskCompleting: lift_done;
    }

    // ── Завершение задания ─────────────────────────────────────────────────────
    state TaskCompleting {
        enter {
            lift_request := 0;
            lift_done := 0;
            busy := 0;
            cmd_done := 1;
        }
        always {
            cmd_done := 0;
        }
        next MovementIdle;
    }

    // ── Аварийный возврат на зарядку ───────────────────────────────────────────
    // Прерывает текущее задание; Сус повторно выдаёт задание после зарядки.
    state EmergencyCharge {
        enter {
            cmd_target_stack := CHARGE_STACK;
            cmd_target_row := CHARGE_ROW;
            cmd_target_section := CHARGE_SECTION;
            lift_request := 0;
            lift_done := 0;
            cmd_ack := 0;
            cmd_done := 0;
            busy := 0;
        }
        ref MovementIdle: sense_at_charge;
    }
}

// ─── Модель 3: Управление подъёмником ─────────────────────────────────────────
//
// Реагирует на запросы от MovementController через lift_request/lift_op.
// Выдвигает вилы (cmd_fork=1), ожидает целевого состояния груза,
// убирает вилы и выставляет lift_done. При отмене lift_request немедленно
// убирает вилы и возвращается в простой.
model LiftController {
    // Вилы убраны, ожидание запроса
    start LiftIdle {
        enter {
            cmd_fork := 0;
        }
        ref LiftOperating: lift_request;
    }

    // Вилы выдвинуты, ожидание целевого состояния груза
    state LiftOperating {
        enter {
            cmd_fork := 1;
        }
        ref LiftDone: lift_request & !lift_op & Loaded;
        // захват: паллет на вилах
        ref LiftDone: lift_request & lift_op & Unloaded;
        // укладка/выдача: вилы свободны
        ref LiftIdle: !lift_request;
    }
    // отмена запроса (напр. аварийная зарядка)

    // Операция завершена: убрать вилы, уведомить MovementController
    state LiftDone {
        enter {
            cmd_fork := 0;
            lift_done := 1;
        }
        ref LiftIdle: !lift_request;
    }
}

// ─── Параллельная композиция ──────────────────────────────────────────────────
start Stacker = CommandReceiver | MovementController | LiftController;
