// Библиотека: закон ПИД-регулирования, пригодный для любого объекта.
// Наружу выведен только протокол контура — три величины. (1)
var target: float := 40.0; // уставка: чего добиваемся
var meas: float := 0.0; // измерение: что сообщает датчик
var ctrl: float := 0.0; // воздействие: что подаём на привод

model Pid {
    out ready: bit; // контур сошёлся

    // Настройка объявлена параметрами: значения по умолчанию годятся для
    // типовой установки, а применение вправе задать свои при инстанцировании,
    // не правя библиотеку. (2)
    parameter kp: float := 0.5;
    parameter ki: float := 0.0625;
    parameter kd: float := 0.25;
    parameter imax: float := 32.0;
    parameter neg_imax: float := -32.0;
    parameter eps: float := 0.5;

    // Рабочие величины — устройство регулятора, а не его настройка.
    var err: float := 0.0;
    var err_prev: float := 0.0;
    var i_acc: float := 0.0;
    var deriv: float := 0.0;

    start Control {
        always {
            err := target - meas;
            i_acc := i_acc + err;
            if i_acc > imax {
                i_acc := imax;
            }
            if i_acc < neg_imax {
                i_acc := neg_imax;
            }
            deriv := err - err_prev;
            ctrl := kp * err + ki * i_acc + kd * deriv;
            err_prev := err;
        }
        // ограничение накопителя (3)
        ref Settled: err < eps;
    }

    state Settled {
        enter {
            ctrl := 0.0;
            ready := 1;
        }
        ref Done;
    }

    state Done;
}

start Main = Pid;
