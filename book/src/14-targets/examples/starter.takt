// Магнитный пускатель двигателя: кнопки "Пуск"/"Стоп" с самоблокировкой.
// Пуск включает двигатель и удерживает его; Стоп выключает.
in start_btn: bit at 0x40000000:0; // кнопка «Пуск»  (бит 0 входного регистра)
in stop_btn: bit at 0x40000000:1; // кнопка «Стоп» (бит 1)
out motor: bit at 0x40000004:0; // силовой контактор

var ticks: u8 := 0; // счётчик тактов прошивки (только для цели C)
var idle_ticks: u8 := 0; // сколько тактов простояли в «Выключено»

// Вставка уровня модели: исполняется каждый такт, как блок `always` того же
// уровня, и попадает только в вывод целей `c` и `c-hal`.
assembly "c" {
    ticks := ticks + 1;
}

start Off {
    enter {
        motor := 0;
    }

    // Вставка уровня состояния: работает, пока автомат здесь.
    assembly "c" {
        idle_ticks := idle_ticks + 1;
    }

    ref Running: start_btn = 1;
}

state Running {
    enter {
        motor := 1;
    }
    // самоблокировка: держим, пока не нажат "Стоп"
    ref Off: stop_btn = 1;
}
