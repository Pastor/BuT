// Вытяжной вентилятор с выбегом: пока горит свет - вентилятор работает; когда
// свет выключили, он крутится ещё три минуты, вытягивая остаточную влажность.
// Повторное включение света в любой момент возвращает модель в рабочий режим.
model Fan {
    clock 1kHz; // такт устройства — 1 мс: длительности пересчитываются в такты (1)

    const OVERRUN := 3m; // выдержка выбега — одно место правки (5)

    in light: bit; // датчик: включён ли свет в помещении
    out motor: bit; // привод вентилятора

    // Свет выключен, вентилятор стоит - ждём включения.
    start Idle {
        enter {
            motor := 0;
        }
        ref Working: light = 1;
    }

    // Свет горит: вентилятор работает, пока его не выключат.
    state Working {
        enter {
            motor := 1;
        }
        ref Overrun: light = 0;
    }

    // Свет выключили: держим вентилятор ещё три минуты, затем останавливаемся.
    // Отсчёт идёт от входа в это состояние (2); если свет включили снова,
    // выдержка отменяется переходом обратно в Working (3).
    state Overrun {
        ref Working: light = 1;
        ref Idle: after OVERRUN;
    }
}
// (4)
start Main = Fan;
