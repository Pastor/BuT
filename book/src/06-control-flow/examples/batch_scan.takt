// Обход партии: контроллер проверяет ячейки по очереди, пропускает
// пустые и останавливается на первой негодной.
//
// Пример показывает все формы управления телом блока: цикл со
// счётчиком, цикл без условия, пропуск шага, досрочный выход и
// разбор случаев.
model BatchScan {
    in cell_ok: bit;
    out reject: bit;

    var cells: [u8; 4] := {1, 0, 3, 0};
    var index: u8 := 0;
    var checked: u8 := 0;
    var mode: u8 := 0;

    start Scan {
        always {
            // Обход начинается заново каждый такт.
            checked := 0;
            index := 0;

            // Цикл со счётчиком: инициализатор, условие, шаг.
            for var i: u8 := 0; i < 4; i := i + 1 {
                // Пустая ячейка шага не стоит - пропускаем.
                if cells[i] = 0 {
                    continue;
                }
                checked := checked + 1;
            }

            // Цикл без условия: выход по `break`.
            loop {
                index := index + 1;
                if index >= 4 {
                    break;
                }
            }

            // Разбор случаев: ветвь по умолчанию обязательна, когда
            // перечислены не все значения.
            match mode {
                0 => {
                    reject := 0;
                }
                1, 2 => {
                    reject := 1;
                }
                _ => {
                    mode := 0;
                }
            }

            // Обязательство прямо в теле: проверяется на каждом такте.
            : checked <= 4;
        }

        ref Done: checked > 0 & cell_ok = 1;
    }

    state Done {
        enter {
            reject := 0;
        }
    }
}

start Main = BatchScan;
