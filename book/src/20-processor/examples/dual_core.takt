// Ступень 4: Два ядра на общей шине памяти.
//
// Ядро — модель, а не «весь процессор», поэтому ядер может быть сколько угодно:
// каждое отличается лишь номером (`id`) и началом своей области данных (`base`).
// Модели те же, что у ступеней 1–3, — из библиотеки; ступень задаёт сборку.
//
// Шина команд одна на обоих, и за неё они спорят: арбитр пускает на неё один
// запрос за раз и чередует ядра, чтобы никто не голодал. Сколько тактов каждое
// ядро простояло в ожидании, видно по счётчику `waits` арбитра.
//
// Программа у ядер общая (она в ПЗУ), а данные — свои: ядро 0 считает 7 * 5, ядро
// 1 — 7 * 3, поэтому и заканчивают они в разное время. Так одна программа над
// разными данными занимает два ядра — простейший вид многоядерной работы.
import {Op, Memory, Cache, Core, Arbiter, fetch_addr, fetch_req, fetch_op, fetch_arg, fetch_ready, arb_addr, arb_req, arb_op, arb_arg, arb_ready, bus_addr, bus_req, bus_op, bus_arg, bus_ready, data_addr, data_waddr, data_rdata, data_wdata, data_wen} from "machine_lib.takt";

start Machine = Core(id := 0, base := 0) | Core(id := 1, base := 4) | Cache(serves := 0, enabled := 1) | Cache(serves := 1, enabled := 1) | Arbiter | Memory(latency := 3);
