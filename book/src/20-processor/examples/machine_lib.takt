// Библиотека учебной машины: система команд, шины, память, кеш и ядро.
//
// Все ступени раздела подключают этот файл и отличаются только сборкой —
// составом композиции и значениями параметров. Копий моделей ни у одной ступени
// нет: то, что различается, выражено параметрами, а не вторым экземпляром текста.
//
// Протокол связи объявляет одна сторона — эта библиотека: подключение двух
// файлов строит два независимых дерева, и общей переменной между ними не
// возникает.

// ─── Линии ядер ──────────────────────────────────────────────────────────────
// У каждого ядра свои линии: индекс — номер ядра (`id`). Так одна и та же модель
// ядра множится сколько угодно раз, а её экземпляры не дерутся за общие имена.
//
// Число ядер здесь — 2, и это ограничение языка, а не замысла: размер массива
// обязан быть константой, параметром его не задать. Больше ядер — больше строк в
// объявлениях линий, сами модели не меняются.
//
// Флаги держим байтами (`[u8; 2]`), а не битовым вектором: массив бит в языке —
// упакованное представление, и здесь эта тема лишняя.

// Шина «ядро ↔ кеш»: у каждого ядра своя.
var fetch_addr: [u8; 2] := {0, 0}; // какую команду просит ядро
var fetch_req: [u8; 2] := {0, 0}; // запрос выставлен
var fetch_op: [u8; 2] := {0, 0}; // ответ: опкод
var fetch_arg: [u8; 2] := {0, 0}; // ответ: аргумент
var fetch_ready: [u8; 2] := {0, 0}; // ответ готов

// Шина «кеш ↔ арбитр»: тоже своя у каждого ядра — арбитр выбирает, чей запрос
// пустить на общую шину памяти.
var arb_addr: [u8; 2] := {0, 0};
var arb_req: [u8; 2] := {0, 0};
var arb_op: [u8; 2] := {0, 0};
var arb_arg: [u8; 2] := {0, 0};
var arb_ready: [u8; 2] := {0, 0};

// ─── общая шина памяти (шина кода) ───────────────────────────────────────────
// Она одна на всю машину: за неё и спорят ядра.
var bus_addr: u8 := 0;
var bus_req: bit := 0;
var bus_op: u8 := 0;
var bus_arg: u8 := 0;
var bus_ready: bit := 0;

// ─── Шина данных: у каждого ядра своя ────────────────────────────────────────
// Память данных двухпортовая (упрощение: спорят ядра только за команды), а
// область данных у каждого ядра своя — её начало задаёт параметр `base` ядра.
var data_addr: [u8; 2] := {0, 0}; // адрес чтения
var data_waddr: [u8; 2] := {0, 0}; // адрес записи — своя линия
var data_rdata: [u8; 2] := {0, 0};
var data_wdata: [u8; 2] := {0, 0};
var data_wen: [u8; 2] := {0, 0};

// Система команд учебной машины.
enum Op {
    Nop = 0,
    Lda = 1,
    Sta = 2,
    Add = 3,
    Sub = 4,
    Jnz = 5,
    Hlt = 6
}

// ─── Память: команды и данные ────────────────────────────────────────────────
model Memory {
    // Сколько тактов памяти нужно на ответ по шине кода. Настройка сборки:
    // быстрой памяти задают 0, медленной — 3, и модель при этом одна.
    parameter latency: u8 := 0;

    // Какую из двух программ исполнять: 0 — цикл, 1 — прямолинейная. Это тоже
    // настройка сборки: конвейерной ступени нужна программа без переходов.
    parameter prog_sel: u8 := 0;

    // Программа 0, «умножение сложением»: sum := x * n — складываем x n раз.
    //     0: LDA 0   ; acc := sum        4: SUB 3   ; acc -= 1
    //     1: ADD 1   ; acc += x          5: STA 2   ; n := acc
    //     2: STA 0   ; sum := acc        6: JNZ 0   ; пока n не ноль — на начало
    //     3: LDA 2   ; acc := n          7: HLT
    var loop_op: [u8; 8] := {1, 3, 2, 1, 4, 2, 5, 6};
    var loop_arg: [u8; 8] := {0, 1, 0, 2, 3, 2, 0, 0};

    // Программа 1, прямолинейная: sum := x + n + one — переходов в ней нет.
    //     0: LDA 1   ; acc := x          3: STA 0   ; sum := acc
    //     1: ADD 2   ; acc += n          4: HLT
    //     2: ADD 3   ; acc += one
    var line_op: [u8; 8] := {1, 3, 3, 2, 6, 0, 0, 0};
    var line_arg: [u8; 8] := {1, 2, 3, 0, 0, 0, 0, 0};

    // Данные: у каждого ядра своё окно из четырёх ячеек (начало задаёт `base`
    // ядра): 0 — накопитель, 1 — слагаемое, 2 — счётчик, 3 — единица.
    // Окно ядра 0: x = 7, n = 5 → 35. Окно ядра 1: x = 7, n = 3 → 21.
    var ram: [u8; 8] := {0, 7, 5, 1, 0, 7, 3, 1};

    var wait: u8 := 0; // сколько тактов ожидания осталось

    // Индекс массива в языке — литерал или имя, поэтому адреса портов сперва
    // перекладываются в отдельные переменные: `ram[data_addr[0]]` не записать.
    var raddr0: u8 := 0;
    var raddr1: u8 := 0;
    var waddr0: u8 := 0;
    var waddr1: u8 := 0;

    start Serve {
        // Шина кода — с ожиданием: пока такты не отсчитаны, ответа нет. Шина
        // данных быстрая: ответ тем же тактом (упрощение; кеш данных — упражнение).
        always {
            if bus_req = 1 {
                if wait > 0 {
                    wait := wait - 1;
                    bus_ready := 0;
                } else {
                    if prog_sel = 0 {
                        bus_op := loop_op[bus_addr];
                        bus_arg := loop_arg[bus_addr];
                    } else {
                        bus_op := line_op[bus_addr];
                        bus_arg := line_arg[bus_addr];
                    }
                    bus_ready := 1;
                }
            } else {
                wait := latency;
                bus_ready := 0;
            }
            raddr0 := data_addr[0];
            raddr1 := data_addr[1];
            waddr0 := data_waddr[0];
            waddr1 := data_waddr[1];
            if data_wen[0] = 1 {
                ram[waddr0] := data_wdata[0];
            }
            if data_wen[1] = 1 {
                ram[waddr1] := data_wdata[1];
            }
            data_rdata[0] := ram[raddr0];
            data_rdata[1] := ram[raddr1];
        }
        // Порт данных ядра 0 и порт данных ядра 1 — независимы.
        ref Serve;
    }
}

// ─── Кеш команд: у каждого ядра свой ─────────────────────────────────────────
model Cache {
    // Какое ядро обслуживает этот кеш: по номеру он выбирает его линии. Так
    // одна модель служит любому числу ядер — экземпляру довольно сказать, чей он.
    // Имя не `id`, чтобы не совпадать с параметром ядра: одноимённые объявления
    // разных моделей симулятор различает, но по голому имени адресует первое.
    parameter serves: u8 := 0;

    // Включён ли кеш. Выключенный ведёт себя как провод: каждый запрос идёт на
    // шину. Так одна модель служит и ступени «кеша нет», и ступени «кеш есть» —
    // разница в одном значении при сборке.
    parameter enabled: bit := 1;

    // Строка хранит одну команду: тег, признак заполненности и саму команду.
    // Строк столько же, сколько команд, поэтому вытеснения здесь не случается:
    // все промахи — «холодные», первого прохода. Что бывает, когда программа в
    // кеш не помещается, — упражнение раздела.
    var tags: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var valid: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var ops: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};
    var args: [u8; 8] := {0, 0, 0, 0, 0, 0, 0, 0};

    var want_addr: u8 := 0; // запрошенный адрес
    var idx: u8 := 0; // номер строки для него
    var want: u8 := 0; // тег, который обязан лежать в строке
    var hits: u8 := 0; // счётчик попаданий
    var misses: u8 := 0; // счётчик промахов

    start Lookup {
        // Адрес уходит арбитру заранее, ещё до решения «попадание или промах»:
        // при промахе ответ придёт быстрее. Попадание обслуживается прямо тут,
        // тем же тактом: за этим кеш и ставят. Промах стоит такта и уходит в Miss.
        always {
            want_addr := fetch_addr[serves];
            arb_addr[serves] := want_addr;
            idx := want_addr % 8;
            want := want_addr / 8;
            if enabled = 1 && fetch_req[serves] = 1 && valid[idx] = 1 && tags[idx] = want {
                fetch_op[serves] := ops[idx];
                fetch_arg[serves] := args[idx];
                fetch_ready[serves] := 1;
                hits := hits + 1;
            } else {
                fetch_ready[serves] := 0;
            }
        }
        ref Miss: fetch_req[serves] = 1 & enabled = 0;
        ref Miss: fetch_req[serves] = 1 & valid[idx] = 0;
        ref Miss: fetch_req[serves] = 1 & tags[idx] != want;
        ref Lookup;
    }

    // Промах: кеш просит арбитра и ждёт, а ядро ждёт кеша.
    state Miss {
        always {
            arb_req[serves] := 1;
            fetch_ready[serves] := 0;
        }
        ref Fill: arb_ready[serves] = 1;
        ref Miss;
    }

    // Ответ пришёл: строка заполняется (если кеш включён) и команда уходит ядру.
    state Fill {
        always {
            if enabled = 1 {
                ops[idx] := arb_op[serves];
                args[idx] := arb_arg[serves];
                tags[idx] := want;
                valid[idx] := 1;
            }
            fetch_op[serves] := arb_op[serves];
            fetch_arg[serves] := arb_arg[serves];
            fetch_ready[serves] := 1;
            misses := misses + 1;
            arb_req[serves] := 0;
        }
        ref Lookup;
    }
}

// ─── Арбитр общей шины памяти ────────────────────────────────────────────────
// Шина одна, мастеров может быть много. Арбитр пускает на неё один запрос за
// раз и чередует ядра, чтобы никто не голодал; сколько тактов каждое ядро
// простояло в ожидании, видно по счётчику `waits`.
model Arbiter {
    var owner: u8 := 0; // чей запрос сейчас на шине
    var last: u8 := 1; // кого обслуживали в прошлый раз
    var waits: [u8; 2] := {0, 0}; // такты ожидания каждого ядра

    start Free {
        always {
            bus_req := 0;
            arb_ready[0] := 0;
            arb_ready[1] := 0;
            if arb_req[0] = 1 && last = 1 {
                owner := 0;
            } else {
                if arb_req[1] = 1 {
                    owner := 1;
                } else {
                    owner := 0;
                }
            }
        }
        // Чередование: право первым получает тот, кого обслуживали не
        // последним. Иначе одно ядро могло бы занять шину навсегда.
        ref Grant: arb_req[0] = 1;
        ref Grant: arb_req[1] = 1;
        ref Free;
    }

    // Шина отдана одному: второй ядро ждёт и копит такты ожидания.
    state Grant {
        always {
            bus_addr := arb_addr[owner];
            bus_req := 1;
            if arb_req[0] = 1 && owner != 0 {
                waits[0] := waits[0] + 1;
            }
            if arb_req[1] = 1 && owner != 1 {
                waits[1] := waits[1] + 1;
            }
            if bus_ready = 1 {
                arb_op[owner] := bus_op;
                arb_arg[owner] := bus_arg;
                arb_ready[owner] := 1;
                last := owner;
            }
        }
        ref Free: bus_ready = 1;
        ref Free: arb_req[owner] = 0;
        ref Grant;
    }
}

// ─── Ядро: последовательный машинный цикл ────────────────────────────────────
model Core {
    // Номер ядра — по нему выбираются его линии; начало его области данных.
    // Два ядра одной модели отличаются только этими значениями.
    parameter id: u8 := 0;
    parameter base: u8 := 0;

    var pc: u8 := 0; // счётчик команд
    var acc: u8 := 0; // аккумулятор
    var op: u8 := 0; // текущий опкод
    var arg: u8 := 0; // текущий аргумент
    var next_pc: u8 := 0;

    // Выборка ждёт ответа: запрос снимается в том же такте, в котором ответ
    // принят, иначе кеш обслужит уже удовлетворённый запрос ещё раз.
    start Fetch {
        always {
            data_wen[id] := 0;
            if fetch_ready[id] = 1 {
                fetch_req[id] := 0;
            } else {
                fetch_addr[id] := pc;
                fetch_req[id] := 1;
            }
        }
        ref Decode: fetch_ready[id] = 1;
        ref Fetch;
    }

    // Команда пришла: разбираем и просим операнд по шине данных — ответ
    // понадобится уже следующим тактом. Адрес операнда — от начала своей области.
    state Decode {
        always {
            op := fetch_op[id];
            arg := fetch_arg[id];
            data_addr[id] := base + fetch_arg[id];
            next_pc := pc + 1;
        }
        ref Execute;
    }

    state Execute {
        always {
            match op {
                Lda => {
                    acc := data_rdata[id];
                }
                Sta => {
                    data_waddr[id] := base + arg;
                    data_wdata[id] := acc;
                    data_wen[id] := 1;
                }
                Add => {
                    acc := acc + data_rdata[id];
                }
                Sub => {
                    acc := acc - data_rdata[id];
                }
                Jnz => {
                    if acc != 0 {
                        next_pc := arg;
                    }
                }
                _ => {}
            }
            pc := next_pc;
        }
        ref Halted: op = Hlt;
        ref Fetch;
    }

    state Halted;
}

// ─── Конвейерное ядро: регистры между стадиями ───────────────────────────────
// Конвейерная ступень одноядерная: стадии подключены к общей шине напрямую, без
// кеша и арбитра (мастер один — делить нечего), а данные идут по линиям ядра 0.
var pipe_acc: u8 := 0; // аккумулятор конвейерного ядра

// IF/ID: что выбрала стадия выборки.
var if_op: u8 := 0;
var if_arg: u8 := 0;
var if_pc: u8 := 0;
var if_valid: bit := 0;

// ID/EX: что разобрала стадия декодирования.
var id_op: u8 := 0;
var id_arg: u8 := 0;
var id_pc: u8 := 0;
var id_valid: bit := 0;

// Что исполняется прямо сейчас — для наблюдения за занятостью стадий.
var ex_pc: u8 := 0;
var ex_valid: bit := 0;

// ─── Стадия 1: выборка ───────────────────────────────────────────────────────
model StageFetch {
    var pc: u8 := 0;

    start Run {
        // Сперва защёлкиваем ответ на запрос прошлого такта, затем просим
        // следующую команду: так стадия выдаёт по команде за такт. Переходов в
        // программе конвейерной ступени нет — как проводят через конвейер их,
        // раздел говорит текстом.
        always {
            if bus_ready = 1 {
                if_op := bus_op;
                if_arg := bus_arg;
                if_pc := bus_addr;
                if_valid := 1;
                bus_req := 0;
            } else {
                if_valid := 0;
            }
            bus_addr := pc;
            bus_req := 1;
            pc := pc + 1;
        }
        ref Drained: if_op = Hlt;
        ref Run;
    }

    // Выборка остановлена: команда останова уже ушла по конвейеру.
    state Drained {
        always {
            if_valid := 0;
            bus_req := 0;
        }
        ref Drained;
    }
}

// ─── Стадия 2: декодирование ─────────────────────────────────────────────────
model StageDecode {
    start Run {
        // Адрес операнда уходит на шину данных заранее: ответ памяти понадобится
        // следующей стадии уже в следующем такте.
        always {
            if if_valid = 1 {
                id_op := if_op;
                id_arg := if_arg;
                id_pc := if_pc;
                id_valid := 1;
                data_addr[0] := if_arg;
            } else {
                id_valid := 0;
            }
        }
        ref Run;
    }
}

// ─── Стадия 3: исполнение ────────────────────────────────────────────────────
model StageExecute {
    start Run {
        always {
            data_wen[0] := 0;
            ex_valid := id_valid;
            ex_pc := id_pc;
            if id_valid = 1 {
                match id_op {
                    Lda => {
                        pipe_acc := data_rdata[0];
                    }
                    Sta => {
                        data_waddr[0] := id_arg;
                        data_wdata[0] := pipe_acc;
                        data_wen[0] := 1;
                    }
                    Add => {
                        pipe_acc := pipe_acc + data_rdata[0];
                    }
                    Sub => {
                        pipe_acc := pipe_acc - data_rdata[0];
                    }
                    _ => {}
                }
            }
        }
        ref Halted: id_op = Hlt;
        ref Run;
    }

    state Halted;
}
