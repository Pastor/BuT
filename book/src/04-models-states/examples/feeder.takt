// Дозирующая линия: две подачи с разной дозой сыплют в один бункер.
// Модель подачи одна; отличаются экземпляры только настройкой. (1)
var total: u16 := 0; // сколько всего насыпано в бункер

model Feeder {
    parameter portion: u8 := 1; // доза за такт — настройка подачи (2)
    var count: u16 := 0; // сколько насыпала эта подача

    start Run {
        always {
            total := total + portion;
            count := count + portion;
        }
        ref Run;
    }
}

// Настройка задаётся в месте инстанцирования. (3)
start Line = Feeder(portion := 3) | Feeder(portion := 7);
