// Светофор: три фазы по кругу, переключение по таймеру. Такт — шаг логики;
// длительности фаз заданы В тактах и подстраиваются под частоту устройства.
const RED_TICKS: u8 := 30; // длительность красной фазы в тактах (напр. ≈30 с при 1 Гц)
const GREEN_TICKS: u8 := 30; // зелёной
const YELLOW_TICKS: u8 := 5; // жёлтой (короткая)

out red: bit;
out yellow: bit;
out green: bit;

var timer: u8 := 0; // тактов проведено в текущей фазе

start Red {
    // (1) стартовое состояние
    enter {
        // (2) при входе
        red := 1;
        yellow := 0;
        green := 0;
        timer := 0;
    }
    always {
        // (3) каждый такт — отсчёт времени фазы
        timer := timer + 1;
    }
    ref Green: timer >= RED_TICKS;
}
// (4) фаза выдержана → переход
state Green {
    // (5) обычное состояние
    enter {
        red := 0;
        green := 1;
        timer := 0;
    }
    always {
        timer := timer + 1;
    }
    ref Yellow: timer >= GREEN_TICKS;
}

state Yellow {
    // (6)
    enter {
        green := 0;
        yellow := 1;
        timer := 0;
    }
    always {
        timer := timer + 1;
    }
    ref Red: timer >= YELLOW_TICKS;
}
