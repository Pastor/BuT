// Панель управления вентилятором: по кнопке включает вентилятор и следит за
// перегревом по датчику температуры. Порты привязаны к регистрам ввода-вывода
// по адресам - тремя разными способами.
in button: bit at 0x40000000:0; // (1) инлайн-адрес: кнопка — бит 0 входного регистра
in temp: u8; // (2) адрес задаётся отдельным оператором ниже
out fan: bit; // силовой ключ вентилятора
out alarm: bit at 0x40000004:5; // светодиод перегрева — бит 5 выходного регистра
inout latch: u8 at 1073741832; // (4) двунаправленный: регистр читают и пишут

const MAX_T: u8 := 80; // порог перегрева

address temp = 1073741826; // (2) адрес датчика — оператором address
address fan = 0x40000004:0; // вентилятор — бит 0 того же выходного регистра

start Off {
    enter {
        fan := 0;
        alarm := 0;
    }
    ref On: button = 1;
}

state On {
    enter {
        fan := 1;
    }
    always {
        alarm := temp >= MAX_T; // перегрев → зажечь светодиод
        latch := temp; // двунаправленный порт: сюда пишут и отсюда читают
    }
    ref Off: button = 0;
}
