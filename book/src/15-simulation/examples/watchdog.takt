// Контроль живости: если сигнал "система жива" (kick) не приходит TIMEOUT тактов
// подряд - срабатывает авария. Таймаут в тактах, подстраивается под частоту.
const TIMEOUT: u8 := 5; // тактов без kick до аварии (напр. ≈5 мс при 1 кГц)

in kick: bit; // сигнал «система жива»
out alarm: bit;
var idle: u8 := 0; // (1) внутреннее состояние — время простоя в тактах

start Watching {
    enter {
        alarm := 0;
    }
    always {
        if kick = 1 {
            idle := 0;
        } else {
            idle := idle + 1;
        }
    }
    // получили сигнал - сбросить счётчик
    // тишина - растёт время простоя
    ref Tripped: idle >= TIMEOUT;
}
// (2) молчание дольше таймаута -> авария
state Tripped {
    enter {
        alarm := 1;
    }
    ref Watching: kick = 1;
}
// квитирование сигналом
