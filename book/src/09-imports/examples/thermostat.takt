// Термостат: держит температуру у порога, командуя нагревателем.
// Переиспользуемая модель — лежит в отдельном файле, подключается импортом.
// Порог объявлен параметром: значение по умолчанию 22, но применение вправе
// задать своё в месте подключения.
model Thermostat {
    in temp: u8;
    out heater: bit;
    parameter setpoint: u8 := 22;

    start Cold {
        enter {
            heater := 1;
        }
        ref Warm: temp >= setpoint;
    }
    state Warm {
        enter {
            heater := 0;
        }
        ref Cold: temp < setpoint;
    }
}
