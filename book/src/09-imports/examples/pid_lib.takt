// Библиотека: пропорциональный догон уставки. Переменные связи объявлены здесь
// же - потребитель подключает их вместе с моделью и через них замыкает контур.
var ctrl: u8 := 0; // управляющее воздействие (выход)
var meas: u8 := 0; // измерение (вход)

model Pid {
    const SETPOINT: u8 := 40;

    start Control {
        always {
            if meas < SETPOINT {
                ctrl := 4;
            } else {
                ctrl := 0;
            }
        }
        ref Control: true;
    }
}
