// Линия штамповки: пресс и подающий конвейер работают параллельно, но конвейер
// подаёт заготовку только тогда, когда ползун прессa поднят. Согласование идёт
// не по проводам между устройствами, а по состоянию соседней модели.
model Press {
    clock 1kHz; // такт устройства — 1 мс

    const DWELL := 20ms; // выдержка под давлением

    in part_ready: bit; // датчик: заготовка под ползуном
    out ram: bit; // привод ползуна

    // Ползун поднят, пресс ждёт заготовку.
    start Idle {
        enter {
            ram := 0;
        }
        ref Pressing: part_ready = 1;
    }

    // Ползун опущен: держим давление заданную выдержку и поднимаемся.
    state Pressing {
        enter {
            ram := 1;
        }
        ref Idle: after DWELL;
    }
}

model Feeder {
    out belt: bit; // привод ленты
    var fed: u8 := 0; // сколько заготовок подано (счётчик событий)

    // Лента стоит, пока пресс занят: подавать под опущенный ползун нельзя.
    start Holding {
        enter {
            belt := 0;
        }
        ref Feeding: S(Press) = Idle;
        // (1) полная запись
    }

    // Пресс свободен - двигаем ленту и считаем поданную заготовку.
    state Feeding {
        enter {
            belt := 1;
            fed := fed + 1;
        }
        ref Holding: Press != Idle;
        // (2) краткая запись, отрицание
    }
}

start Line = Press | Feeder;
