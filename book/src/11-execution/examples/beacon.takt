// Проблесковый маячок: мигает - горит ON_TICKS тактов, гаснет OFF_TICKS.
// Такт - шаг логики; длительности заданы в тактах и подстраиваются под частоту.
const ON_TICKS: u8 := 2; // горит (напр. ≈0.5 с при 4 Гц)
const OFF_TICKS: u8 := 2; // гаснет

out lamp: bit;
var t: u8 := 0; // тактов в текущей фазе

start On {
    // (1) стартовое состояние - тело на такте 1
    enter {
        lamp := 1; // (2) при входе: зажечь, обнулить счётчик
        t := 0;
    }
    always {
        t := t + 1; // (3) каждый такт — отсчёт
    }
    ref Off: t >= ON_TICKS;
}
// (4) переход проверяется после always
state Off {
    enter {
        lamp := 0;
        t := 0;
    }
    always {
        t := t + 1;
    }
    ref On: t >= OFF_TICKS;
}
